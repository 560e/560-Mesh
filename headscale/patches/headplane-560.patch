+import { mkdtemp, rm, readFile, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { it, expect } from "vitest";
+import { parse } from "yaml";
+
+import { createPrivateStore } from "~/server/network/store";
+
+import { createRuntimeController } from "../../../scripts/network-runtime";
+it("moves only runtime Headscale listening behind the optional public gateway", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "control-port-"));
+  try {
+    const base = join(dir, "base.yaml");
+    await writeFile(base, "listen_addr: 0.0.0.0:8080\nserver_url: https://hs.example.com\n");
+    const store = createPrivateStore(join(dir, "settings")),
+      common = {
+        basePath: base,
+        runtimeDirectory: join(dir, "runtime"),
+        store,
+        validate: async () => {},
+      };
+    const legacy = await createRuntimeController(common).prepare();
+    expect(parse(await readFile(legacy.configPath, "utf8")).listen_addr).toBe("0.0.0.0:8080");
+    const gateway = await createRuntimeController({
+      ...common,
+      controlListenAddress: "0.0.0.0:8081",
+    }).prepare();
+    expect(parse(await readFile(gateway.configPath, "utf8")).listen_addr).toBe("0.0.0.0:8081");
+    expect(await readFile(base, "utf8")).toContain("0.0.0.0:8080");
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
