new file mode 100644
index 0000000..8cc02a9
--- /dev/null
+++ b/tests/unit/enrollment/ui-revalidation.test.ts
@@ -0,0 +1,81 @@
+import { createElement } from "react";
+import { renderToString } from "react-dom/server";
+import { createMemoryRouter, RouterProvider } from "react-router";
+import { describe, expect, test, vi } from "vitest";
+
+import CommandForm from "~/routes/enrollment/command-form";
+
+const cached = vi.hoisted(() => ({
+  success: true,
+  command: {
+    id: "saved-id",
+    name: "旧成功响应",
+    available: true,
+    command: "CACHED_SECRET_MUST_NOT_RENDER",
+    unavailableReason: null,
+  },
+}));
+// The browser fetcher retains its successful action response across loader revalidation.
+vi.mock("react-router", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("react-router")>()),
+  useFetcher: () => ({ data: cached, state: "idle" }),
+}));
+function render(currentCommands: unknown[]) {
+  const router = createMemoryRouter(
+    [
+      {
+        path: "/",
+        loader: () => ({}),
+        Component: () =>
+          createElement(CommandForm, {
+            users: [],
+            keys: [],
+            commands: currentCommands,
+            url: "https://mesh.example.com",
+            selfServiceOnly: false,
+            onFinished: () => {},
+          } as any),
+      },
+    ],
+    { hydrationData: { loaderData: { "0": {} } } },
+  );
+  try {
+    return renderToString(createElement(RouterProvider, { router }));
+  } finally {
+    router.dispose();
+  }
+}
+describe("saved result follows revalidated command state", () => {
+  test.each(["密钥已过期", "密钥已删除", "服务器地址已变更"])(
+    "a successful fetcher cannot export the cached command after %s",
+    (unavailableReason) => {
+      const html = render([
+        { id: "saved-id", name: "当前名称", available: false, command: null, unavailableReason },
+      ]);
+      expect(html).not.toContain("CACHED_SECRET_MUST_NOT_RENDER");
+      expect(html).not.toContain("点击复制");
+      expect(html).toContain(unavailableReason);
+    },
+  );
+  test("missing or no-longer-authorized loader records never fall back to cached plaintext", () => {
+    const html = render([]);
+    expect(html).not.toContain("CACHED_SECRET_MUST_NOT_RENDER");
+    expect(html).not.toContain("点击复制");
+    expect(html).toContain("已删除或不再可见");
+  });
+  test("a revalidated replacement is the only command that can be copied", () => {
+    const html = render([
+      {
+        id: "saved-id",
+        name: "更新后的名称",
+        available: true,
+        command: "CURRENT_AUTHORIZED_COMMAND",
+        unavailableReason: null,
+      },
+    ]);
+    expect(html).not.toContain("CACHED_SECRET_MUST_NOT_RENDER");
+    expect(html).toContain("CURRENT_AUTHORIZED_COMMAND");
+    expect(html).toContain("更新后的名称");
+    expect(html).toContain("点击复制");
+  });
+});
