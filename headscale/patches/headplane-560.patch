+                      servers: [
+                        ...previous.servers,
+                        { address: "", stunEnabled: true, stunPort: 3478 },
+                      ],
+                    }))
+                  }
+                >
+                  <span className="inline-flex items-center gap-2">
+                    <Plus className="size-4" />
+                    添加 DERP 服务器
+                  </span>
+                </Button>
+              </div>
+            )}
+          </div>
+        </div>
+        {view.externalSources && (
+          <label className="mt-5 block rounded-xl bg-amber-50 p-4 text-sm text-amber-800 dark:bg-amber-500/10 dark:text-amber-200">
+            <input
+              type="checkbox"
+              checked={replace}
+              onChange={(e) => setReplace(e.target.checked)}
+              className="mr-2"
+            />
+            已有其他 DERP 来源；我确认用以上选择替换它们。基础配置文件会保留。
