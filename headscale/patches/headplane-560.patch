+import { describe, it, expect } from "vitest";
+
+import { customDerpServers, makeDerpMap, normalizeDerpSettings } from "~/utils/derp-config";
+
+import { readDerpRequest, readDerpStatus } from "../../../scripts/network-runtime";
+const one = { address: "derp1.example.com", stunEnabled: true, stunPort: 3478 };
+const two = { address: "https://derp2.example.com:8443", stunEnabled: false, stunPort: 3479 };
+const input = { officialEnabled: true, customEnabled: true, servers: [one, two] };
+describe("multiple custom DERP servers", () => {
+  it("normalizes every server while retaining the first-server compatibility fields", () => {
+    const settings = normalizeDerpSettings(input);
+    expect(settings.address).toBe("https://derp1.example.com");
+    expect(customDerpServers(settings)).toEqual([
+      { ...one, address: "https://derp1.example.com" },
+      two,
+    ]);
+  });
+  it("allocates separate collision-free regions and per-server HTTPS/STUN settings", () => {
+    const map = makeDerpMap(normalizeDerpSettings(input), [900, 902]);
+    expect(Object.keys(map.regions)).toEqual(["901", "903"]);
+    expect(map.regions["901"].nodes[0]).toMatchObject({
+      hostname: "derp1.example.com",
+      derpport: 443,
+      stunport: 3478,
+      regionid: 901,
+    });
+    expect(map.regions["903"].nodes[0]).toMatchObject({
+      hostname: "derp2.example.com",
+      derpport: 8443,
+      stunport: -1,
+      regionid: 903,
+    });
+    expect(new Set(Object.values(map.regions).map((region) => region.regioncode)).size).toBe(2);
+  });
+  it("reads existing one-server request/status files without losing their address or STUN settings", () => {
+    const legacy = {
+      officialEnabled: false,
+      customEnabled: true,
+      address: "https://old.example.com",
+      stunEnabled: false,
+      stunPort: 4444,
+    };
+    const req = readDerpRequest({ schema: 1, revision: "old", settings: legacy })!;
+    const status = readDerpStatus({
+      schema: 1,
+      active: { revision: "old", settings: legacy },
+      failed: null,
+      updatedAt: "now",
+    })!;
+    expect(customDerpServers(req.settings)).toEqual([
+      { address: legacy.address, stunEnabled: false, stunPort: 4444 },
+    ]);
+    expect(customDerpServers(status.active!.settings!)).toEqual(customDerpServers(req.settings));
+  });
+  it.each([
+    [],
+    [{ ...one, address: "http://bad.example.com" }],
+    [one, { ...one, address: "https://derp1.example.com/" }],
+    Array.from({ length: 17 }, (_, i) => ({ ...one, address: "derp" + i + ".example.com" })),
+  ])("rejects an invalid or duplicate custom list", (servers) => {
+    expect(() => normalizeDerpSettings({ ...input, servers })).toThrow();
+  });
+  it("rejects malformed list shapes and per-server flags", () => {
+    for (const servers of [
+      "bad",
+      [null],
+      [{ ...one, stunEnabled: "false" }],
+      [{ ...one, stunPort: 70000 }],
+    ])
+      expect(() => normalizeDerpSettings({ ...input, servers })).toThrow();
+  });
+  it("retains official-only mode and refuses disabling every source", () => {
+    const settings = normalizeDerpSettings({ ...input, customEnabled: false, servers: [] });
+    expect(makeDerpMap(settings).regions).toEqual({});
+    expect(() =>
+      normalizeDerpSettings({ ...input, officialEnabled: false, customEnabled: false }),
+    ).toThrow();
+  });
+});
diff --git a/tests/unit/network/derp-runtime.test.ts b/tests/unit/network/derp-runtime.test.ts
