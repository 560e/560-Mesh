+import { type } from "arktype";
+import { describe, expect, test } from "vitest";
+
+import { validateFormData } from "~/hooks/use-form";
+
+function requestFor(values: Record<string, string>) {
+  const body = new FormData();
+  for (const [key, value] of Object.entries(values)) body.set(key, value);
+  return new Request("http://localhost/adminis/dns", { method: "POST", body });
+}
+
+describe("Chinese form validation", () => {
+  const schema = type({ ns: "string.ip", split_name: "string > 0" });
+
+  test("preserves API field names and valid parsed values", async () => {
+    const values = { ns: "2001:db8::1", split_name: "example.com" };
+    expect(await validateFormData(requestFor(values), schema)).toEqual({
+      success: true,
+      data: values,
+    });
+  });
+
+  test("reports required fields in Chinese without changing error paths", async () => {
+    expect(await validateFormData(requestFor({}), schema)).toEqual({
+      success: false,
+      errors: { ns: "此项为必填项。", split_name: "此项为必填项。" },
+    });
+  });
+
+  test("keeps a specific IP validation message for invalid input", async () => {
+    expect(
+      await validateFormData(requestFor({ ns: "bad-ip", split_name: "global" }), schema),
+    ).toEqual({ success: false, errors: { ns: "请输入有效的 IPv4 或 IPv6 地址。" } });
+  });
+});
