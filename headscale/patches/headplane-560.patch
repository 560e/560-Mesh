+export function legacyConsoleDestination(path: string, search: string): string | undefined {
+  const query = new URLSearchParams(search);
+  let destination: string;
+  if (path === "/dns") destination = "/settings/dns";
+  else if (path === "/acls") destination = "/settings/acls";
+  else if (path === "/settings/auth-keys") {
+    destination = "/enrollment";
+    query.set("tab", "keys");
+  } else return undefined;
+  return destination + (query.size ? "?" + query.toString() : "");
+}
diff --git a/app/utils/derp-config.ts b/app/utils/derp-config.ts
new file mode 100644
index 0000000..fddfd63
--- /dev/null
+++ b/app/utils/derp-config.ts
@@ -0,0 +1,133 @@
+export const OFFICIAL_DERP_URL = "https://controlplane.tailscale.com/derpmap/default";
+export interface CustomDerpServer {
+  address: string;
+  stunEnabled: boolean;
+  stunPort: number;
+}
+export interface DerpSettings extends CustomDerpServer {
+  officialEnabled: boolean;
+  customEnabled: boolean;
+  // Legacy fields above mirror the first server for old configurations and tools.
+  servers?: CustomDerpServer[];
+}
+export function normalizeCustomDerpServer(input: unknown): CustomDerpServer {
+  if (!input || typeof input !== "object" || Array.isArray(input))
+    throw new Error("自建 DERP 服务器设置无效。");
+  const v = input as Record<string, unknown>,
+    stunEnabled = v.stunEnabled === undefined ? true : v.stunEnabled;
+  if (typeof stunEnabled !== "boolean") throw new Error("STUN 开关无效。");
+  const stunPort = Number(v.stunPort ?? 3478);
+  if (!Number.isInteger(stunPort) || stunPort < 1 || stunPort > 65535)
+    throw new Error("STUN 端口应为 1–65535。");
+  const raw = typeof v.address === "string" ? v.address.trim() : "";
+  if (!raw || raw.length > 1024) throw new Error("请填写自建 DERP 地址。");
+  let url: URL;
+  try {
+    url = new URL(raw.includes("://") ? raw : "https://" + raw);
+  } catch {
+    throw new Error("DERP 地址格式无效。");
+  }
+  if (
+    url.protocol !== "https:" ||
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash ||
+    url.pathname !== "/" ||
+    !url.hostname ||
+    raw.includes("\\")
+  )
+    throw new Error("请填写 HTTPS 站点地址，可带端口，不包含路径、账号或查询参数。");
+  return { address: url.origin, stunEnabled, stunPort };
+}
+export function normalizeDerpSettings(input: unknown): DerpSettings {
+  if (!input || typeof input !== "object" || Array.isArray(input))
+    throw new Error("DERP 设置无效。");
+  const v = input as Record<string, unknown>;
+  if (typeof v.officialEnabled !== "boolean" || typeof v.customEnabled !== "boolean")
+    throw new Error("DERP 开关无效。");
+  if (!v.officialEnabled && !v.customEnabled)
+    throw new Error("至少启用官方 DERP 或一个自建 DERP。");
+  if (v.servers !== undefined) {
+    if (!Array.isArray(v.servers) || v.servers.length > 16)
+      throw new Error("自建 DERP 列表无效，最多支持 16 个服务器。");
+    const servers = v.customEnabled ? Array.from(v.servers, normalizeCustomDerpServer) : [];
+    if (v.customEnabled && !servers.length) throw new Error("请至少添加一个自建 DERP 服务器。");
+    if (new Set(servers.map((server) => server.address)).size !== servers.length)
+      throw new Error("自建 DERP 地址重复，请保留一条。");
+    const first = servers[0] ?? { address: "", stunEnabled: true, stunPort: 3478 };
+    return {
+      officialEnabled: v.officialEnabled,
+      customEnabled: v.customEnabled,
+      ...first,
+      servers,
+    };
+  }
+  const stunEnabled = v.stunEnabled === undefined ? true : v.stunEnabled,
+    stunPort = Number(v.stunPort ?? 3478);
+  if (typeof stunEnabled !== "boolean") throw new Error("STUN 开关无效。");
+  if (!Number.isInteger(stunPort) || stunPort < 1 || stunPort > 65535)
+    throw new Error("STUN 端口应为 1–65535。");
+  const first = v.customEnabled
+    ? normalizeCustomDerpServer(v)
+    : { address: "", stunEnabled, stunPort };
+  return { officialEnabled: v.officialEnabled, customEnabled: v.customEnabled, ...first };
+}
+export function customDerpServers(settings: DerpSettings): CustomDerpServer[] {
+  if (!settings.customEnabled) return [];
+  return (
+    settings.servers?.map((server) => ({ ...server })) ??
+    (settings.address
+      ? [
+          {
+            address: settings.address,
+            stunEnabled: settings.stunEnabled,
+            stunPort: settings.stunPort,
+          },
+        ]
+      : [])
+  );
+}
+export function makeDerpMap(settings: DerpSettings, occupied: number[] = []) {
+  const regions: Record<
+    string,
+    {
+      regionid: number;
+      regioncode: string;
+      regionname: string;
+      nodes: Array<{
+        name: string;
+        regionid: number;
+        hostname: string;
+        derpport: number;
+        stunport: number;
+      }>;
+    }
+  > = {};
+  const servers = customDerpServers(settings),
+    used = new Set(occupied);
+  let id = 900;
+  for (const [index, server] of servers.entries()) {
+    while (used.has(id)) id++;
+    if (id > 65535) throw new Error("没有可用的 DERP 地区编号。");
+    used.add(id);
+    const url = new URL(server.address),
+      hostname = url.hostname.replace(/^\[|\]$/g, "");
+    regions[String(id)] = {
+      regionid: id,
+      regioncode: index === 0 ? "560-custom" : "560-custom-" + (index + 1),
+      regionname: servers.length === 1 ? "自建中继" : "自建中继 · " + hostname,
+      nodes: [
+        {
+          name: id + "a",
+          regionid: id,
+          hostname,
+          derpport: Number(url.port) || 443,
+          stunport: server.stunEnabled ? server.stunPort : -1,
+        },
+      ],
+    };
+    id++;
+  }
+  return { regions };
+}
