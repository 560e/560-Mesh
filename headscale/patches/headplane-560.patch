@@ -0,0 +1,54 @@
+import { randomUUID } from "node:crypto";
+
+import { DEFAULT_SITE_TITLE, normalizeSiteTitle, readSiteSettings } from "~/utils/site-settings";
+
+import type { AuthService } from "../web/auth";
+import { Capabilities } from "../web/roles";
+import { NetworkSettingsError } from "./error";
+import type { PrivateStore } from "./store";
+export function createSiteService({
+  store,
+  auth,
+}: {
+  store: PrivateStore;
+  auth: Pick<AuthService, "require" | "can">;
+}) {
+  async function access(request: Request, write = false) {
+    const principal = await auth.require(request);
+    if (!auth.can(principal, write ? Capabilities.write_feature : Capabilities.read_feature))
+      throw new NetworkSettingsError("您无权" + (write ? "修改" : "查看") + "站点设置。", 403);
+  }
+  async function snapshot() {
+    try {
+      const settings = readSiteSettings(await store.read("site-settings.json"));
+      return {
+        title: settings?.title ?? DEFAULT_SITE_TITLE,
+        token: settings?.revision ?? "initial",
+      };
+    } catch {
+      throw new NetworkSettingsError("站点设置文件损坏，请检查备份。", 503);
+    }
+  }
+  return {
+    async view(request: Request) {
+      await access(request);
+      return store.serial(snapshot);
+    },
+    async save(request: Request, token: string, input: unknown) {
+      await access(request, true);
+      let title: string;
+      try {
+        title = normalizeSiteTitle(input);
+      } catch (error) {
+        throw new NetworkSettingsError(error instanceof Error ? error.message : "站点标题无效。");
+      }
+      return store.serial(async () => {
+        const current = await snapshot();
+        if (current.token !== token)
+          throw new NetworkSettingsError("站点设置已变化，请刷新后重试。", 409);
+        await store.write("site-settings.json", { schema: 1, revision: randomUUID(), title });
+        return snapshot();
+      });
+    },
+  };
+}
