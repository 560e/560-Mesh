+                          label={`使用自建 STUN ${index + 1}`}
+                          checked={server.stunEnabled}
+                          disabled={!writable || busy}
+                          onCheckedChange={(stunEnabled) =>
+                            setSettings((previous) => ({
+                              ...previous,
+                              servers: previous.servers.map((entry, i) =>
+                                i === index ? { ...entry, stunEnabled } : entry,
+                              ),
+                            }))
