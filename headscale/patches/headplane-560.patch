+export const DEFAULT_SITE_TITLE = "连接助手";
+export function normalizeSiteTitle(input: unknown): string {
+  if (typeof input !== "string") throw new Error("请填写站点标题。");
+  const title = input.trim().normalize("NFC");
+  if (
+    !title ||
+    Array.from(title).length > 64 ||
+    // Control characters and bidi overrides are intentionally rejected in a public title.
+    // eslint-disable-next-line no-control-regex
+    /[<>\u0000-\u001f\u007f-\u009f\u2028-\u202e\u2066-\u2069]/.test(title)
+  )
+    throw new Error("站点标题须为 1–64 个字符，不能包含换行、控制字符或 HTML 标记。");
+  return title;
+}
+export interface SiteSettings {
+  schema: 1;
+  revision: string;
+  title: string;
+}
+export function readSiteSettings(input: unknown): SiteSettings | null {
+  if (input === null) return null;
+  if (!input || typeof input !== "object") throw new Error("站点设置文件损坏。");
+  const value = input as SiteSettings;
+  if (
+    value.schema !== 1 ||
+    typeof value.revision !== "string" ||
+    !value.revision ||
+    value.revision.length > 128
+  )
+    throw new Error("站点设置文件损坏。");
+  return { schema: 1, revision: value.revision, title: normalizeSiteTitle(value.title) };
+}
