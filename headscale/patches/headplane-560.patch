@@ -0,0 +1,40 @@
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { expect, it } from "vitest";
+
+import { createSharingService } from "~/server/network/sharing";
+import { createPrivateStore } from "~/server/network/store";
+it("holds the shared policy lock over the actual mutation and blocks managed ACL writes", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "policy-lock-"));
+  try {
+    let policy = "{}";
+    const api: any = {
+      users: { list: async () => [{ id: "1", name: "alice", createdAt: "" }] },
+      policy: {
+        get: async () => ({ policy, updatedAt: new Date() }),
+        set: async (p: string) => {
+          policy = p;
+          return { policy, updatedAt: new Date() };
+        },
+      },
+    };
+    const s = createSharingService(createPrivateStore(dir));
+    const view = await s.view(api);
+    await s.apply(api, { token: view.token, selectedIds: [], activate: true });
+    let called = false;
+    await expect(
+      s.withPolicyWrite(api, async () => {
+        called = true;
+      }),
+    ).rejects.toMatchObject({ status: 409 });
+    expect(called).toBe(false);
+    await s.withUserMutation(api, "1", async () => {
+      called = true;
+    });
+    expect(called).toBe(true);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
diff --git a/tests/unit/network/policy.test.ts b/tests/unit/network/policy.test.ts
new file mode 100644
index 0000000..ce82365
--- /dev/null
+++ b/tests/unit/network/policy.test.ts
@@ -0,0 +1,83 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  buildSharingPolicy,
+  inspectPolicy,
+  policyDigest,
+  selectedIdentities,
+} from "~/server/network/policy";
+const users = [
+  { id: "1", name: "alice", createdAt: "" },
+  { id: "2", name: "bob", createdAt: "" },
+  { id: "3", name: "carol", createdAt: "" },
+];
+describe("per-user sharing policy", () => {
+  it("allows own nodes and only mutually opted-in users", () => {
+    const raw = buildSharingPolicy("{}", selectedIdentities(users, ["1", "2"]));
+    const p = JSON.parse(raw);
+    expect(p.groups["group:560-interconnect"]).toEqual(["alice@", "bob@"]);
+    expect(p.acls).toEqual([
+      { action: "accept", src: ["autogroup:member"], dst: ["autogroup:self:*"] },
+      { action: "accept", src: ["group:560-interconnect"], dst: ["group:560-interconnect:*"] },
+    ]);
+    expect(raw).not.toContain("carol@");
+  });
+  it.each([{ ids: [] }, { ids: ["1"] }])("does not grant cross-user access for $ids", ({ ids }) => {
+    const p = JSON.parse(buildSharingPolicy("{}", selectedIdentities(users, ids)));
+    expect(p.acls).toHaveLength(1);
+    expect(p.acls[0].src).toEqual(["autogroup:member"]);
+  });
+  it("replaces default allow-all while preserving unrelated settings", () => {
+    const p = JSON.parse(
+      buildSharingPolicy(
+        '{"acls":[{"action":"accept","src":["*"],"dst":["*:*"]}],"tagOwners":{"tag:server":["alice@"]},"autoApprovers":{"routes":{"10.0.0.0/8":["alice@"]}}}',
+        [],
+      ),
+    );
+    expect(p.tagOwners).toEqual({ "tag:server": ["alice@"] });
+    expect(p.autoApprovers.routes["10.0.0.0/8"]).toEqual(["alice@"]);
+    expect(p.acls).toEqual([
+      { action: "accept", src: ["autogroup:member"], dst: ["autogroup:self:*"] },
+    ]);
+  });
+  it.each([
+    '{"grants":[{"src":["*"],"dst":["*"],"ip":["*"]}]}',
+    '{"acls":[{"action":"accept","src":["alice@"],"dst":["bob@:*"]}]}',
+    '{"groups":{"group:560-interconnect":["alice@"]}}',
+    '{"acls":[]}',
+  ])("rejects custom policy migration: %s", (raw) =>
+    expect(inspectPolicy(raw).migratable).toBe(false),
+  );
+  it("accepts blank, HuJSON and plain default policies", () => {
+    expect(inspectPolicy("").migratable).toBe(true);
+    expect(
+      inspectPolicy('{// default\n"acls":[{"action":"accept","src":["*"],"dst":["*:*"],},],}')
+        .migratable,
+    ).toBe(true);
+  });
+  it("does not include tagged devices in source or own-device selectors", () => {
+    const p = JSON.parse(buildSharingPolicy("{}", []));
+    expect(p.acls).toEqual([
+      { action: "accept", src: ["autogroup:member"], dst: ["autogroup:self:*"] },
+    ]);
+  });
+  it("uses stable IDs and rejects deleted or duplicate identities", () => {
+    expect(() => selectedIdentities(users, ["999"])).toThrow();
+    expect(() =>
+      selectedIdentities([...users, { id: "4", name: "alice", createdAt: "" }], ["1"]),
+    ).toThrow();
+    expect(selectedIdentities(users, ["2", "1", "2"]).map((x) => x.id)).toEqual(["1", "2"]);
+  });
+  it("does not alter an already managed base's auxiliary sections", () => {
+    const first = buildSharingPolicy(
+      '{"nodeAttrs":[{"target":["*"],"attr":["disable-ipv4"]}]}',
+      [],
+    );
+    expect(
+      JSON.parse(buildSharingPolicy(first, selectedIdentities(users, ["1", "2"]), true)).nodeAttrs,
+    ).toEqual([{ target: ["*"], attr: ["disable-ipv4"] }]);
+  });
+  it("detects any external change instead of claiming the policy is still managed", () => {
+    expect(policyDigest("{}")).not.toBe(policyDigest('{"acls":[]}'));
+  });
+});
diff --git a/tests/unit/network/review-regressions.test.ts b/tests/unit/network/review-regressions.test.ts
new file mode 100644
index 0000000..88fc253
--- /dev/null
+++ b/tests/unit/network/review-regressions.test.ts
@@ -0,0 +1,99 @@
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { expect, it } from "vitest";
+import { parse } from "yaml";
+
+import { createSharingService } from "~/server/network/sharing";
+import { createPrivateStore } from "~/server/network/store";
+
+import { createRuntimeController } from "../../../scripts/network-runtime";
+it("restores blank original policy as explicit allow-all so Headscale updates live filters", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "restore-empty-"));
+  try {
+    let policy = "";
+    const users = [{ id: "1", name: "alice", createdAt: "" }];
+    const api: any = {
+      users: { list: async () => users },
+      policy: {
+        get: async () => ({ policy, updatedAt: new Date() }),
+        set: async (p: string) => {
+          policy = p;
+          return { policy, updatedAt: new Date() };
+        },
+      },
+    };
+    const s = createSharingService(createPrivateStore(dir)),
+      first = await s.view(api);
+    const enabled = await s.apply(api, { token: first.token, selectedIds: [], activate: true });
+    await s.restore(api, enabled.token);
+    expect(JSON.parse(policy).acls).toEqual([{ action: "accept", src: ["*"], dst: ["*:*"] }]);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+it("refuses an external ACL edit occurring while the apply journal is being persisted", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "external-policy-"));
+  try {
+    let policy = "{}",
+      writes = 0;
+    const external = '{"acls":[]}';
+    const api: any = {
+      users: { list: async () => [{ id: "1", name: "alice", createdAt: "" }] },
+      policy: {
+        get: async () => ({ policy, updatedAt: new Date() }),
+        set: async (p: string) => {
+          writes++;
+          policy = p;
+          return { policy, updatedAt: new Date() };
+        },
+      },
+    };
+    const real = createPrivateStore(dir),
+      store = {
+        ...real,
+        write: async (name: string, value: unknown) => {
+          await real.write(name, value);
+          if (name === "sharing-pending.json") policy = external;
+        },
+      };
+    const s = createSharingService(store),
+      view = await s.view(api);
+    await expect(
+      s.apply(api, { token: view.token, selectedIds: [], activate: true }),
+    ).rejects.toMatchObject({ status: 409 });
+    expect(writes).toBe(0);
+    expect(policy).toBe(external);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+it("preserves config-relative policy, database, TLS and key locations on the first upgrade", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "relative-config-"));
+  try {
+    const base = join(dir, "base.yaml"),
+      out = join(dir, "runtime");
+    await writeFile(
+      base,
+      "server_url: https://hs.example.com\npolicy:\n  mode: file\n  path: acl.hujson\nnoise:\n  private_key_path: keys/noise.key\ndatabase:\n  sqlite:\n    path: db.sqlite\nderp:\n  server:\n    private_key_path: keys/derp.key\ntls_cert_path: tls/cert.pem\ntls_key_path: /absolute/key.pem\ntls_letsencrypt_cache_dir: cache\n",
+    );
+    const ctl = createRuntimeController({
+      basePath: base,
+      runtimeDirectory: out,
+      store: createPrivateStore(join(dir, "state")),
+      validate: async () => {},
+    });
+    const p = await ctl.prepare(),
+      cfg = parse(await readFile(p.configPath, "utf8"));
+    expect(cfg.policy.path).toBe(join(dir, "acl.hujson"));
+    expect(cfg.noise.private_key_path).toBe(join(dir, "keys/noise.key"));
+    expect(cfg.database.sqlite.path).toBe(join(dir, "db.sqlite"));
+    expect(cfg.derp.server.private_key_path).toBe(join(dir, "keys/derp.key"));
+    expect(cfg.tls_cert_path).toBe(join(dir, "tls/cert.pem"));
+    expect(cfg.tls_key_path).toBe("/absolute/key.pem");
+    expect(cfg.tls_letsencrypt_cache_dir).toBe(join(dir, "cache"));
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
diff --git a/tests/unit/network/sharing-bootstrap.test.ts b/tests/unit/network/sharing-bootstrap.test.ts
new file mode 100644
index 0000000..e4fb3b8
--- /dev/null
+++ b/tests/unit/network/sharing-bootstrap.test.ts
@@ -0,0 +1,48 @@
+import { afterEach, it, expect, vi } from "vitest";
+
+import { createSharingBootstrap } from "~/server/network/sharing-bootstrap";
+afterEach(() => vi.useRealTimers());
+it("keeps the console booting after a transient initialization failure and retries until successful", async () => {
+  vi.useFakeTimers();
+  let calls = 0,
+    errors = 0;
+  const bootstrap = createSharingBootstrap(
+    async () => {
+      calls++;
+      if (calls < 3) throw new Error("temporary outage");
+    },
+    {
+      retryMs: 20,
+      onError: () => {
+        errors++;
+      },
+    },
+  );
+  await expect(bootstrap.start()).resolves.toBeUndefined();
+  expect(calls).toBe(1);
+  await vi.advanceTimersByTimeAsync(20);
+  expect(calls).toBe(2);
+  await vi.advanceTimersByTimeAsync(20);
+  expect(calls).toBe(3);
+  await vi.advanceTimersByTimeAsync(200);
+  expect(calls).toBe(3);
+  expect(errors).toBe(2);
+  bootstrap.dispose();
+});
+it("stops retrying on shutdown and never overlaps starts", async () => {
+  vi.useFakeTimers();
+  let calls = 0;
+  const bootstrap = createSharingBootstrap(
+    async () => {
+      calls++;
+      throw new Error("offline");
+    },
+    { retryMs: 20, onError: () => {} },
+  );
+  await bootstrap.start();
+  await bootstrap.start();
+  expect(calls).toBe(1);
+  bootstrap.dispose();
+  await vi.advanceTimersByTimeAsync(200);
+  expect(calls).toBe(1);
+});
diff --git a/tests/unit/network/sharing.test.ts b/tests/unit/network/sharing.test.ts
new file mode 100644
index 0000000..d858050
--- /dev/null
+++ b/tests/unit/network/sharing.test.ts
@@ -0,0 +1,276 @@
+import { mkdtemp, rm, readFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { afterEach, describe, expect, it } from "vitest";
+
+import { createSharingService } from "~/server/network/sharing";
+import { createPrivateStore } from "~/server/network/store";
+const dirs: string[] = [];
+async function setup() {
+  const dir = await mkdtemp(join(tmpdir(), "sharing-"));
+  dirs.push(dir);
+  let policy = "{}";
+  const users = [
+    { id: "1", name: "alice", createdAt: "" },
+    { id: "2", name: "bob", createdAt: "" },
+    { id: "3", name: "carol", createdAt: "" },
+  ];
+  const api: any = {
+    users: { list: async () => users },
+    policy: {
+      get: async () => ({ policy, updatedAt: new Date() }),
+      set: async (next: string) => {
+        policy = next;
+        return { policy, updatedAt: new Date() };
+      },
+    },
+  };
+  const store = createPrivateStore(dir);
+  const service = createSharingService(store);
+  return {
+    dir,
+    service,
+    api,
+    users,
+    getPolicy: () => policy,
+    setPolicy: (p: string) => {
+      policy = p;
+    },
+  };
+}
+afterEach(async () => {
+  await Promise.all(dirs.splice(0).map((d) => rm(d, { recursive: true, force: true })));
+});
+describe("sharing persistence and reconciliation", () => {
+  it("does not change live ACL until explicit activation and keeps original backup", async () => {
+    const x = await setup();
+    const view = await x.service.view(x.api);
+    expect(view.mode).toBe("unmanaged");
+    expect(x.getPolicy()).toBe("{}");
+    const next = await x.service.apply(x.api, {
+      token: view.token,
+      selectedIds: ["1", "2"],
+      activate: true,
+    });
+    expect(next.mode).toBe("managed");
+    expect(next.selectedIds).toEqual(["1", "2"]);
+    expect(await readFile(join(x.dir, "sharing-original.hujson"), "utf8")).toBe("{}");
+    expect((await createSharingService(createPrivateStore(x.dir)).view(x.api)).mode).toBe(
+      "managed",
+    );
+  });
+  it("rejects stale form and concurrent changes without losing the first write", async () => {
+    const x = await setup(),
+      v = await x.service.view(x.api);
+    await x.service.apply(x.api, { token: v.token, selectedIds: ["1", "2"], activate: true });
+    await expect(
+      x.service.apply(x.api, { token: v.token, selectedIds: ["3"] }),
+    ).rejects.toMatchObject({ status: 409 });
+    expect((await x.service.view(x.api)).selectedIds).toEqual(["1", "2"]);
+  });
+  it("does not silently overwrite external changes", async () => {
+    const x = await setup(),
+      v = await x.service.view(x.api);
+    await x.service.apply(x.api, { token: v.token, selectedIds: [], activate: true });
+    x.setPolicy('{"acls":[{"action":"accept","src":["*"],"dst":["*:*"]}]}');
+    const changed = await x.service.view(x.api);
+    expect(changed.mode).toBe("drifted");
+    await expect(
+      x.service.apply(x.api, { token: changed.token, selectedIds: ["1", "2"] }),
+    ).rejects.toMatchObject({ status: 409 });
+  });
+  it("keeps previous active selection on failed write and recognizes an acknowledged timeout", async () => {
+    const x = await setup(),
+      v = await x.service.view(x.api);
+    x.api.policy.set = async () => {
+      throw new Error("offline");
+    };
+    await expect(
+      x.service.apply(x.api, { token: v.token, selectedIds: ["1", "2"], activate: true }),
+    ).rejects.toThrow();
+    expect((await x.service.view(x.api)).mode).toBe("unmanaged");
+    x.api.policy.set = async (p: string) => {
+      x.setPolicy(p);
+      throw new Error("timeout");
+    };
+    const fresh = await x.service.view(x.api);
+    expect(
+      (
+        await x.service.apply(x.api, {
+          token: fresh.token,
+          selectedIds: ["1", "2"],
+          activate: true,
+        })
+      ).mode,
+    ).toBe("managed");
+  });
+  it("marks renamed selected identities as drifted and requires deselection before management changes", async () => {
+    const x = await setup(),
+      v = await x.service.view(x.api);
+    await x.service.apply(x.api, { token: v.token, selectedIds: ["1", "2"], activate: true });
+    await expect(x.service.assertUserMutable(x.api, "1")).rejects.toMatchObject({ status: 409 });
+    x.users[0].name = "renamed";
+    expect((await x.service.view(x.api)).mode).toBe("drifted");
+  });
+  it("can release managed mode without granting additional access", async () => {
+    const x = await setup(),
+      v = await x.service.view(x.api);
+    const m = await x.service.apply(x.api, {
+      token: v.token,
+      selectedIds: ["1", "2"],
+      activate: true,
+    });
+    const before = x.getPolicy();
+    await x.service.release(x.api, m.token);
+    expect(x.getPolicy()).toBe(before);
+    expect((await x.service.view(x.api)).mode).toBe("unmanaged");
+  });
+  it("rejects corrupt state rather than defaulting to permissive mode", async () => {
+    const x = await setup();
+    await x.service.view(x.api);
+    await createPrivateStore(x.dir).write("sharing.json", { unexpected: true });
+    await expect(x.service.view(x.api)).rejects.toThrow();
+  });
+});
+
+describe("default isolation initialization", () => {
+  it("enables isolation for an uninitialized default policy and backs up before mutation", async () => {
+    const x = await setup();
+    expect(await x.service.initializeDefaults(x.api)).toBe("enabled");
+    expect((await x.service.view(x.api)).mode).toBe("managed");
+    expect((await x.service.view(x.api)).selectedIds).toEqual([]);
+    expect(JSON.parse(x.getPolicy()).acls).toEqual([
+      { action: "accept", src: ["autogroup:member"], dst: ["autogroup:self:*"] },
+    ]);
+    expect(await readFile(join(x.dir, "sharing-original.hujson"), "utf8")).toBe("{}");
+    const before = x.getPolicy();
+    expect(await x.service.initializeDefaults(x.api)).toBe("preserved");
+    expect(x.getPolicy()).toBe(before);
+  });
+  it("does not reset explicitly selected peers or an explicit switch to advanced management", async () => {
+    const x = await setup();
+    let v = await x.service.view(x.api);
+    v = await x.service.apply(x.api, { token: v.token, selectedIds: ["1", "2"], activate: true });
+    expect(await x.service.initializeDefaults(x.api)).toBe("preserved");
+    expect((await x.service.view(x.api)).selectedIds).toEqual(["1", "2"]);
+    await x.service.release(x.api, v.token);
+    expect(await x.service.initializeDefaults(x.api)).toBe("preserved");
+    expect((await x.service.view(x.api)).mode).toBe("unmanaged");
+  });
+  it.each([
+    '{"acls":[]}',
+    '{"grants":[]}',
+    '{"acls":[{"action":"accept","src":["alice@"],"dst":["bob@:*"]}]}',
+    '{"acls":[{"action":"accept","src":["autogroup:member"],"dst":["autogroup:self:*"]}]}',
+  ])("keeps an existing custom policy unchanged: %s", async (policy) => {
+    const x = await setup();
+    x.setPolicy(policy);
+    expect(await x.service.initializeDefaults(x.api)).toBe("custom-policy");
+    expect(x.getPolicy()).toBe(policy);
+  });
+  it("keeps read-only file policies unchanged", async () => {
+    const x = await setup();
+    x.api.policy.get = async () => ({ policy: x.getPolicy(), updatedAt: null });
+    expect(await x.service.initializeDefaults(x.api)).toBe("read-only");
+    expect(x.getPolicy()).toBe("{}");
+  });
+  it("retries a failed initial write and accepts a response-lost acknowledged write", async () => {
+    const x = await setup(),
+      set = x.api.policy.set;
+    x.api.policy.set = async () => {
+      throw new Error("offline");
+    };
+    await expect(x.service.initializeDefaults(x.api)).rejects.toThrow();
+    expect(x.getPolicy()).toBe("{}");
+    x.api.policy.set = async (raw: string) => {
+      await set(raw);
+      throw new Error("lost response");
+    };
+    expect(await x.service.initializeDefaults(x.api)).toBe("enabled");
+    expect((await x.service.view(x.api)).mode).toBe("managed");
+  });
+});
+
+it.each(["", '{"acls":[{"action":"accept","src":["*"],"dst":["*:*"]}]}'])(
+  "initializes a fresh blank/default allow-all policy: %s",
+  async (policy) => {
+    const x = await setup();
+    x.setPolicy(policy);
