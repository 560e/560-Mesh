--- /dev/null
+++ b/app/routes/enrollment/form-state.ts
@@ -0,0 +1,50 @@
+import type { EnrollmentCommandView } from "~/server/enrollment/service";
+import type { EnrollmentOptions } from "~/types/Enrollment";
+import { buildEnrollmentCommand } from "~/utils/enrollment-command";
+
+export interface Attempt {
+  fingerprint: string;
+  nonce: string;
+}
+export function prepareAttempt(previous: Attempt | null, fingerprint: string): Attempt {
+  return previous?.fingerprint === fingerprint
+    ? previous
+    : { fingerprint, nonce: crypto.randomUUID() };
+}
+export function keyIsSelectable(key: {
+  secretAvailable: boolean;
+  reusable: boolean;
+  used: boolean;
+  expiration: string;
+}): boolean {
+  return key.secretAvailable && key.reusable && new Date(key.expiration).getTime() > Date.now();
+}
+export function previewCommand(url: string, options: EnrollmentOptions): string {
+  return buildEnrollmentCommand(url, "hskey-auth-REPLACE_AFTER_SAVE", options);
+}
+
+// Cached action results identify the saved record, but never supply exportable plaintext.
+export function resolveSavedCommand(
+  result: unknown,
+  commands: EnrollmentCommandView[],
+): { current: EnrollmentCommandView | undefined } | null {
+  if (
+    !result ||
+    typeof result !== "object" ||
+    !("success" in result) ||
+    result.success !== true ||
+    !("command" in result) ||
+    !result.command ||
+    typeof result.command !== "object" ||
+    !("id" in result.command) ||
+    typeof result.command.id !== "string"
+  )
+    return null;
+  const id = result.command.id;
+  return { current: commands.find((command) => command.id === id) };
+}
+
+// Suggest a convenient starting network without overwriting user input or remembered routes.
+export function suggestAdvertiseRoutes(current: string, enabled: boolean): string {
+  return enabled && !current.trim() ? "192.168.0.0/24" : current;
+}
diff --git a/app/routes/enrollment/keys-panel.tsx b/app/routes/enrollment/keys-panel.tsx
new file mode 100644
index 0000000..c8f1bda
--- /dev/null
+++ b/app/routes/enrollment/keys-panel.tsx
@@ -0,0 +1,192 @@
+import { FileKey2 } from "lucide-react";
+import { useMemo, useState } from "react";
+
+import Code from "~/components/code";
+import Notice from "~/components/notice";
+import Select from "~/components/select";
+import TableList from "~/components/table-list";
+import { getUserDisplayName } from "~/utils/user";
+
+import AuthKeyRow from "../settings/auth-keys/auth-key-row";
+import AddAuthKey from "../settings/auth-keys/dialogs/add-auth-key";
+import type { loader } from "./data";
+type Status = "all" | "active" | "expired" | "reusable" | "ephemeral";
+export default function Page({
+  loaderData: {
+    keys,
+    missing,
+    users,
+    url,
+    access,
+    selfServiceOnly,
+    currentHeadscaleUserId,
+    currentSubject,
+  },
+}: {
+  loaderData: Awaited<ReturnType<typeof loader>>;
+}) {
+  const [selectedUser, setSelectedUser] = useState("__headplane_all");
+  const [status, setStatus] = useState<Status>("active");
+  const isDisabled = !access || keys.flatMap(({ preAuthKeys }) => preAuthKeys).length === 0;
+
+  const filteredKeys = useMemo(() => {
+    const now = new Date();
+    return keys
+      .filter(({ user }) => {
+        if (selectedUser === "__headplane_all") {
+          return true;
+        }
+
+        if (selectedUser === "__headplane_tag_only") {
+          return user === null;
+        }
+
+        return user?.id === selectedUser;
+      })
+      .flatMap(({ preAuthKeys }) => preAuthKeys)
+      .filter((key) => {
+        if (status === "all") {
+          return true;
+        }
+
+        if (status === "ephemeral") {
+          return key.ephemeral;
+        }
+
+        if (status === "reusable") {
+          return key.reusable;
+        }
+
+        const expiry = new Date(key.expiration);
+        if (status === "expired") {
+          // Expired keys are either used or expired
+          // BUT only used if they are not reusable
+          if (key.used && !key.reusable) {
+            return true;
+          }
+
+          return expiry < now;
+        }
+
+        if (status === "active") {
+          // Active keys are either not expired or reusable
+          if (expiry < now) {
+            return false;
+          }
+
+          if (!key.used) {
+            return true;
+          }
+
+          return key.reusable;
+        }
+
+        return false;
+      });
+  }, [keys, selectedUser, status]);
+
+  return (
+    <div className="flex max-w-6xl flex-col">
+      {!access ? (
+        <Notice title="预认证密钥权限受限" variant="warning">
+          您无权生成预认证密钥。请联系管理员申请权限，或请管理员为您生成密钥。
+        </Notice>
+      ) : missing.length > 0 ? (
+        <Notice title="缺少认证密钥" variant="error">
+          获取以下用户的认证密钥时发生错误：{" "}
+          {missing.map(({ user }, index) => (
+            <>
+              <Code key={user.id}>{getUserDisplayName(user)}</Code>
+              {index < missing.length - 1 ? ", " : ". "}
+            </>
+          ))}
+          其密钥可能无法正确显示。请查看服务器日志以了解详情。
+        </Notice>
+      ) : undefined}
+      {access && (
+        <AddAuthKey
+          currentHeadscaleUserId={currentHeadscaleUserId}
+          currentSubject={currentSubject}
+          selfServiceOnly={selfServiceOnly}
+          url={url}
+          users={users}
+        />
+      )}
+      <div className="surface mt-6 grid gap-4 p-5 sm:grid-cols-2 lg:max-w-2xl">
+        <Select
+          className="w-full"
+          defaultValue="__headplane_all"
+          disabled={isDisabled}
+          label="用户"
+          onValueChange={(value) => setSelectedUser(value ?? "")}
+          placeholder="选择用户"
+          items={[
+            { value: "__headplane_all", label: "全部" },
+            ...keys.flatMap(({ user }) =>
+              user ? [{ value: user.id, label: getUserDisplayName(user) }] : [],
+            ),
+            ...(keys.some(({ user }) => user === null)
+              ? [{ value: "__headplane_tag_only", label: "仅标签" }]
+              : []),
+          ]}
+        />
+        <Select
+          className="w-full"
+          defaultValue="active"
+          disabled={isDisabled}
+          label="状态"
+          onValueChange={(value) => setStatus((value ?? "active") as Status)}
+          placeholder="选择状态"
+          items={[
+            { value: "all", label: "全部" },
+            { value: "active", label: "有效" },
+            { value: "expired", label: "已使用／已过期" },
+            { value: "reusable", label: "可重复使用" },
+            { value: "ephemeral", label: "临时设备" },
+          ]}
+        />
+      </div>
+      <div className="mt-7 mb-3 flex items-center justify-between gap-3">
+        <h2 className="surface-title">密钥列表</h2>
+        <span className="text-xs text-mist-500">当前显示 {filteredKeys.length} 个密钥</span>
+      </div>
+      <TableList>
+        {keys.flatMap(({ preAuthKeys }) => preAuthKeys).length === 0 ? (
+          <TableList.Item className="flex flex-col items-center gap-3 py-12 text-mist-500">
+            <FileKey2 />
+            <p className="font-semibold">尚未创建预认证密钥。</p>
+          </TableList.Item>
+        ) : filteredKeys.length === 0 ? (
+          <TableList.Item className="flex flex-col items-center gap-3 py-12 text-mist-500">
+            <FileKey2 />
+            <p className="font-semibold">没有预认证密钥符合所选筛选条件。</p>
+          </TableList.Item>
+        ) : (
+          filteredKeys.map((key) => {
+            // Tag-only keys have no user
+            if (!key.user) {
+              return (
+                <TableList.Item key={key.id}>
+                  <AuthKeyRow authKey={key} user={null} />
+                </TableList.Item>
+              );
+            }
+
+            // TODO: Why is Headscale using email as the user ID here?
+            // https://github.com/juanfont/headscale/issues/2520
+            const user = users.find((user) => user.id === key.user?.id);
+            if (!user) {
+              return null;
+            }
+
+            return (
+              <TableList.Item key={key.id}>
+                <AuthKeyRow authKey={key} user={user} />
+              </TableList.Item>
+            );
+          })
+        )}
+      </TableList>
+    </div>
+  );
+}
