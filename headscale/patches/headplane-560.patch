+import { spawnSync } from "node:child_process";
+
+import { describe, expect, test } from "vitest";
+
+import {
+  buildEnrollmentCommand,
+  DEFAULT_ENROLLMENT_OPTIONS,
+  DEFAULT_KEY_DAYS,
+  parseNetworkList,
+  validateEnrollmentOptions,
+  validateServerUrl,
+} from "~/utils/enrollment-command";
+
+const server = "https://mesh.example.com";
+const key = "hskey-auth-0123456789abcdefABCDEF_safe-token";
+const base = `tailscale up --login-server=${server} --auth-key=${key}`;
+const common = "--accept-dns=false --accept-routes=false --advertise-exit-node=false";
+
+describe("universal enrollment commands", () => {
+  test("defaults to reusable 999-day configuration without resetting clients", () => {
+    expect(DEFAULT_KEY_DAYS).toBe(999);
+    expect(validateEnrollmentOptions({})).toEqual({
+      acceptDns: false,
+      acceptRoutes: false,
+      advertiseRoutes: [],
+      advertiseExitNode: false,
+      exitNode: "",
+      exitNodeAllowLanAccess: false,
+      hostname: "",
+      advertiseTags: [],
+      ssh: false,
+      shieldsUp: false,
+      unattended: false,
+      reset: false,
+      forceReauth: false,
+    });
+    expect(buildEnrollmentCommand(server, key, DEFAULT_ENROLLMENT_OPTIONS)).toBe(
+      `${base} ${common}`,
+    );
+  });
+
+  test("allows explicitly accepting server DNS after the default is disabled", () => {
+    expect(
+      buildEnrollmentCommand(server, key, validateEnrollmentOptions({ acceptDns: true })),
+    ).toContain("--accept-dns=true");
+  });
+  test("preserves the reported existing DNS-disabled exit-node preferences", () => {
+    const options = validateEnrollmentOptions({ acceptDns: false, advertiseExitNode: true });
+    expect(buildEnrollmentCommand(server, key, options)).toBe(
+      `${base} --accept-dns=false --accept-routes=false --advertise-exit-node=true`,
+    );
+  });
+
+  test("serializes all advertising options in stable single-line order", () => {
+    const options = validateEnrollmentOptions({
+      acceptDns: false,
+      acceptRoutes: true,
+      advertiseRoutes: ["192.168.1.0/24", "fd00::/64"],
+      advertiseExitNode: true,
+      hostname: "office-node-1",
+      advertiseTags: ["tag:office", "tag:server-1"],
+      ssh: true,
+      shieldsUp: true,
+      unattended: true,
+      reset: true,
+    });
+    expect(buildEnrollmentCommand(`${server}/`, key, options)).toBe(
+      `${base} --accept-dns=false --accept-routes=true --advertise-exit-node=true --advertise-routes=192.168.1.0/24,fd00::/64 --hostname=office-node-1 --advertise-tags=tag:office,tag:server-1 --ssh --shields-up --unattended --reset`,
+    );
+  });
+
+  test("serializes selected exit node and local LAN access", () => {
+    const options = validateEnrollmentOptions({
+      exitNode: "100.64.0.5",
+      exitNodeAllowLanAccess: true,
+    });
+    expect(buildEnrollmentCommand(server, key, options)).toBe(
+      `${base} ${common} --exit-node=100.64.0.5 --exit-node-allow-lan-access`,
+    );
+  });
+
+  test.each(["fd7a:115c:a1e0::5", "office-node", "office-node.example.ts.net"])(
+    "accepts exit node address or DNS name: %s",
+    (exitNode) => {
+      expect(buildEnrollmentCommand(server, key, validateEnrollmentOptions({ exitNode }))).toBe(
+        `${base} ${common} --exit-node=${exitNode}`,
+      );
+    },
