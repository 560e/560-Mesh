index 0000000..502467e
--- /dev/null
+++ b/tests/unit/network/derp-runtime.test.ts
@@ -0,0 +1,92 @@
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { afterEach, expect, it } from "vitest";
+import { parse, parseDocument, isMap } from "yaml";
+
+import { createPrivateStore } from "~/server/network/store";
+
+import { createRuntimeController } from "../../../scripts/network-runtime";
+const dirs: string[] = [];
+afterEach(async () => {
+  await Promise.all(dirs.splice(0).map((d) => rm(d, { recursive: true, force: true })));
+});
+async function setup(validate: (path: string) => Promise<void> = async () => {}) {
+  const root = await mkdtemp(join(tmpdir(), "derp-runtime-"));
+  dirs.push(root);
+  const base = join(root, "base.yaml");
+  await writeFile(
+    base,
+    "server_url: https://hs.example.com\ndns:\n  base_domain: tail.example.com\nderp:\n  server:\n    enabled: false\n  urls: [https://controlplane.tailscale.com/derpmap/default]\n  paths: []\n",
+  );
+  const store = createPrivateStore(join(root, "settings"));
+  const runtime = createRuntimeController({
+    basePath: base,
+    runtimeDirectory: join(root, "runtime"),
+    store,
+    validate,
+    officialRegionIds: async () => [900],
+  });
+  return { root, base, store, runtime };
+}
+const settings = {
+  officialEnabled: false,
+  customEnabled: true,
+  address: "https://derp.example.com",
+  stunEnabled: false,
+  stunPort: 3478,
+};
+it("leaves base config untouched and acknowledges settings only after healthy startup", async () => {
+  const x = await setup();
+  await x.store.write("derp-request.json", { schema: 1, revision: "one", settings });
+  const candidate = await x.runtime.prepare();
+  expect(await x.store.read("derp-status.json")).toBeNull();
+  const config = parse(await readFile(candidate.configPath, "utf8"));
+  expect(config.derp.urls).toEqual([]);
+  const mapSource = await readFile(config.derp.paths[0], "utf8");
+  const regionMap = parseDocument(mapSource).get("regions", true);
+  expect(isMap(regionMap)).toBe(true);
+  if (isMap(regionMap)) expect(regionMap.items[0].key).toMatchObject({ value: 900 });
+  const map = parse(mapSource);
+  expect(map.regions["900"].nodes[0].hostname).toBe("derp.example.com");
+  expect(await readFile(x.base, "utf8")).toContain("controlplane.tailscale.com");
+  await x.runtime.healthy(candidate);
+  expect(await x.store.read("derp-status.json")).toMatchObject({ active: { revision: "one" } });
+});
+it("restores the last healthy selection after failed candidate and does not retry it forever", async () => {
+  const x = await setup();
+  await x.store.write("derp-request.json", { schema: 1, revision: "one", settings });
+  const first = await x.runtime.prepare();
+  await x.runtime.healthy(first);
+  await x.store.write("derp-request.json", {
+    schema: 1,
+    revision: "two",
+    settings: { ...settings, address: "https://broken.example.com" },
+  });
+  const failed = await x.runtime.prepare();
+  await x.runtime.failed(failed, "startup failed");
+  const fallback = await x.runtime.prepare();
+  expect(fallback.revision).toBe("one");
+  const status: any = await x.store.read("derp-status.json");
+  expect(status.failed.revision).toBe("two");
+  expect(parse(await readFile(fallback.configPath, "utf8")).derp.paths).toHaveLength(1);
+});
+it("returns to the original base when the first custom DERP setting fails", async () => {
+  const x = await setup();
+  await x.store.write("derp-request.json", { schema: 1, revision: "bad", settings });
+  const bad = await x.runtime.prepare();
+  await x.runtime.failed(bad, "no");
+  const original = await x.runtime.prepare();
+  expect(original.revision).toBe("base");
+  expect(parse(await readFile(original.configPath, "utf8")).derp.urls).toEqual([
+    "https://controlplane.tailscale.com/derpmap/default",
+  ]);
+});
+it("validates generated candidate before starting services", async () => {
+  const x = await setup(async () => {
+    throw new Error("invalid config");
+  });
+  await x.store.write("derp-request.json", { schema: 1, revision: "bad", settings });
+  await expect(x.runtime.prepare()).rejects.toThrow("invalid config");
+});
