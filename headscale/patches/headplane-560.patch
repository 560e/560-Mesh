diff --git a/app/layout/navigation.ts b/app/layout/navigation.ts
new file mode 100644
index 0000000..aa5b952
--- /dev/null
+++ b/app/layout/navigation.ts
@@ -0,0 +1,98 @@
+import {
+  Globe,
+  LockKeyhole,
+  Server,
+  Settings2,
+  TerminalSquare,
+  Users,
+  Radio,
+  ShieldCheck,
+  Cpu,
+  SlidersHorizontal,
+  Palette,
+} from "lucide-react";
+export interface ConsoleAccess {
+  ui: boolean;
+  machines: boolean;
+  dns: boolean;
+  users: boolean;
+  policy: boolean;
+  settings: boolean;
+}
+const navigation = [
+  { to: "/machines", icon: Server, label: "设备工作台", key: "machines", group: "工作空间" },
+  {
+    to: "/enrollment",
+    icon: TerminalSquare,
+    label: "设备接入",
+    key: "machines",
+    group: "工作空间",
+  },
+  { to: "/users", icon: Users, label: "用户与互通", key: "users", group: "工作空间" },
+  { to: "/settings", icon: Settings2, label: "系统设置", key: "settings", group: "系统管理" },
+] as const;
+export function consoleNavigation(access: ConsoleAccess, _configAvailable: boolean) {
+  if (!access.ui) return [];
+  return navigation.filter((item) =>
+    item.key === "settings" ? access.settings || access.dns || access.policy : access[item.key],
+  );
+}
+export function settingsNavigation(
+  access: ConsoleAccess,
+  configWritable: boolean,
+  oidc: boolean,
+  localAccount: boolean,
+) {
+  if (!access.ui) return [];
+  return [
+    {
+      to: "/settings/dns",
+      label: "DNS 与域名",
+      description: "名称解析与 MagicDNS",
+      icon: Globe,
+      allowed: access.dns,
+    },
+    {
+      to: "/settings/acls",
+      label: "访问控制",
+      description: "网络策略与访问规则",
+      icon: LockKeyhole,
+      allowed: access.policy,
+    },
+    {
+      to: "/settings/derp",
+      label: "DERP 中继",
+      description: "官方与自建中继",
+      icon: Radio,
+      allowed: access.dns,
+    },
+    {
+      to: "/settings/site",
+      label: "站点外观",
+      description: "公开首页与站点标题",
+      icon: Palette,
+      allowed: access.settings,
+    },
+    {
+      to: "/settings/account",
+      label: "账号安全",
+      description: "管理员密码",
+      icon: ShieldCheck,
+      allowed: localAccount,
+    },
+    {
+      to: "/settings/agent",
+      label: "设备代理",
+      description: "客户端信息同步",
+      icon: Cpu,
+      allowed: access.settings,
+    },
+    {
+      to: "/settings/restrictions",
+      label: "认证限制",
+      description: "OIDC 用户与域名",
+      icon: SlidersHorizontal,
+      allowed: access.settings && configWritable && oidc,
+    },
+  ].filter((item) => item.allowed);
+}
