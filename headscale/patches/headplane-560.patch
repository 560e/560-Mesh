diff --git a/app/routes/machines/components/machine-card.tsx b/app/routes/machines/components/machine-card.tsx
new file mode 100644
index 0000000..906fe89
--- /dev/null
+++ b/app/routes/machines/components/machine-card.tsx
@@ -0,0 +1,73 @@
+import { Copy, Monitor, ArrowUpRight } from "lucide-react";
+import type { ComponentProps } from "react";
+
+import Link from "~/components/link";
+import StatusCircle from "~/components/status-circle";
+import { copyToClipboard } from "~/utils/copy";
+import { getOSInfo } from "~/utils/host-info";
+import { formatTimeDelta } from "~/utils/time";
+import toast from "~/utils/toast";
+
+import MachineRow, { uiTagsForNode, mapTagsToComponents } from "./machine-row";
+import MenuOptions from "./menu";
+type Props = ComponentProps<typeof MachineRow>;
+export default function MachineCard(props: Props) {
+  const { node, isAgent } = props;
+  return (
+    <article className="device-card group">
+      <div className="flex items-start gap-3">
+        <span className="device-icon">
+          <Monitor className="size-5" />
+        </span>
+        <div className="min-w-0 flex-1">
+          <Link to={`/machines/${node.id}`} className="device-name">
+            {node.givenName}
+          </Link>
+          <p className="mt-1 truncate text-xs text-mist-500">
+            {node.hostInfo ? getOSInfo(node.hostInfo) : "操作系统未采集"}
+          </p>
+        </div>
+        <MenuOptions {...props} />
+      </div>
+      <button
+        type="button"
+        className="device-address"
+        aria-label={`复制 ${node.givenName} 的 IP 地址`}
+        onClick={async () =>
+          toast(
+            (await copyToClipboard(node.ipAddresses[0] ?? ""))
+              ? "已复制 IP 地址"
+              : "复制失败，请手动复制。",
+          )
+        }
+      >
+        <span>{node.ipAddresses[0] ?? "暂无地址"}</span>
+        <Copy className="size-3.5" />
+      </button>
+      <div className="flex min-h-7 flex-wrap items-center gap-1.5">
+        {mapTagsToComponents(node, uiTagsForNode(node, isAgent))}
+        {node.tags?.map((tag) => (
+          <span className="device-tag" key={tag}>
+            {tag}
+          </span>
+        ))}
+      </div>
+      <div className="device-card-footer">
+        <span className="inline-flex items-center gap-1.5 text-xs">
+          <StatusCircle className="size-3" isOnline={node.online && !node.expired} />
+          {node.expired ? (
+            "已过期"
+          ) : node.online ? (
+            "在线"
+          ) : (
+            <span suppressHydrationWarning>{formatTimeDelta(new Date(node.lastSeen))}在线</span>
+          )}
+        </span>
+        <Link to={`/machines/${node.id}`} className="inline-flex items-center gap-1 text-xs">
+          设备详情
+          <ArrowUpRight className="size-3" />
+        </Link>
+      </div>
+    </article>
+  );
+}
