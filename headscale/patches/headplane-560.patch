diff --git a/app/components/sheet.tsx b/app/components/sheet.tsx
new file mode 100644
index 0000000..12e9d40
--- /dev/null
+++ b/app/components/sheet.tsx
@@ -0,0 +1,40 @@
+import { Dialog } from "@base-ui/react/dialog";
+import { X } from "lucide-react";
+import { useEffect, type ReactNode } from "react";
+
+import { useLiveData } from "~/utils/live-data";
+export default function Sheet({
+  open,
+  onOpenChange,
+  title,
+  children,
+}: {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  title: string;
+  children: ReactNode;
+}) {
+  const { pause, resume } = useLiveData();
+  useEffect(() => {
+    if (open) pause();
+    return () => {
+      if (open) resume();
+    };
+  }, [open, pause, resume]);
+  return (
+    <Dialog.Root open={open} onOpenChange={onOpenChange}>
+      <Dialog.Portal>
+        <Dialog.Backdrop className="sheet-backdrop" />
+        <Dialog.Popup className="sheet-panel">
+          <div className="sheet-heading">
+            <Dialog.Title className="text-base font-semibold">{title}</Dialog.Title>
+            <Dialog.Close className="console-icon-button" aria-label="关闭抽屉">
+              <X className="size-5" />
+            </Dialog.Close>
+          </div>
+          <div className="sheet-body">{children}</div>
+        </Dialog.Popup>
+      </Dialog.Portal>
+    </Dialog.Root>
+  );
+}
