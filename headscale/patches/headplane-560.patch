new file mode 100644
index 0000000..2f1053e
--- /dev/null
+++ b/app/server/network/policy.ts
@@ -0,0 +1,113 @@
+import { createHash } from "node:crypto";
+
+import type { User } from "~/types";
+import { scanHuJson } from "~/utils/node-info";
+
+import { NetworkSettingsError } from "./error";
+export const SHARING_GROUP = "group:560-interconnect";
+export interface SharingIdentity {
+  id: string;
+  selector: string;
+}
+const ownRule = { action: "accept", src: ["autogroup:member"], dst: ["autogroup:self:*"] };
+const peerRule = { action: "accept", src: [SHARING_GROUP], dst: [SHARING_GROUP + ":*"] };
+function same(a: unknown, b: unknown) {
+  return JSON.stringify(a) === JSON.stringify(b);
+}
+function object(v: unknown): v is Record<string, unknown> {
+  return Boolean(v) && typeof v === "object" && !Array.isArray(v);
+}
+export function readPolicy(raw: string): Record<string, unknown> {
+  if (raw.length > 2 * 1024 * 1024) throw new NetworkSettingsError("策略文件过大。");
+  try {
+    const parsed = JSON.parse(scanHuJson(raw.trim() || "{}").stripped);
+    if (!object(parsed)) throw new Error();
+    return parsed;
+  } catch {
+    throw new NetworkSettingsError("无法解析现有访问策略，请先在高级策略中修复。");
+  }
+}
+function ruleIs(rule: unknown, expected: Record<string, unknown>) {
+  return (
+    object(rule) &&
+    Object.keys(rule).length === Object.keys(expected).length &&
+    Object.entries(expected).every(([key, value]) => same(rule[key], value))
+  );
+}
+export function inspectPolicy(raw: string) {
+  const p = readPolicy(raw),
+    a = p.acls,
+    grants = p.grants;
+  let migratable = grants === undefined || (Array.isArray(grants) && grants.length === 0);
+  if (a !== undefined) {
+    const defaultRule = { action: "accept", src: ["*"], dst: ["*:*"] };
+    const plain = Array.isArray(a) && a.length > 0 && a.every((r) => ruleIs(r, defaultRule));
+    const managed =
+      Array.isArray(a) &&
+      a.length > 0 &&
+      ruleIs(a[0], ownRule) &&
+      (a.length === 1 || (a.length === 2 && ruleIs(a[1], peerRule))) &&
+      (a.length === 1 || (object(p.groups) && Array.isArray(p.groups[SHARING_GROUP])));
+    migratable = migratable && (plain || managed);
+  }
+  const group = object(p.groups) ? p.groups[SHARING_GROUP] : undefined;
+  if (group !== undefined && !(Array.isArray(a) && a.length > 0 && ruleIs(a[0], ownRule)))
+    migratable = false;
+  return {
+    migratable,
+    reason: migratable
+      ? null
+      : "现有自定义 ACL/Grants 不能自动替换。请先导出并在高级策略中手工整理，再启用用户隔离。",
+  };
+}
+// Automatic initialization must not reinterpret an explicit deny or an existing managed policy.
+export function isDefaultAllowAllPolicy(raw: string): boolean {
+  const p = readPolicy(raw);
+  if (p.acls === undefined) return p.grants === undefined;
+  const noGrants = p.grants === undefined || (Array.isArray(p.grants) && p.grants.length === 0);
+  return (
+    noGrants &&
+    Array.isArray(p.acls) &&
+    p.acls.length > 0 &&
+    p.acls.every((rule) => ruleIs(rule, { action: "accept", src: ["*"], dst: ["*:*"] }))
+  );
+}
+export function selectedIdentities(users: User[], ids: string[]): SharingIdentity[] {
+  if (!Array.isArray(ids) || ids.some((id) => typeof id !== "string"))
+    throw new NetworkSettingsError("用户列表无效。");
+  function selector(u: User) {
+    // Headscale's explicit username selector has a terminal @; an OIDC email is already a full identity.
+    const value = u.provider === "oidc" && u.email ? u.email : u.name + "@";
+    if (!value || value.length > 512 || /\s/.test(value))
+      throw new NetworkSettingsError("存在无法安全引用的用户身份。");
+    return value;
+  }
+  const selectors = users.map(selector);
+  if (new Set(selectors).size !== selectors.length)
+    throw new NetworkSettingsError("存在重复的策略身份，无法安全启用互通。");
+  return [...new Set(ids)].sort().map((id) => {
+    const u = users.find((u) => u.id === id);
+    if (!u) throw new NetworkSettingsError("用户已删除或不存在，请刷新后重试。", 409);
+    return { id, selector: selector(u) };
+  });
+}
+export function buildSharingPolicy(
+  raw: string,
+  identities: SharingIdentity[],
+  alreadyManaged = false,
+): string {
+  if (!alreadyManaged && !inspectPolicy(raw).migratable)
+    throw new NetworkSettingsError(inspectPolicy(raw).reason!, 409);
+  const p = readPolicy(raw);
+  const groups = object(p.groups) ? { ...p.groups } : {};
+  delete groups[SHARING_GROUP];
+  if (identities.length) groups[SHARING_GROUP] = identities.map((i) => i.selector);
+  if (Object.keys(groups).length) p.groups = groups;
+  else delete p.groups;
+  delete p.grants; // Accepted migrations have no grants; managed mode owns the network-rule sections.
+  p.acls = identities.length >= 2 ? [ownRule, peerRule] : [ownRule];
+  return JSON.stringify(p, null, 2) + "\n";
+}
+export function policyDigest(raw: string) {
+  return createHash("sha256").update(raw).digest("hex");
+}
diff --git a/app/server/network/sharing-bootstrap.ts b/app/server/network/sharing-bootstrap.ts
new file mode 100644
index 0000000..31f8590
--- /dev/null
+++ b/app/server/network/sharing-bootstrap.ts
@@ -0,0 +1,35 @@
+interface Options {
+  retryMs?: number;
+  onError: (error: unknown) => void;
+}
+export function createSharingBootstrap(
+  initialize: () => Promise<unknown>,
+  { retryMs = 5000, onError }: Options,
+) {
+  let timer: ReturnType<typeof setTimeout> | undefined,
+    disposed = false,
+    started = false;
+  async function attempt(): Promise<void> {
+    if (disposed) return;
+    try {
+      await initialize();
+    } catch (error) {
+      onError(error);
+      if (!disposed) {
+        timer = setTimeout(() => void attempt(), retryMs);
+        timer.unref?.();
+      }
+    }
+  }
+  return {
+    async start() {
+      if (started || disposed) return;
+      started = true;
+      await attempt();
+    },
+    dispose() {
+      disposed = true;
+      if (timer) clearTimeout(timer);
+    },
+  };
+}
diff --git a/app/server/network/sharing.ts b/app/server/network/sharing.ts
new file mode 100644
index 0000000..6332667
--- /dev/null
+++ b/app/server/network/sharing.ts
@@ -0,0 +1,320 @@
+import { randomUUID } from "node:crypto";
+
+import type { HeadscaleClient } from "../headscale/api";
+import { isDataWithApiError } from "../headscale/api/error-client";
+import { NetworkSettingsError } from "./error";
+import {
+  buildSharingPolicy,
+  inspectPolicy,
+  isDefaultAllowAllPolicy,
+  policyDigest,
+  selectedIdentities,
+  type SharingIdentity,
+} from "./policy";
+import type { PrivateStore } from "./store";
+interface SharingState {
+  schema: 1;
+  revision: string;
+  managed: boolean;
+  selected: SharingIdentity[];
+  policyDigest: string | null;
+}
+interface Journal {
+  before: SharingState;
+  target: SharingState;
+  beforeDigest: string;
+}
+const empty = (): SharingState => ({
+  schema: 1,
+  revision: "initial",
+  managed: false,
+  selected: [],
+  policyDigest: null,
+});
+function stateFrom(v: unknown): SharingState {
+  if (v === null) return empty();
+  const s = v as SharingState;
+  if (
+    s.schema !== 1 ||
+    typeof s.revision !== "string" ||
+    typeof s.managed !== "boolean" ||
+    !Array.isArray(s.selected) ||
+    s.selected.some((i) => !i || typeof i.id !== "string" || typeof i.selector !== "string") ||
+    !(s.policyDigest === null || typeof s.policyDigest === "string")
+  )
+    throw new NetworkSettingsError("互通设置损坏，请管理员检查备份；未自动重置访问策略。", 503);
+  return s;
+}
+function hasSharingDecision(value: unknown): boolean {
+  if (value === null) return false;
+  const state = stateFrom(value);
+  return (
+    state.managed ||
+    state.revision !== "initial" ||
+    state.selected.length > 0 ||
+    state.policyDigest !== null
+  );
+}
+export function createSharingService(store: PrivateStore) {
+  async function snapshot(api: HeadscaleClient) {
+    const users = await api.users.list();
+    let raw: string,
+      writable = true;
+    try {
+      const p = await api.policy.get();
+      raw = p.policy;
+      writable = p.updatedAt !== null;
+    } catch (e) {
+      if (isDataWithApiError(e) && e.data.rawData.includes("acl policy not found")) raw = "";
+      else throw e;
+    }
+    const digest = policyDigest(raw);
+    let state = stateFrom(await store.read("sharing.json"));
+    const pending = (await store.read("sharing-pending.json")) as Journal | null;
+    let unresolved = false;
+    if (pending) {
+      const before = stateFrom(pending.before),
+        target = stateFrom(pending.target);
+      if (digest === target.policyDigest) {
+        state = target;
+        await store.write("sharing.json", state);
+        await store.remove("sharing-pending.json");
+      } else if (digest === pending.beforeDigest) {
+        state = before;
+        await store.write("sharing.json", state);
+        await store.remove("sharing-pending.json");
+      } else unresolved = true;
+    }
+    let identityDrift = false;
+    try {
+      identityDrift =
+        JSON.stringify(
+          selectedIdentities(
+            users,
+            state.selected.map((i) => i.id),
+          ),
+        ) !== JSON.stringify(state.selected);
+    } catch {
+      identityDrift = true;
+    }
+    const drift = unresolved || (state.managed && (digest !== state.policyDigest || identityDrift));
+    const token = policyDigest(
+      JSON.stringify([
+        state.revision,
+        digest,
+        users.map((u) => [u.id, u.name, u.email, u.provider]),
+      ]),
+    );
+    let migration = { migratable: false, reason: null as string | null };
+    try {
+      migration = inspectPolicy(raw);
+    } catch (e) {
+      migration.reason = e instanceof Error ? e.message : String(e);
+    }
+    return { users, raw, digest, state, token, writable, drift, migration };
+  }
+  function viewOf(x: Awaited<ReturnType<typeof snapshot>>) {
+    return {
+      mode: x.drift
+        ? ("drifted" as const)
+        : x.state.managed
+          ? ("managed" as const)
+          : ("unmanaged" as const),
+      token: x.token,
+      selectedIds: x.state.selected.map((i) => i.id),
+      writable: x.writable,
+      migratable: x.migration.migratable,
+      reason: x.drift
+        ? "访问策略或用户身份已在外部修改，当前不能保证界面中的隔离设置仍然有效。请切换到高级策略管理并检查。"
+        : x.migration.reason,
+      backupAvailable: false,
+      users: x.users.map((u) => ({ id: u.id, name: u.displayName || u.name })),
+      policy: x.raw,
+    };
+  }
+  async function view(api: HeadscaleClient) {
+    return store.serial(async () => {
+      const v = viewOf(await snapshot(api));
+      v.backupAvailable = (await store.readText("sharing-original.hujson")) !== null;
+      return v;
+    });
+  }
+  function valid(x: Awaited<ReturnType<typeof snapshot>>, token: string) {
+    if (!x.writable)
+      throw new NetworkSettingsError("策略为文件模式只读，请使用数据库策略模式。", 403);
+    if (token !== x.token)
+      throw new NetworkSettingsError("页面已过期或访问策略已改变，请刷新后重试。", 409);
+  }
+  async function commitPolicy(
+    api: HeadscaleClient,
+    x: Awaited<ReturnType<typeof snapshot>>,
+    raw: string,
+    target: SharingState,
+  ) {
+    await store.write("sharing-pending.json", {
+      before: x.state,
+      target,
+      beforeDigest: x.digest,
+    } satisfies Journal);
+    // Re-read after backup/journal I/O, immediately before committing.
+    // Headscale has no conditional PUT; operators must use one policy writer.
+    let latest: string;
+    try {
+      latest = (await api.policy.get()).policy;
+    } catch (error) {
+      if (isDataWithApiError(error) && error.data.rawData.includes("acl policy not found"))
+        latest = "";
+      else throw error;
+    }
+    if (policyDigest(latest) !== x.digest) {
+      await store.remove("sharing-pending.json");
+      throw new NetworkSettingsError(
+        "提交前检测到外部策略变更，已取消保存。请刷新检查；手工修改 ACL 前先退出互通管理。",
+        409,
+      );
+    }
+    let writeError: unknown;
+    try {
+      await api.policy.set(raw);
+    } catch (e) {
+      writeError = e;
+    }
+    const current = await api.policy.get(); // Prove the authoritative result, including a response-lost retry.
+    if (policyDigest(current.policy) !== target.policyDigest) {
+      if (policyDigest(current.policy) === x.digest) await store.remove("sharing-pending.json");
+      throw writeError ?? new NetworkSettingsError("策略写入结果与预期不一致，请刷新并检查。", 409);
+    }
+    await store.write("sharing.json", target);
+    await store.remove("sharing-pending.json");
+  }
+  return {
+    // Called once during application startup, using the configured server API credential.
+    // A persisted decision (including explicit release/restore) always takes precedence.
+    initializeDefaults(api: HeadscaleClient) {
+      return store.serial(async () => {
+        if (hasSharingDecision(await store.read("sharing.json"))) return "preserved" as const;
+        const x = await snapshot(api);
+        if (hasSharingDecision(await store.read("sharing.json")) || x.drift)
+          return "preserved" as const;
+        if (!x.writable) return "read-only" as const;
+        if (!x.migration.migratable || !isDefaultAllowAllPolicy(x.raw))
+          return "custom-policy" as const;
+        const raw = buildSharingPolicy(x.raw, []);
+        if ((await store.readText("sharing-original.hujson")) === null)
+          await store.writeText("sharing-original.hujson", x.raw);
+        const target: SharingState = {
+          schema: 1,
+          revision: randomUUID(),
+          managed: true,
+          selected: [],
+          policyDigest: policyDigest(raw),
+        };
+        await commitPolicy(api, x, raw, target);
+        return "enabled" as const;
+      });
+    },
+    view,
+    preview(api: HeadscaleClient, input: { token: string; selectedIds: string[] }) {
+      return store.serial(async () => {
+        const x = await snapshot(api);
+        valid(x, input.token);
+        if (x.drift) throw new NetworkSettingsError("策略已变化，请先检查高级策略。", 409);
+        const selected = selectedIdentities(x.users, input.selectedIds);
+        return {
+          before: x.raw,
+          after: buildSharingPolicy(x.raw, selected, x.state.managed),
+          token: x.token,
+          selectedIds: selected.map((i) => i.id),
+        };
+      });
+    },
+    withPolicyWrite<T>(api: HeadscaleClient, fn: () => Promise<T>) {
+      return store.serial(async () => {
+        const x = await snapshot(api);
+        if (x.state.managed)
+          throw new NetworkSettingsError(
+            "当前由用户互通功能管理访问策略，请先在用户页切换到高级策略管理。",
+            409,
+          );
+        return fn();
+      });
+    },
+    withUserMutation<T>(api: HeadscaleClient, id: string, fn: () => Promise<T>) {
+      return store.serial(async () => {
+        const x = await snapshot(api);
+        if (x.state.managed && x.state.selected.some((u) => u.id === id))
+          throw new NetworkSettingsError("请先关闭该用户的跨用户互通，再重命名或删除用户。", 409);
+        return fn();
+      });
+    },
+    apply(
+      api: HeadscaleClient,
+      input: { token: string; selectedIds: string[]; activate?: boolean },
+    ) {
+      return store.serial(async () => {
+        const x = await snapshot(api);
+        valid(x, input.token);
+        if (x.drift)
+          throw new NetworkSettingsError("访问策略已偏离受管设置，请先检查高级策略。", 409);
+        if (!x.state.managed && !input.activate)
+          throw new NetworkSettingsError("请先预览并明确启用用户隔离。", 409);
+        const selected = selectedIdentities(x.users, input.selectedIds);
+        const raw = buildSharingPolicy(x.raw, selected, x.state.managed);
+        if ((await store.readText("sharing-original.hujson")) === null)
+          await store.writeText("sharing-original.hujson", x.raw);
+        const target: SharingState = {
+          schema: 1,
+          revision: randomUUID(),
+          managed: true,
+          selected,
+          policyDigest: policyDigest(raw),
+        };
+        await commitPolicy(api, x, raw, target);
+        return viewOf(await snapshot(api));
+      });
+    },
+    release(api: HeadscaleClient, token: string) {
+      return store.serial(async () => {
+        const x = await snapshot(api);
+        valid(x, token);
+        await store.write("sharing.json", { ...empty(), revision: randomUUID() });
+        await store.remove("sharing-pending.json");
+        return viewOf(await snapshot(api));
+      });
+    },
+    restore(api: HeadscaleClient, token: string) {
+      return store.serial(async () => {
+        const x = await snapshot(api);
+        valid(x, token);
+        const backup = await store.readText("sharing-original.hujson");
+        if (backup === null) throw new NetworkSettingsError("没有可恢复的原始策略。", 404);
+        // Empty SetPolicy is a no-op in Headscale: explicitly restore its default behavior.
+        const raw = backup.trim()
+          ? backup
+          : JSON.stringify({ acls: [{ action: "accept", src: ["*"], dst: ["*:*"] }] }, null, 2) +
+            "\n";
+        const target = { ...empty(), revision: randomUUID(), policyDigest: policyDigest(raw) };
+        await commitPolicy(api, x, raw, target);
+        return viewOf(await snapshot(api));
+      });
+    },
+    assertUserMutable(api: HeadscaleClient, id: string) {
+      return store.serial(async () => {
+        const x = await snapshot(api);
+        if (x.state.managed && x.state.selected.some((u) => u.id === id))
+          throw new NetworkSettingsError("请先关闭该用户的跨用户互通，再重命名或删除用户。", 409);
+      });
+    },
+    guardPolicyWrite(api: HeadscaleClient) {
+      return store.serial(async () => {
+        const x = await snapshot(api);
+        if (x.state.managed)
+          throw new NetworkSettingsError(
+            "当前由用户互通功能管理访问策略。请先在用户页切换到高级策略管理。",
+            409,
+          );
+      });
+    },
+  };
+}
+export type SharingService = ReturnType<typeof createSharingService>;
