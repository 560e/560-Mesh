new file mode 100644
index 0000000..e207823
--- /dev/null
+++ b/app/components/motion.tsx
@@ -0,0 +1,19 @@
+import { MotionConfig, motion, type HTMLMotionProps } from "motion/react";
+import type { ReactNode } from "react";
+
+// Visible first render is intentional: server-rendered controls work before hydration.
+export function ConsoleMotion({ children }: { children: ReactNode }) {
+  return (
+    <MotionConfig reducedMotion="user" transition={{ duration: 0.2, ease: [0.22, 1, 0.36, 1] }}>
+      {children}
+    </MotionConfig>
+  );
+}
+
+export function MotionSurface({ children, ...props }: HTMLMotionProps<"div">) {
+  return (
+    <motion.div initial={{ y: 6 }} animate={{ y: 0 }} {...props}>
+      {children}
+    </motion.div>
+  );
+}
