+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { expect, it } from "vitest";
+
+import { createDerpService } from "~/server/network/derp";
+import { createPrivateStore } from "~/server/network/store";
+it("requires server-side permission, rejects stale saves and reports pending until runtime acknowledgment", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "derp-service-"));
+  try {
+    let allowed = false;
+    const store = createPrivateStore(dir);
+    const auth: any = { require: async () => ({}), can: () => allowed };
+    const service = createDerpService({
+      store,
+      auth,
+      basePath: undefined,
+      probe: async () => ({ ok: true, message: "protocol verified" }),
+    });
+    const req = new Request("https://hs.example/adminis/settings/derp");
+    await expect(service.view(req)).rejects.toMatchObject({ status: 403 });
+    allowed = true;
+    const initial = await service.view(req);
+    expect(initial.phase).toBe("active");
+    await store.write("derp-status.json", {
+      schema: 1,
+      active: { revision: "base", settings: null },
+      failed: null,
+      updatedAt: "now",
+    });
+    const input = {
+      officialEnabled: false,
+      customEnabled: true,
+      address: "derp.example.com",
+      stunEnabled: false,
+      stunPort: 3478,
+    };
+    await service.save(req, initial.token, input, false);
+    const saved = await service.view(req);
+    expect(saved.phase).toBe("pending");
+    expect(saved.settings.address).toBe("https://derp.example.com");
+    await expect(service.save(req, initial.token, input, false)).rejects.toMatchObject({
+      status: 409,
+    });
+    const request: any = await store.read("derp-request.json");
+    await store.write("derp-status.json", {
+      schema: 1,
+      active: { revision: request.revision, settings: request.settings },
+      failed: null,
+      updatedAt: "later",
+    });
+    expect((await service.view(req)).phase).toBe("active");
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
