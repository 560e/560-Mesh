new file mode 100644
index 0000000..b0013eb
--- /dev/null
+++ b/app/server/enrollment/service.ts
@@ -0,0 +1,454 @@
+import { createHash, randomUUID } from "node:crypto";
+
+import type { PreAuthKey, User } from "~/types";
+import type { EnrollmentOptions, StoredEnrollmentCommand } from "~/types/Enrollment";
+import {
+  buildEnrollmentCommand,
+  DEFAULT_KEY_DAYS,
+  validateEnrollmentOptions,
+  validateServerUrl,
+} from "~/utils/enrollment-command";
+
+import type { HeadscaleClient } from "../headscale/api";
+import { type AuthService, type Principal, isUserPrincipal } from "../web/auth";
+import { getOidcSubject } from "../web/headscale-identity";
+import { Capabilities } from "../web/roles";
+import type { EnrollmentStore } from "./store";
+
+export class EnrollmentError extends Error {
+  constructor(
+    message: string,
+    public readonly status = 400,
+  ) {
+    super(message);
+  }
+}
+export interface CreateEnrollmentKeyInput {
+  userId: string | null;
+  aclTags?: string[];
+  expiryDays?: string | number;
+  reusable?: boolean;
+  ephemeral?: boolean;
+  nonce: string;
+}
+export interface SaveEnrollmentCommandInput {
+  id?: string;
+  name: string;
+  keyId?: string;
+  newKey?: Omit<CreateEnrollmentKeyInput, "nonce">;
+  options: unknown;
+  nonce: string;
+}
+export interface EnrollmentKeyView extends PreAuthKey {
+  secretAvailable: boolean;
+  unavailableReason: string | null;
+}
+export interface EnrollmentCommandView extends StoredEnrollmentCommand {
+  command: string | null;
+  available: boolean;
+  unavailableReason: string | null;
+}
+interface Dependencies {
+  auth: Pick<AuthService, "can">;
+  apiForRequest: (request: Request) => Promise<{ principal: Principal; api: HeadscaleClient }>;
+  store: EnrollmentStore;
+  publicUrl: string;
+}
+function fail(message: string, status = 400): never {
+  throw new EnrollmentError(message, status);
+}
+function actorId(principal: Principal) {
+  return isUserPrincipal(principal)
+    ? `user:${principal.user.id}`
+    : `api:${createHash("sha256").update(principal.apiKey).digest("hex")}`;
+}
+function hash(input: unknown) {
+  return createHash("sha256").update(JSON.stringify(input)).digest("hex");
+}
+function validId(id: string) {
+  if (!id || id.length > 256) fail("缺少或无效的标识。");
+  return id;
+}
+function normalizeOptions(input: unknown): EnrollmentOptions {
+  try {
+    return validateEnrollmentOptions(input);
+  } catch (error) {
+    return fail(error instanceof Error ? error.message : "命令选项无效。");
+  }
+}
+function keyInput(input: Omit<CreateEnrollmentKeyInput, "nonce">) {
+  const days = input.expiryDays ?? DEFAULT_KEY_DAYS;
+  if (!/^\d+$/.test(String(days).trim())) fail("`expiry` 必须为整数天数。");
+  const count = Number(days);
+  const expiration = new Date(Date.now() + count * 86400000);
+  if (!Number.isSafeInteger(count) || count < 1 || !Number.isFinite(expiration.getTime()))
+    fail("`expiry` 必须为整数天数。");
+  if (input.reusable !== undefined && typeof input.reusable !== "boolean")
+    fail("重复使用设置无效。");
+  if (input.ephemeral !== undefined && typeof input.ephemeral !== "boolean")
+    fail("临时设备设置无效。");
+  const aclTags = input.aclTags ?? [];
+  if (
+    !Array.isArray(aclTags) ||
+    aclTags.some((tag) => typeof tag !== "string" || !/^tag:[a-zA-Z][a-zA-Z0-9_-]*$/.test(tag))
+  )
+    fail("ACL 标签无效。");
+  const user = input.userId || null;
+  if (user !== null && typeof user !== "string") fail("用户无效。");
+  if (!user && !aclTags.length) fail("必须指定用户或 ACL 标签。");
+  return {
+    user,
+    aclTags: aclTags.length ? aclTags : null,
+    reusable: input.reusable ?? true,
+    ephemeral: input.ephemeral ?? false,
+    expiration,
+  };
+}
+
+export function createEnrollmentService({ auth, apiForRequest, store, publicUrl }: Dependencies) {
+  const locks = new Map<string, Promise<unknown>>();
+  const global = (principal: Principal) => auth.can(principal, Capabilities.generate_authkeys);
+  const canManageTags = (principal: Principal) =>
+    global(principal) && auth.can(principal, Capabilities.use_tags);
+  function authorizeTagUse(principal: Principal, tags: string[] | null | undefined) {
+    if (tags?.length && !canManageTags(principal))
+      fail("您无权管理带标签的预认证密钥或加入命令。", 403);
+  }
+  function canManageKey(principal: Principal, key: PreAuthKey) {
+    // For tagged keys, user records the creator, not the enrolled node's owner.
+    if (key.aclTags?.length || !key.user) return canManageTags(principal);
+    return ownsUser(principal, key.user);
+  }
+  async function session(request: Request) {
+    const result = await apiForRequest(request);
+    if (
+      !global(result.principal) &&
+      !auth.can(result.principal, Capabilities.generate_own_authkeys)
+    )
+      fail("您无权管理预认证密钥。", 403);
+    return result;
+  }
+  function ownsUser(principal: Principal, user: User | null) {
+    return (
+      global(principal) ||
+      Boolean(
+        user &&
+        isUserPrincipal(principal) &&
+        (principal.user.headscaleUserId === user.id ||
+          getOidcSubject(user) === principal.user.subject),
+      )
+    );
+  }
+  async function authorizeUser(principal: Principal, api: HeadscaleClient, userId: string | null) {
+    if (!userId) {
+      if (!canManageTags(principal)) fail("您无权管理仅标签密钥。", 403);
+      return;
+    }
+    const user = (await api.users.list({ id: userId })).find((u) => u.id === userId);
+    if (!user) fail("未找到用户。", 404);
+    if (!ownsUser(principal, user)) fail("您无权管理此用户的预认证密钥。", 403);
+  }
+  async function snapshot(api: HeadscaleClient) {
+    const users = await api.users.list();
+    // Never treat a failed global request as an empty list, or deletion/reveal may
+    // be based on an incomplete view of the actual owner.
+    const keys = api.preAuthKeys.listAll
+      ? await api.preAuthKeys.listAll()
+      : (await Promise.all(users.map((u) => api.preAuthKeys.listForUser(u.id)))).flat();
+    return { users, keys };
+  }
+  async function realKey(principal: Principal, api: HeadscaleClient, id: string) {
+    validId(id);
+    const found = (await snapshot(api)).keys.find((k) => k.id === id);
+    if (!found) fail("预认证密钥不存在或已删除。", 404);
+    if (!canManageKey(principal, found)) fail("您无权管理此预认证密钥。", 403);
+    return found;
+  }
+  async function keyView(key: PreAuthKey): Promise<EnrollmentKeyView> {
+    // The store itself distinguishes complete official values from masked prefixes.
+    try {
+      await store.rememberKey(key);
+    } catch {
+      /* Keep metadata visible when the vault is unavailable. */
+    }
+    let secret: string | null = null;
+    try {
+      secret = await store.revealKey(key);
+    } catch {
+      /* Corruption must never reveal guessed values. */
+    }
+    // An authorized complete official API value is usable even for historical keys.
+    if (
+      !secret &&
+      (/^hskey-auth-[A-Za-z0-9_-]{12}-[A-Za-z0-9_-]{32,}$/.test(key.key) ||
+        (/^[A-Za-z0-9_-]{32,}$/.test(key.key) && !key.key.startsWith("hskey-auth-")))
+    )
+      secret = key.key;
+    return {
+      ...key,
+      key: secret ?? key.key,
+      secretAvailable: secret !== null,
+      unavailableReason: secret ? null : "历史密钥仅有前缀，或本地密钥库不可用；请新建密钥。",
+    };
+  }
+  function commandOwner(principal: Principal, command: StoredEnrollmentCommand) {
+    if (!global(principal) && command.creatorId !== actorId(principal))
+      fail("您无权管理此加入命令。", 403);
+  }
+  async function commandView(
+    principal: Principal,
+    api: HeadscaleClient,
+    record: StoredEnrollmentCommand,
+  ): Promise<EnrollmentCommandView> {
+    commandOwner(principal, record);
+    authorizeTagUse(principal, record.options.advertiseTags);
+    let reason: string | null = null;
+    const currentUrl = validateServerUrl(publicUrl);
+    if (record.serverUrl !== currentUrl) reason = "服务器地址已变更，请更新命令。";
+    let key: PreAuthKey | undefined;
+    try {
+      key = await realKey(principal, api, record.keyId);
+    } catch (error) {
+      if (error instanceof EnrollmentError && error.status === 404) reason ??= "关联密钥已删除。";
+      else throw error;
+    }
+    if (
+      key &&
+      (!Number.isFinite(Date.parse(key.expiration)) || Date.parse(key.expiration) <= Date.now())
+    )
+      reason ??= "关联密钥已过期。";
+    if (key && !key.reusable)
+      reason ??= key.used ? "关联的一次性密钥已使用。" : "关联密钥不可重复使用。";
+    let command: string | null = null;
+    if (key && !reason) {
+      const view = await keyView(key);
+      if (!view.secretAvailable) reason = view.unavailableReason;
+      else command = buildEnrollmentCommand(record.serverUrl, view.key, record.options);
+    }
+    return { ...record, command, available: command !== null, unavailableReason: reason };
+  }
+  async function operation<T>(
+    principal: Principal,
+    nonce: string,
+    fingerprint: string,
+    replay: (receipt: { keyId: string; commandId: string | null }) => Promise<T>,
+    perform: (id: string) => Promise<T>,
+  ) {
+    if (typeof nonce !== "string" || !/^[a-zA-Z0-9_-]{1,128}$/.test(nonce))
+      fail("请求标识无效，请刷新后重试。");
+    const id = hash([actorId(principal), nonce]);
+    const prior = locks.get(id) ?? Promise.resolve();
+    const current = prior
+      .catch(() => {})
+      .then(async () => {
+        const receipt = await store.getOperation(id);
+        if (receipt) {
+          if (receipt.fingerprint !== fingerprint)
+            fail("此请求标识已用于其他操作，请刷新后重试。", 409);
+          return replay(receipt);
+        }
+        return perform(id);
+      });
+    locks.set(id, current);
+    try {
+      return await current;
+    } finally {
+      if (locks.get(id) === current) locks.delete(id);
+    }
+  }
+  async function compensate(api: HeadscaleClient, key: PreAuthKey) {
+    // Real deletion is preferred; on old Headscale the only safe compensation is expiry.
+    if (api.preAuthKeys.delete) await api.preAuthKeys.delete(key);
+    else await api.preAuthKeys.expire(key);
+    await store.forgetKey(key.id);
+  }
+  return {
+    async listKeys(request: Request) {
+      const { principal, api } = await session(request);
+      const { users, keys } = await snapshot(api);
+      const visible = keys.filter((key) => canManageKey(principal, key));
+      return {
+        users: users.filter((user) => ownsUser(principal, user)),
+        keys: await Promise.all(visible.map(keyView)),
+        missing: [],
+      };
+    },
+    async createKey(request: Request, input: CreateEnrollmentKeyInput) {
+      const { principal, api } = await session(request);
+      const normalized = keyInput(input);
+      authorizeTagUse(principal, normalized.aclTags);
+      await authorizeUser(principal, api, normalized.user);
+      // Fingerprint the selected day count, never the moving expiration timestamp.
+      const fingerprint = hash([
+        "key",
+        { ...normalized, expiration: input.expiryDays ?? DEFAULT_KEY_DAYS },
+      ]);
+      return operation(
+        principal,
+        input.nonce,
+        fingerprint,
+        async (receipt) => {
+          const key = await realKey(principal, api, receipt.keyId);
+          if (
+            !Number.isFinite(Date.parse(key.expiration)) ||
+            Date.parse(key.expiration) <= Date.now() ||
+            (key.used && !key.reusable)
+          )
+            fail("此请求创建的预认证密钥已过期或已使用，请重新创建。", 409);
+          return keyView(key);
+        },
+        async (id) => {
+          const key = await api.preAuthKeys.create(normalized);
+          try {
+            await store.rememberKey(key);
+            const secret = await store.revealKey(key);
+            if (!secret) fail("密钥库不可用，未保留新密钥。", 503);
+            await store.saveOperation({ id, fingerprint, keyId: key.id, commandId: null });
+            return { ...key, key: secret, secretAvailable: true, unavailableReason: null };
+          } catch {
+            try {
+              await compensate(api, key);
+            } catch {
+              fail("密钥保存失败且自动撤销失败，请管理员检查预认证密钥。", 503);
+            }
+            return fail("密钥保存失败，新密钥已撤销，请重试。", 503);
+          }
+        },
+      );
+    },
+    async expireKey(request: Request, id: string) {
+      const { principal, api } = await session(request);
+      const key = await realKey(principal, api, id);
+      await api.preAuthKeys.expire(key);
+    },
+    async deleteKey(request: Request, id: string) {
+      const { principal, api } = await session(request);
+      const key = await realKey(principal, api, id);
+      if (!api.preAuthKeys.delete) fail("当前 Headscale 版本不支持删除预认证密钥。", 409);
+      await api.preAuthKeys.delete(key);
+      await store.forgetKey(key.id);
+    },
+    async listCommands(request: Request) {
+      const { principal, api } = await session(request);
+      const records = (await store.listCommands()).filter(
+        (c) => global(principal) || c.creatorId === actorId(principal),
+      );
+      const result: EnrollmentCommandView[] = [];
+      for (const record of records) {
+        try {
+          result.push(await commandView(principal, api, record));
+        } catch (error) {
+          // Ownership changed upstream: do not expose the template or secret to its former owner.
+          if (!(error instanceof EnrollmentError && error.status === 403)) throw error;
+        }
+      }
+      return result;
+    },
+    async saveCommand(request: Request, input: SaveEnrollmentCommandInput) {
+      const { principal, api } = await session(request);
+      const name = typeof input.name === "string" ? input.name.trim() : "";
+      if (!name || name.length > 120 || /[\r\n]/.test(name) || name.includes("\0"))
+        fail("命令名称必须为 1–120 个字符。");
+      const options = normalizeOptions(input.options);
+      authorizeTagUse(principal, options.advertiseTags);
+      let serverUrl: string;
+      try {
+        serverUrl = validateServerUrl(publicUrl);
+      } catch {
+        return fail("公开服务器地址无效，请管理员检查配置。", 503);
+      }
+      const original = input.id ? await store.getCommand(validId(input.id)) : null;
+      if (input.id && !original) fail("加入命令不存在。", 404);
+      if (original) commandOwner(principal, original);
+      if (input.newKey && (input.keyId || original)) fail("编辑命令时不能更换为新密钥。");
+      const existingId = input.keyId ?? original?.keyId;
+      if (!existingId && !input.newKey) fail("请选择密钥或创建新密钥。");
+      const newInput = input.newKey ? keyInput(input.newKey) : null;
+      if (newInput) authorizeTagUse(principal, newInput.aclTags);
+      if (newInput && !newInput.reusable) fail("加入命令需要可重复使用的密钥。");
+      if (newInput) await authorizeUser(principal, api, newInput.user);
+      if (existingId) await realKey(principal, api, existingId);
+      const fingerprint = hash([
+        "command",
+        {
+          id: input.id ?? null,
+          name,
+          keyId: existingId ?? null,
+          newKey: input.newKey ?? null,
+          options,
+          serverUrl,
+        },
+      ]);
+      return operation(
+        principal,
+        input.nonce,
+        fingerprint,
+        async (receipt) => {
+          const record = receipt.commandId ? await store.getCommand(receipt.commandId) : null;
+          if (!record) fail("此请求对应的加入命令已删除。", 409);
+          return commandView(principal, api, record);
+        },
+        async (operationId) => {
+          let created: PreAuthKey | undefined;
+          const key = newInput
+            ? (created = await api.preAuthKeys.create(newInput))
+            : await realKey(principal, api, existingId!);
+          const now = new Date().toISOString();
+          const record: StoredEnrollmentCommand = {
+            id: original?.id ?? randomUUID(),
+            name,
+            creatorId: original?.creatorId ?? actorId(principal),
+            userId: key.user?.id ?? null,
+            keyId: key.id,
+            serverUrl,
+            options,
+            createdAt: original?.createdAt ?? now,
+            updatedAt: now,
+          };
+          try {
+            if (created) {
+              await store.rememberKey(created);
+              if (!(await store.revealKey(created))) fail("密钥库不可用，未保留新密钥。", 503);
+            }
+            const view = await commandView(principal, api, record);
+            if (!view.available) fail(view.unavailableReason ?? "命令不可用。", 409);
+            await store.saveCommand(record);
+            await store.saveOperation({
+              id: operationId,
+              fingerprint,
+              keyId: key.id,
+              commandId: record.id,
+            });
+            return view;
+          } catch (error) {
+            let rollbackFailed = false;
+            try {
+              if (original) await store.saveCommand(original);
+              else await store.deleteCommand(record.id);
+            } catch {
+              rollbackFailed = true;
+            }
+            if (created) {
+              try {
+                await compensate(api, created);
+              } catch {
+                fail("命令保存失败且自动撤销失败，请管理员检查预认证密钥。", 503);
+              }
+            }
+            if (rollbackFailed) fail("加入命令保存和本地回滚失败，请管理员检查。", 503);
+            if (error instanceof EnrollmentError) throw error;
+            return fail("加入命令保存失败，请重试。", 503);
+          }
+        },
+      );
+    },
+    async deleteCommand(request: Request, id: string) {
+      const { principal } = await session(request);
+      const record = await store.getCommand(validId(id));
+      if (!record) fail("加入命令不存在。", 404);
+      commandOwner(principal, record);
+      await store.deleteCommand(record.id);
+    },
+  };
+}
+export type EnrollmentService = ReturnType<typeof createEnrollmentService>;
