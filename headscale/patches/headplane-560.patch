+import { createElement } from "react";
+import { renderToString } from "react-dom/server";
+import { createMemoryRouter, RouterProvider } from "react-router";
+import { describe, expect, test } from "vitest";
+
+import CommandCard from "~/routes/enrollment/command-card";
+import CommandForm from "~/routes/enrollment/command-form";
+import { keyIsSelectable, prepareAttempt, previewCommand } from "~/routes/enrollment/form-state";
+import AuthKeyRow from "~/routes/settings/auth-keys/auth-key-row";
+import { action, loader } from "~/routes/settings/auth-keys/overview";
+import { appConfigContext, requestApiContext } from "~/server/context";
+import { DEFAULT_ENROLLMENT_OPTIONS } from "~/utils/enrollment-command";
+
+describe("enrollment form safety", () => {
+  test("preview never exports an existing real secret", () => {
+    const preview = previewCommand("https://mesh.example.com", DEFAULT_ENROLLMENT_OPTIONS);
+    expect(preview).toContain("tailscale up");
+    expect(preview).toContain("REPLACE_AFTER_SAVE");
+    expect(preview).not.toContain("--reset");
+  });
+  test("retries keep a nonce while changed input starts a different attempt", () => {
+    const first = prepareAttempt(null, "first");
+    expect(prepareAttempt(first, "first")).toBe(first);
+    expect(prepareAttempt(first, "changed").nonce).not.toBe(first.nonce);
+  });
+  test("only recoverable active reusable keys can back a reusable command", () => {
+    const key = { secretAvailable: true, reusable: true, used: false, expiration: "2099-01-01" };
+    expect(keyIsSelectable(key)).toBe(true);
+    expect(keyIsSelectable({ ...key, secretAvailable: false })).toBe(false);
+    expect(keyIsSelectable({ ...key, reusable: false })).toBe(false);
+    expect(keyIsSelectable({ ...key, expiration: "2000-01-01" })).toBe(false);
+    expect(keyIsSelectable({ ...key, used: true })).toBe(true);
+  });
+});
+
+describe("Chinese enrollment form rendering", () => {
+  test("new commands default to automatic reusable long-lived keys and placeholder preview", () => {
+    const router = createMemoryRouter(
+      [
+        {
+          path: "/",
+          loader: () => ({}),
+          Component: () =>
+            createElement(CommandForm, {
+              users: [{ id: "1", name: "alice" }] as any,
+              keys: [],
+              commands: [],
+              url: "https://mesh.example.com",
+              selfServiceOnly: false,
+              onFinished: () => {},
+            }),
+        },
+      ],
+      { hydrationData: { loaderData: { "0": {} } } },
+    );
+    const html = renderToString(createElement(RouterProvider, { router }));
+    expect(html).toContain("自动创建预认证密钥");
+    expect(html).toContain('value="999"');
+    expect(html).toContain("可重复使用、999 天、非临时设备");
+    expect(html).toContain("REPLACE_AFTER_SAVE");
+    expect(html).toContain("IP 转发");
+    expect(html).toContain('aria-label="发布子网路由"');
+    expect(html).toContain("请保留客户端提示的完整参数");
+    expect(html).toContain("重置未指定的客户端偏好");
+    expect(html).toContain('aria-label="强制重新认证"');
+    expect(html.match(/<pre[^>]*>(.*?)<\/pre>/s)?.[1]).not.toContain("--force-reauth");
+    expect(html.match(/<pre[^>]*>(.*?)<\/pre>/s)?.[1]).not.toContain("--reset");
+    expect(html).not.toContain("sudo");
+    router.dispose();
+  });
+});
+
+describe("unavailable secrets remain unavailable in rendered views", () => {
+  test("disabled command retains metadata without exporting command text", () => {
+    const router = createMemoryRouter(
+      [
+        {
+          path: "/",
+          loader: () => ({}),
+          Component: () =>
+            createElement(CommandCard, {
+              command: {
+                id: "saved",
+                name: "办公室路由",
+                keyId: "historical",
+                serverUrl: "https://old.example",
+                updatedAt: "2026-10-27T00:00:00Z",
+                available: false,
+                unavailableReason: "服务器地址已变更",
+                command: "SECRET_MUST_NOT_RENDER",
+              } as any,
+              onEdit: () => {},
+            }),
+        },
+      ],
+      { hydrationData: { loaderData: { "0": {} } } },
+    );
+    const html = renderToString(createElement(RouterProvider, { router }));
+    expect(html).toContain("办公室路由");
+    expect(html).toContain("服务器地址已变更");
+    expect(html).toContain("删除命令记录");
+    expect(html).not.toContain("SECRET_MUST_NOT_RENDER");
+    expect(html).not.toContain("点击复制");
+    router.dispose();
+  });
+  test("tag-only historical keys offer deletion but never masked-key copying", () => {
+    const router = createMemoryRouter(
+      [
+        {
+          path: "/",
+          loader: () => ({}),
+          Component: () =>
+            createElement(AuthKeyRow, {
+              authKey: {
+                id: "tag-only",
+                key: "prefix…",
+                user: null,
+                reusable: false,
+                used: false,
+                ephemeral: false,
+                createdAt: "2026-01-01",
+                expiration: "2099-01-01",
+                secretAvailable: false,
+                unavailableReason: "历史密钥没有完整值",
+              } as any,
+              user: null,
+            }),
+        },
+      ],
+      { hydrationData: { loaderData: { "0": {} } } },
+    );
+    const html = renderToString(createElement(RouterProvider, { router }));
+    expect(html).toContain("删除密钥");
+    expect(html).toContain("历史密钥没有完整值");
+    expect(html).not.toContain("点击复制");
+    router.dispose();
+  });
+});
+
+describe("enrollment route authentication", () => {
+  test("loader and action redirect unauthenticated sessions without exposing the raw error", async () => {
+    const args = {
+      request: new Request("https://console.example/enrollment"),
+      context: {
+        get: (key: unknown) => {
+          if (key === requestApiContext)
+            return async () => {
+              throw new Error("Session expired raw diagnostic");
+            };
+          if (key === appConfigContext) return { headscale: {} };
+          return undefined;
+        },
+      },
+      params: {},
+    } as any;
+    for (const handler of [loader, action]) {
+      let response: unknown;
+      try {
+        await handler(args);
+      } catch (error) {
+        response = error;
+      }
+      expect(response).toBeInstanceOf(Response);
+      expect((response as Response).status).toBe(302);
+      expect((response as Response).headers.get("Location")).toBe("/login");
+      expect(await (response as Response).text()).not.toContain("raw diagnostic");
+    }
+  });
+});
