diff --git a/app/routes/users/components/sharing-panel.tsx b/app/routes/users/components/sharing-panel.tsx
new file mode 100644
index 0000000..d4881c0
--- /dev/null
+++ b/app/routes/users/components/sharing-panel.tsx
@@ -0,0 +1,204 @@
+import { Network, ShieldCheck, ShieldAlert, UsersRound, ChevronDown } from "lucide-react";
+import { useEffect, useState } from "react";
+import { useFetcher } from "react-router";
+
+import Button from "~/components/button";
+import Switch from "~/components/switch";
+import type { SharingService } from "~/server/network/sharing";
+type View = Awaited<ReturnType<SharingService["view"]>>;
+export default function SharingPanel({ view, writable }: { view: View; writable: boolean }) {
+  const fetcher = useFetcher<{
+    error?: string;
+    message?: string;
+    preview?: { before: string; after: string; token: string; selectedIds: string[] };
+  }>();
+  const [selected, setSelected] = useState(view.selectedIds);
+  const [restore, setRestore] = useState(false);
+  useEffect(() => {
+    setSelected(view.selectedIds);
+  }, [view.token]);
+  const pending = fetcher.state !== "idle";
+  const changed =
+    JSON.stringify([...selected].sort()) !== JSON.stringify([...view.selectedIds].sort());
+  const preview = fetcher.data?.preview;
+  const previewValid =
+    preview?.token === view.token &&
+    JSON.stringify([...preview.selectedIds].sort()) === JSON.stringify([...selected].sort());
+  const managed = view.mode === "managed",
+    drifted = view.mode === "drifted";
+  const canApply = writable && view.writable && !drifted && (managed || view.migratable);
+  const submit = (action: string) => {
+    const form = new FormData();
+    form.set("action_id", action);
+    form.set("sharing_token", view.token);
+    if (!managed) form.set("sharing_activate", "yes");
+    for (const id of selected) form.append("sharing_user", id);
+    if (restore) form.set("confirm_restore", "yes");
+    void fetcher.submit(form, { method: "post" });
+  };
+  return (
+    <section className="surface-card mb-8 overflow-hidden" aria-label="用户互通设置">
+      <div className="flex flex-wrap items-center gap-3 border-b border-mist-100 p-5 dark:border-mist-800">
+        <span className="surface-icon">
+          <Network className="size-5" />
+        </span>
+        <div className="min-w-0 flex-1">
+          <h2 className="surface-title">用户互通</h2>
+          <p className="mt-1 text-xs text-mist-500">
+            {managed
+              ? "默认按用户隔离，双方开启互通后才可跨用户访问。"
+              : "双方开启才可跨用户互通；隔离状态以当前访问策略为准。"}
+          </p>
+        </div>
+        <span
+          className={
+            managed
+              ? "rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"
+              : "rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-500/10 dark:text-amber-300"
+          }
+        >
+          {managed ? "隔离已启用" : drifted ? "策略已变化" : "尚未启用隔离管理"}
+        </span>
+      </div>
+      <div className="space-y-5 p-5">
+        {!managed && (
+          <div className="flex gap-3 rounded-xl bg-amber-50 p-4 text-sm text-amber-800 dark:bg-amber-500/10 dark:text-amber-200">
+            <ShieldAlert className="mt-0.5 size-4 shrink-0" />
+            <p>
+              {view.reason ??
+                "当前网络权限由已有 ACL 决定。请先预览，再启用用户隔离；本页面的关闭状态暂不代表已经隔离。"}
+            </p>
+          </div>
+        )}
+        <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
+          {view.users.map((user) => (
+            <div
+              key={user.id}
+              className="flex items-center gap-3 rounded-xl border border-mist-200/70 bg-white p-4 dark:border-mist-800 dark:bg-slate-900/40"
+            >
+              <UsersRound className="size-5 shrink-0 text-indigo-500" />
+              <div className="min-w-0 flex-1">
+                <p className="truncate text-sm font-semibold">{user.name}</p>
+                <p className="mt-0.5 text-xs text-mist-500">
+                  {selected.includes(user.id) ? "参与用户互通组" : "仅自己的个人设备"}
+                </p>
+              </div>
+              <Switch
+                label={user.name + "允许用户互通"}
+                checked={selected.includes(user.id)}
+                disabled={!canApply || pending}
+                onCheckedChange={(on) =>
+                  setSelected((current) =>
+                    on ? [...current, user.id] : current.filter((id) => id !== user.id),
+                  )
+                }
+              />
+            </div>
+          ))}
+        </div>
+        {!view.users.length && (
+          <p className="text-sm text-mist-500">尚无 Headscale 用户，请先创建用户。</p>
+        )}
+        <p className="flex gap-2 text-xs leading-relaxed text-mist-500">
+          <ShieldCheck className="size-4 shrink-0" />
+          手工修改 ACL
+          前请先退出互通管理，避免同时从多个入口写入。仅适用于用户个人设备。带标签的设备、子网路由、出口节点和组网内
+          DNS 需要独立权限规则。管理台管理员仍可管理全部设备。
+        </p>
+        {fetcher.data?.error && (
+          <p
+            role="alert"
+            className="rounded-lg bg-red-50 p-3 text-sm text-red-700 dark:bg-red-500/10 dark:text-red-300"
+          >
+            {fetcher.data.error}
+          </p>
+        )}
+        {fetcher.data?.message && (
+          <p
+            role="status"
+            className="rounded-lg bg-emerald-50 p-3 text-sm text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300"
+          >
+            {fetcher.data.message}
+          </p>
+        )}
+        {previewValid && (
+          <details open className="rounded-xl border border-indigo-200 p-4 dark:border-indigo-900">
+            <summary className="flex cursor-pointer items-center gap-2 text-sm font-semibold">
+              <ChevronDown className="size-4" />
+              策略变更预览
+            </summary>
+            <p className="my-3 text-xs text-mist-500">
+              应用后将替换默认全网互通规则，未开启的用户仅能访问自己的个人设备。原策略会保存一份备份。
+            </p>
+            <div className="grid gap-3 lg:grid-cols-2">
+              {[
+                ["当前策略", preview!.before || "（默认全网互通）"],
+                ["应用后的策略", preview!.after],
+              ].map(([title, raw]) => (
+                <div key={title}>
+                  <p className="mb-2 text-xs font-semibold">{title}</p>
+                  <pre className="max-h-60 overflow-auto rounded-lg bg-mist-100 p-3 text-xs dark:bg-mist-950">
+                    {raw}
+                  </pre>
+                </div>
+              ))}
+            </div>
+          </details>
+        )}
+        <div className="flex flex-wrap items-center gap-3">
+          {!managed ? (
+            <>
+              <Button disabled={!canApply || pending} onClick={() => submit("sharing_preview")}>
+                预览隔离策略
+              </Button>
+              <Button
+                variant="heavy"
+                disabled={!canApply || pending || !previewValid}
+                onClick={() => submit("sharing_apply")}
+              >
+                {pending ? "正在应用…" : "启用用户隔离并应用"}
+              </Button>
+            </>
+          ) : (
+            <Button
+              variant="heavy"
+              disabled={!canApply || pending || !changed}
+              onClick={() => submit("sharing_apply")}
+            >
+              {pending ? "正在保存…" : "保存互通设置"}
+            </Button>
+          )}
+          {changed && <span className="text-xs text-amber-600">有未保存的更改</span>}
+          {view.mode !== "unmanaged" && writable && (
+            <Button variant="ghost" disabled={pending} onClick={() => submit("sharing_release")}>
+              切换到高级策略管理
+            </Button>
+          )}
+        </div>
+        {view.backupAvailable && writable && (
+          <details className="border-t border-mist-100 pt-4 dark:border-mist-800">
+            <summary className="cursor-pointer text-xs text-mist-500">恢复启用前的策略</summary>
+            <div className="mt-3 flex flex-wrap items-center gap-3">
+              <label className="text-xs">
+                <input
+                  type="checkbox"
+                  checked={restore}
+                  onChange={(e) => setRestore(e.target.checked)}
+                  className="mr-2"
+                />
+                我已确认：恢复原策略可能重新开启跨用户访问
+              </label>
+              <Button
+                variant="danger"
+                disabled={!restore || pending}
+                onClick={() => submit("sharing_restore")}
+              >
+                恢复原策略
+              </Button>
+            </div>
+          </details>
+        )}
+      </div>
+    </section>
+  );
+}
