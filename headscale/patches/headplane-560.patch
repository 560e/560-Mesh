+import type { HeadscaleClient } from "../headscale/api";
+import type { AuthService, Principal } from "../web/auth";
+import { Capabilities } from "../web/roles";
+import { NetworkSettingsError } from "./error";
+import type { SharingService } from "./sharing";
+interface Dependencies {
+  auth: Pick<AuthService, "require" | "can">;
+  apiForRequest: (request: Request) => Promise<{ api: HeadscaleClient; principal?: Principal }>;
+  sharing: SharingService;
+}
+export async function sharingAction(
+  request: Request,
+  { auth, apiForRequest, sharing }: Dependencies,
+) {
+  const principal = await auth.require(request);
+  if (
+    !auth.can(principal, Capabilities.write_users) ||
+    !auth.can(principal, Capabilities.write_policy)
+  )
+    throw new NetworkSettingsError("您无权修改用户互通设置。", 403);
+  const f = await request.formData(),
+    action = String(f.get("action_id") ?? ""),
+    token = String(f.get("sharing_token") ?? "");
+  if (!token) throw new NetworkSettingsError("缺少设置版本，请刷新后重试。");
+  const { api } = await apiForRequest(request);
+  if (action === "sharing_preview")
+    return {
+      preview: await sharing.preview(api, {
+        token,
+        selectedIds: f.getAll("sharing_user").map(String),
+      }),
+    };
+  if (action === "sharing_apply") {
+    const sharingView = await sharing.apply(api, {
+      token,
+      selectedIds: f.getAll("sharing_user").map(String),
+      activate: f.get("sharing_activate") === "yes",
+    });
+    return { message: "用户互通设置已生效。", sharingView };
+  }
+  if (action === "sharing_release")
+    return {
+      message: "已切换到高级策略管理，现有网络权限保持不变。",
+      sharingView: await sharing.release(api, token),
+    };
+  if (action === "sharing_restore") {
+    if (f.get("confirm_restore") !== "yes")
+      throw new NetworkSettingsError("请先确认恢复原策略；恢复可能重新开启跨用户访问。");
+    return {
+      message: "原始策略已恢复，用户互通开关已退出管理。",
+      sharingView: await sharing.restore(api, token),
+    };
+  }
+  throw new NetworkSettingsError("未知的互通操作。");
+}
