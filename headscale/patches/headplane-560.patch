@@ -0,0 +1,85 @@
+import { lookup } from "node:dns/promises";
+import { request as httpsRequest } from "node:https";
+
+import { normalizeDerpSettings } from "~/utils/derp-config";
+export function validDerpServerFrame(frame: Buffer) {
+  return (
+    frame.length >= 45 &&
+    frame[0] === 1 &&
+    frame.readUInt32BE(1) === 40 &&
+    frame.subarray(5, 13).equals(Buffer.from("DERP🔑"))
+  );
+}
+export async function probeDerp(address: string): Promise<{ ok: boolean; message: string }> {
+  const normalized = normalizeDerpSettings({
+    officialEnabled: false,
+    customEnabled: true,
+    address,
+    stunEnabled: false,
+  });
+  const url = new URL(normalized.address);
+  url.pathname = "/derp";
+  let dnsTimer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    await Promise.race([
+      lookup(url.hostname.replace(/^\[|\]$/g, "")),
+      new Promise((_, reject) => {
+        dnsTimer = setTimeout(() => reject(new Error("DNS 检测超时。")), 5000);
+      }),
+    ]);
+  } catch {
+    throw new Error("无法解析 DERP 域名，请检查地址和服务器 DNS。");
+  } finally {
+    clearTimeout(dnsTimer);
+  }
+  return new Promise((resolve, reject) => {
+    let settled = false,
+      socket: import("node:net").Socket | undefined;
+    const req = httpsRequest(url, {
+      method: "GET",
+      headers: { Connection: "Upgrade", Upgrade: "DERP" },
+    });
+    const timer = setTimeout(
+      () => finish(new Error("DERP 协议检测超时，请检查反代是否支持连接升级。")),
+      8000,
+    );
+    function finish(error?: Error) {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      socket?.destroy();
+      req.destroy();
+      if (error) reject(error);
+      else
+        resolve({
+          ok: true,
+          message: "域名解析、TLS 证书和 DERP 协议握手通过。STUN 与各客户端网络可达性需另外检查。",
+        });
+    }
+    req.on("upgrade", (_response, upgraded, head) => {
+      socket = upgraded;
+      let data = Buffer.from(head);
+      const consume = (chunk: Buffer) => {
+        data = Buffer.concat([data, chunk]);
+        if (data.length > 65536) return finish(new Error("DERP 服务返回了无效握手。"));
+        if (data.length >= 45)
+          finish(
+            validDerpServerFrame(data) ? undefined : new Error("服务器未返回有效的 DERP 握手。"),
+          );
+      };
+      upgraded.on("data", consume);
+      upgraded.once("error", () => finish(new Error("DERP 握手连接异常。")));
+      upgraded.once("end", () => finish(new Error("DERP 握手连接提前关闭。")));
+      if (data.length >= 45)
+        finish(
+          validDerpServerFrame(data) ? undefined : new Error("服务器未返回有效的 DERP 握手。"),
+        );
+    });
+    req.once("response", (response) => {
+      response.resume();
+      finish(new Error("HTTPS 可访问，但服务器未完成 DERP 协议升级，请检查地址与反代。"));
+    });
+    req.once("error", () => finish(new Error("DERP HTTPS 连接失败，请检查证书、端口和网络。")));
+    req.end();
+  });
+}
