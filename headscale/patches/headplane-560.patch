+import { NetworkSettingsError } from "./error";
+export function derpInputFromForm(form: FormData) {
+  const common = {
+    officialEnabled: form.get("official_enabled") === "yes",
+    customEnabled: form.get("custom_enabled") === "yes",
+  };
+  if (form.has("servers")) {
+    const raw = form.get("servers");
+    if (typeof raw !== "string" || raw.length > 32768)
+      throw new NetworkSettingsError("自建 DERP 列表无效或过大。");
+    try {
+      return { ...common, servers: JSON.parse(raw) as unknown };
+    } catch {
+      throw new NetworkSettingsError("自建 DERP 列表格式无效。");
+    }
+  }
+  return {
+    ...common,
+    address: String(form.get("address") ?? ""),
+    stunEnabled: form.get("stun_enabled") === "yes",
+    stunPort: Number(form.get("stun_port") || 3478),
+  };
+}
