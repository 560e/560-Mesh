+    if (f.get("action_id") !== "derp_save") throw new NetworkSettingsError("未知的 DERP 操作。");
+    const view = await service.save(
+      request,
+      String(f.get("token") ?? ""),
+      input,
+      f.get("replace_existing") === "yes",
+    );
+    return { message: "配置已保存，正在应用。页面会自动检查生效结果。", view };
+  } catch (error) {
+    if (error instanceof NetworkSettingsError) return data({ error: error.message }, error.status);
+    throw error;
+  }
+}
+function draft(settings: DerpSettings) {
+  return { ...settings, servers: customDerpServers(settings) };
+}
+export default function Page({ loaderData: { view, writable } }: Route.ComponentProps) {
+  const fetcher = useFetcher<typeof action>(),
