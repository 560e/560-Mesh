+            <Globe2 className="size-6 text-indigo-500" />
+            <div className="flex-1">
+              <p className="text-sm font-semibold">使用官方 DERP</p>
+              <p className="mt-1 text-xs text-mist-500">使用 Tailscale 官方中继地区列表。</p>
+            </div>
+            <Switch
+              label="使用官方 DERP"
+              checked={settings.officialEnabled}
+              disabled={!writable || busy}
+              onCheckedChange={(value) => setSettings((s) => ({ ...s, officialEnabled: value }))}
+            />
+          </div>
+          <div className="rounded-xl border border-mist-200 p-5 dark:border-mist-800">
+            <div className="flex items-center gap-4">
+              <RadioTower className="size-6 text-violet-500" />
+              <div className="flex-1">
+                <p className="text-sm font-semibold">使用自建 DERP</p>
+                <p className="mt-1 text-xs text-mist-500">填写已有中继服务的地址，端口可省略。</p>
+              </div>
+              <Switch
+                label="使用自建 DERP"
+                checked={settings.customEnabled}
+                disabled={!writable || busy}
+                onCheckedChange={(value) =>
+                  setSettings((s) => ({
+                    ...s,
+                    customEnabled: value,
+                    servers:
