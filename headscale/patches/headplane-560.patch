+import { describe, expect, it } from "vitest";
+
+import { sharingAction } from "~/server/network/actions";
+describe("sharing action authorization", () => {
+  const request = (entries: Record<string, string | string[]>) => {
+    const form = new FormData();
+    for (const [k, v] of Object.entries(entries))
+      for (const s of Array.isArray(v) ? v : [v]) form.append(k, s);
+    return new Request("https://test.example/adminis/users", { method: "POST", body: form });
+  };
+  it("denies missing policy or user permission before reading APIs or state", async () => {
+    let touched = false;
+    const d: any = {
+      auth: { require: async () => ({}), can: () => false },
+      apiForRequest: async () => {
+        touched = true;
+        throw new Error("should not reach");
+      },
+      sharing: {},
+    };
+    await expect(sharingAction(request({ action_id: "sharing_apply" }), d)).rejects.toMatchObject({
+      status: 403,
+    });
+    expect(touched).toBe(false);
+  });
+  it("requires an explicit restore confirmation", async () => {
+    const d: any = {
+      auth: { require: async () => ({}), can: () => true },
+      apiForRequest: async () => ({ api: {} }),
+      sharing: {
+        restore: async () => {
+          throw new Error("must not reach");
+        },
+      },
+    };
+    await expect(
+      sharingAction(request({ action_id: "sharing_restore", sharing_token: "v" }), d),
+    ).rejects.toMatchObject({ status: 400 });
+  });
+  it("passes stable user IDs and the expected token, not user-provided selectors", async () => {
+    let input: unknown;
+    const d: any = {
+      auth: { require: async () => ({}), can: () => true },
+      apiForRequest: async () => ({ api: {} }),
+      sharing: {
+        apply: async (_: unknown, v: unknown) => {
+          input = v;
+          return { mode: "managed" };
+        },
+      },
+    };
+    await sharingAction(
+      request({
+        action_id: "sharing_apply",
+        sharing_token: "v1",
+        sharing_user: ["1", "2"],
+        sharing_activate: "yes",
+      }),
+      d,
+    );
+    expect(input).toEqual({ token: "v1", selectedIds: ["1", "2"], activate: true });
+  });
+});
