+
+import { it, expect } from "vitest";
+
+import { createDerpService } from "~/server/network/derp";
+import { createPrivateStore } from "~/server/network/store";
+it("checks every custom server independently and retains individual failure results", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "derp-multi-service-"));
+  try {
+    const seen: string[] = [];
+    const auth: any = { require: async () => ({}), can: () => true };
+    const service = createDerpService({
+      store: createPrivateStore(dir),
+      auth,
+      probe: async (address) => {
+        seen.push(address);
+        if (address.includes("two")) throw new Error("test unavailable");
+        return { ok: true, message: "verified" };
+      },
+    });
+    const result = await service.check(new Request("https://hs.example.com"), {
+      officialEnabled: true,
+      customEnabled: true,
+      servers: [{ address: "one.example.com" }, { address: "two.example.com" }],
+    });
+    expect(seen).toEqual(["https://one.example.com", "https://two.example.com"]);
+    expect(result.ok).toBe(false);
+    expect(result.results).toEqual([
+      { address: seen[0], ok: true, message: "verified" },
+      { address: seen[1], ok: false, message: "test unavailable" },
+    ]);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+it("persists multiple servers and refuses stale writes without losing the full list", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "derp-multi-service-"));
+  try {
+    const store = createPrivateStore(dir),
+      auth: any = { require: async () => ({}), can: () => true },
+      service = createDerpService({ store, auth });
+    await store.write("derp-status.json", {
+      schema: 1,
+      active: { revision: "base", settings: null },
+      failed: null,
+      updatedAt: "now",
+    });
+    const request = new Request("https://hs.example.com"),
+      servers = [{ address: "one.example.com" }, { address: "two.example.com" }];
+    const result = await service.save(
+      request,
+      "initial",
+      { officialEnabled: false, customEnabled: true, servers },
+      false,
+    );
+    expect(result.settings.servers).toHaveLength(2);
