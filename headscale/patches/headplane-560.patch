+  } catch (error) {
+    if (error instanceof NetworkSettingsError) return data({ error: error.message }, error.status);
+    throw error;
+  }
+}
+export default function Page({ loaderData: { view, writable } }: Route.ComponentProps) {
+  const [settings, setSettings] = useState(view.settings),
+    [servers, setServers] = useState(view.settings.nameservers.join("\n"));
