+++ b/app/routes/enrollment/command-form.tsx
@@ -0,0 +1,426 @@
+import { RotateCcw, CheckCheck, FileKey2, Save, TerminalSquare } from "lucide-react";
+import { motion } from "motion/react";
+import { useEffect, useRef, useState } from "react";
+import { useFetcher } from "react-router";
+
+import Button from "~/components/button";
+import CodeBlock from "~/components/code-block";
+import Input from "~/components/input";
+import Link from "~/components/link";
+import Notice from "~/components/notice";
+import Select from "~/components/select";
+import Switch from "~/components/switch";
+import type { EnrollmentCommandView, EnrollmentKeyView } from "~/server/enrollment/service";
+import type { User } from "~/types";
+import {
+  DEFAULT_ENROLLMENT_OPTIONS,
+  DEFAULT_KEY_DAYS,
+  parseNetworkList,
+  validateEnrollmentOptions,
+} from "~/utils/enrollment-command";
+import {
+  readEnrollmentDefaults,
+  saveEnrollmentDefaults,
+  clearEnrollmentDefaults,
+  type EnrollmentDefaults,
+} from "~/utils/enrollment-defaults";
+import { getUserDisplayName } from "~/utils/user";
+
+import {
+  type Attempt,
+  keyIsSelectable,
+  prepareAttempt,
+  previewCommand,
+  resolveSavedCommand,
+  suggestAdvertiseRoutes,
+} from "./form-state";
+import OptionsFields from "./options-fields";
+
+export interface CommandFormProps {
+  users: User[];
+  keys: EnrollmentKeyView[];
+  commands: EnrollmentCommandView[];
+  url: string;
+  selfServiceOnly: boolean;
+  editing?: EnrollmentCommandView;
+  initialUserId?: string;
+  inSheet?: boolean;
+  preferenceScope?: string;
+  onFinished: () => void;
+}
+export default function CommandForm({
+  users,
+  keys,
+  commands,
+  url,
+  selfServiceOnly,
+  editing,
+  initialUserId,
+  inSheet = false,
+  preferenceScope,
+  onFinished,
+}: CommandFormProps) {
+  const fetcher = useFetcher();
+  const busy = useRef(false);
+  const attempt = useRef<Attempt | null>(null);
+  const [name, setName] = useState(editing?.name ?? "");
+  const [autoKey, setAutoKey] = useState(!editing);
+  const [userId, setUserId] = useState<string | null>(
+    users.find((user) => user.id === initialUserId)?.id ?? users[0]?.id ?? null,
+  );
+  const [tagOnly, setTagOnly] = useState(false);
+  const [keyTags, setKeyTags] = useState("");
+  const [expiry, setExpiry] = useState(String(DEFAULT_KEY_DAYS));
+  const [keyId, setKeyId] = useState<string | null>(editing?.keyId ?? null);
+  const [options, setOptions] = useState({ ...DEFAULT_ENROLLMENT_OPTIONS, ...editing?.options });
+  const [publishRoutes, setPublishRoutes] = useState(
+    Boolean(editing?.options.advertiseRoutes.length),
+  );
+  const [routes, setRoutes] = useState(options.advertiseRoutes.join(", "));
+  const [tags, setTags] = useState(options.advertiseTags.join(", "));
+  const [remembered, setRemembered] = useState(false);
+  const [memoryNote, setMemoryNote] = useState("");
+  const pendingDefaults = useRef<EnrollmentDefaults | null>(null);
+  const savedDefaults = useRef(false);
+  const applyDefaults = (value: EnrollmentDefaults | null) => {
+    const next = value?.options ?? { ...DEFAULT_ENROLLMENT_OPTIONS };
+    setAutoKey(value?.autoKey ?? true);
+    const explicit = users.find((user) => user.id === initialUserId)?.id;
+    setUserId(
+      explicit ?? users.find((user) => user.id === value?.userId)?.id ?? users[0]?.id ?? null,
+    );
+    setTagOnly(!explicit && !selfServiceOnly && (value?.tagOnly ?? false));
+    setKeyTags(selfServiceOnly ? "" : (value?.keyTags ?? ""));
+    setExpiry(value?.expiryDays ?? String(DEFAULT_KEY_DAYS));
+    setKeyId(null);
+    const options = selfServiceOnly ? { ...next, advertiseTags: [] } : next;
+    setOptions(options);
+    setPublishRoutes(Boolean(options.advertiseRoutes.length));
+    setRoutes(options.advertiseRoutes.join(", "));
+    setTags(options.advertiseTags.join(", "));
+  };
+  useEffect(() => {
+    if (editing || !preferenceScope) return;
+    try {
+      const previous = readEnrollmentDefaults(localStorage, preferenceScope);
+      if (previous) {
+        applyDefaults(previous);
+        setRemembered(true);
+      }
+    } catch {
+      /* Browser storage may be blocked; creating configurations still works. */
+    }
+  }, [preferenceScope, editing?.id]);
+  const resetDefaults = () => {
+    if (preferenceScope) {
+      try {
+        clearEnrollmentDefaults(localStorage, preferenceScope);
+      } catch {}
+    }
+    applyDefaults(null);
+    setRemembered(false);
+    setMemoryNote("已恢复默认选项；下次成功创建后将记住新的设置。");
+  };
+  useEffect(() => {
+    if (fetcher.state === "idle") busy.current = false;
+  }, [fetcher.state]);
+  let validated = options;
+  let preview = "";
+  let validation = "";
+  try {
+    validated = validateEnrollmentOptions({
+      ...options,
+      advertiseRoutes: publishRoutes ? parseNetworkList(routes) : [],
+      advertiseTags: tags
+        .split(",")
+        .map((tag) => tag.trim())
+        .filter(Boolean),
+    });
+    preview = previewCommand(url, validated);
+  } catch (error) {
+    validation = error instanceof Error ? error.message : "请检查客户端选项。";
+  }
+  const selectable = keys.filter(keyIsSelectable);
+  const result = fetcher.data;
+  const saved = resolveSavedCommand(result, commands);
+  useEffect(() => {
+    if (
+      !saved?.current ||
+      editing ||
+      !preferenceScope ||
+      !pendingDefaults.current ||
+      savedDefaults.current
+    )
+      return;
+    savedDefaults.current = true;
+    try {
+      setMemoryNote(
+        saveEnrollmentDefaults(localStorage, preferenceScope, pendingDefaults.current)
+          ? "已记住本次创建选项，下次新建会自动带入。"
+          : "浏览器未能保存选项记忆，本次接入配置已正常保存。",
+      );
+    } catch {
+      setMemoryNote("浏览器未能保存选项记忆，本次接入配置已正常保存。");
+    }
+  }, [saved?.current?.id, editing, preferenceScope]);
+  const pending = fetcher.state !== "idle";
+  const validOwner = tagOnly
+    ? /^tag:[a-zA-Z][a-zA-Z0-9_-]*(,\s*tag:[a-zA-Z][a-zA-Z0-9_-]*)*$/.test(keyTags.trim())
+    : Boolean(userId);
+  const canSubmit =
+    name.trim().length > 0 &&
+    name.trim().length <= 120 &&
+    !validation &&
+    (autoKey
+      ? validOwner && /^\d+$/.test(expiry) && Number(expiry) > 0
+      : selectable.some((key) => key.id === keyId));
+  return (
+    <section className={inSheet ? "min-w-0" : "surface min-w-0 p-5 sm:p-7"}>
+      <div className="mb-7 flex items-center gap-3">
+        <span className="surface-icon">
+          <TerminalSquare className="size-5" />
+        </span>
+        <div>
+          <h2 className="surface-title">{editing ? "编辑／重命名加入命令" : "新建加入命令"}</h2>
+          <p className="mt-1 text-xs text-mist-500">设置设备接入参数，保存后即可复制使用。</p>
+        </div>
+      </div>
+      {!editing && !saved && (
+        <div className="mb-5 flex items-center gap-3 rounded-lg border border-blue-100 bg-blue-50/60 p-3 dark:border-blue-900 dark:bg-blue-950/30">
+          <p className="flex-1 text-xs leading-relaxed text-mist-500">
+            {remembered
+              ? "已使用此浏览器上次成功创建的选项。"
+              : "成功创建后，会在此浏览器按账号记住选项。"}{" "}
+            命令名称、设备名称和认证密钥不会自动带入。
+          </p>
+          <Button onClick={resetDefaults} type="button">
+            <span className="inline-flex items-center gap-1 text-xs whitespace-nowrap">
+              <RotateCcw className="size-3.5" />
+              恢复默认
+            </span>
+          </Button>
+        </div>
+      )}
+      {memoryNote && (
+        <p role="status" className="mb-4 text-xs text-mist-500">
+          {memoryNote}
+        </p>
+      )}
+      {saved ? (
+        <motion.div
+          layout
+          initial={{ y: 4 }}
+          animate={{ y: 0 }}
+          aria-live="polite"
+          className="form-section"
+        >
+          <CheckCheck className="mb-3 size-6 text-emerald-500" />
+          <p className="mb-3 text-sm">
+            保存请求已完成。
+            {saved.current ? `当前记录「${saved.current.name}」以最新状态为准。` : ""}
+          </p>
+          {saved.current?.available && saved.current.command ? (
+            <CodeBlock>{saved.current.command}</CodeBlock>
+          ) : (
+            <p role="status">
+              当前命令不可用：
+              {saved.current?.unavailableReason ?? "记录已删除或不再可见，请以下方列表为准。"}
+            </p>
+          )}
+          <Button className="mt-4" onClick={onFinished}>
+            完成
+          </Button>
+        </motion.div>
+      ) : (
+        <fetcher.Form
+          method="post"
+          onSubmit={(event) => {
+            event.preventDefault();
+            if (busy.current || !canSubmit) return;
+            const form = new FormData();
+            form.set("action_id", "save_enrollment_command");
+            form.set("name", name.trim());
+            form.set("options", JSON.stringify(validated));
+            if (editing) form.set("command_id", editing.id);
+            if (autoKey) {
+              form.set("create_key", "true");
+              form.set("user_id", tagOnly ? "" : (userId ?? ""));
+              form.set("acl_tags", keyTags.trim());
+              form.set("expiry", expiry);
+              form.set("reusable", "true");
+              form.set("ephemeral", "false");
+            } else if (keyId) form.set("key_id", keyId);
+            attempt.current = prepareAttempt(attempt.current, JSON.stringify([...form.entries()]));
+            form.set("nonce", attempt.current.nonce);
+            if (!editing) {
+              pendingDefaults.current = {
+                schema: 1,
+                autoKey,
+                userId,
+                tagOnly,
+                keyTags,
+                expiryDays: expiry,
+                options: validated,
+              };
+              savedDefaults.current = false;
+            }
+            busy.current = true;
+            fetcher.submit(form, { method: "post" });
+          }}
+        >
+          <fieldset disabled={pending} className="flex flex-col gap-6">
+            <motion.div layout className="form-section grid gap-5 sm:grid-cols-2">
+              <h3 className="form-section-label mb-0! sm:col-span-2">
+                <FileKey2 className="size-4 text-indigo-500" />
+                名称与认证密钥
+              </h3>
+              <Input
+                className="sm:col-span-2"
+                required
+                label="命令名称"
+                value={name}
+                onChange={setName}
+                maxLength={120}
+                placeholder="例如 办公室子网路由"
+              />
+              {!editing && (
+                <div className="option-row sm:col-span-2">
+                  <div>
+                    <p className="font-medium">自动创建预认证密钥</p>
+                    <p className="text-sm text-mist-500">
+                      默认开启：可重复使用、999 天、非临时设备。只在保存时创建。
+                    </p>
+                  </div>
+                  <Switch
+                    label="自动创建预认证密钥"
+                    checked={autoKey}
+                    onCheckedChange={setAutoKey}
+                  />
+                </div>
+              )}
+              {autoKey ? (
+                <>
+                  {!selfServiceOnly && (
+                    <div className="option-row sm:col-span-2">
+                      <span>仅由 ACL 标签拥有</span>
+                      <Switch
+                        label="仅由 ACL 标签拥有"
+                        checked={tagOnly}
+                        onCheckedChange={setTagOnly}
+                      />
+                    </div>
+                  )}
+                  {!tagOnly && (
+                    <Select
+                      required
+                      aria-label="设备所有者"
+                      label="设备所有者"
+                      value={userId}
+                      onValueChange={setUserId}
+                      placeholder="选择用户"
+                      items={users.map((user) => ({
+                        value: user.id,
+                        label: getUserDisplayName(user),
+                      }))}
+                    />
+                  )}
+                  <Input
+                    required={tagOnly}
+                    label="密钥 ACL 标签"
+                    value={keyTags}
+                    onChange={setKeyTags}
+                    placeholder="tag:server, tag:office"
+                    description="使用 ACL 允许的完整标签，逗号分隔。仅标签模式必须填写。"
+                  />
+                  <Input
+                    required
+                    label="密钥有效期（天）"
+                    type="number"
+                    min={1}
+                    step={1}
+                    value={expiry}
+                    onChange={setExpiry}
+                  />
+                </>
+              ) : (
+                <Select
+                  required
+                  aria-label="已有预认证密钥"
+                  label="已有预认证密钥"
+                  value={keyId}
+                  onValueChange={setKeyId}
+                  placeholder="选择有效且完整可用的可重复使用密钥"
+                  items={[
+                    ...(editing && !selectable.some((key) => key.id === editing.keyId)
+                      ? [{ value: editing.keyId, label: "当前密钥不可用，请选择其他有效密钥" }]
+                      : []),
+                    ...selectable.map((key) => ({
+                      value: key.id,
+                      label: `${key.user ? getUserDisplayName(key.user) : "仅标签"} · #${key.id} · ${new Date(key.expiration).toLocaleDateString("zh-CN")}`,
+                    })),
+                  ]}
+                  description="一次性、过期及无法恢复完整值的密钥不用于可重复使用命令。"
+                />
+              )}
+            </motion.div>
+            <OptionsFields
+              options={options}
+              onChange={setOptions}
+              publishRoutes={publishRoutes}
+              onPublishRoutes={(enabled) => {
+                setPublishRoutes(enabled);
+                setRoutes((current) => suggestAdvertiseRoutes(current, enabled));
+              }}
+              routes={routes}
+              onRoutes={setRoutes}
+              tags={tags}
+              onTags={setTags}
+            />
+            <div aria-live="polite" className="form-section">
+              <h3 className="form-section-label">
+                <TerminalSquare className="size-4 text-indigo-500" />
+                实时预览（占位密钥）
+              </h3>
+              {validation ? (
+                <p role="alert" className="text-red-500">
+                  {validation}
+                </p>
+              ) : (
+                <pre className="rounded-xl border border-slate-700 bg-slate-950 p-4 font-mono text-[12px] leading-6 break-all whitespace-pre-wrap text-slate-200">
+                  {preview}
+                </pre>
+              )}
+              <p className="mt-2 text-xs text-mist-500">
+                预览中的 REPLACE_AFTER_SAVE 不可执行；保存后复制真实命令。预览和复制不会创建密钥。
+                若已有客户端要求补全旧参数，请保留客户端提示的完整参数，或明确启用重置选项。服务端无法得知每台客户端全部偏好。
+              </p>
+            </div>
+            {typeof result === "string" && (
+              <p role="alert" className="text-red-500">
+                {result} 可修改输入后重试；相同输入的重试不会重复创建密钥。
+              </p>
+            )}
+            <div className="flex flex-wrap gap-3 border-t border-mist-100 pt-5 dark:border-mist-800">
+              <Button type="submit" variant="heavy" disabled={!canSubmit || pending}>
+                <Save className="size-4" />
+                {pending ? "正在保存…" : editing ? "保存修改" : "保存并生成命令"}
+              </Button>
+              {editing && (
+                <Button type="button" onClick={onFinished}>
+                  取消编辑
+                </Button>
+              )}
+            </div>
+          </fieldset>
+        </fetcher.Form>
+      )}
+      <Notice title="网络配置提醒">
+        发布子网路由或作为出口节点时，客户端仍可能需要开启 IP
+        转发，且需在控制台批准路由。命令不会自动完成这些操作。请仅向可信设备提供完整命令和密钥。
+        <Link styled to="/machines">
+          前往设备管理批准路由
+        </Link>
+      </Notice>
+    </section>
+  );
+}
diff --git a/app/routes/enrollment/data.ts b/app/routes/enrollment/data.ts
new file mode 100644
index 0000000..a811a0a
--- /dev/null
+++ b/app/routes/enrollment/data.ts
@@ -0,0 +1,75 @@
+import { createHash } from "node:crypto";
+
+import { redirect } from "react-router";
+
+import {
+  appConfigContext,
+  authContext,
+  enrollmentContext,
+  requestApiContext,
+} from "~/server/context";
+import { isUserPrincipal } from "~/server/web/auth";
+import { Capabilities } from "~/server/web/roles";
+import type { User } from "~/types/User";
+
+import { authKeysAction } from "../settings/auth-keys/actions";
+import type { Route } from "./+types/overview";
+export async function loader({ request, context }: Route.LoaderArgs) {
+  const auth = context.get(authContext);
+  const config = context.get(appConfigContext);
+  const getRequestApi = context.get(requestApiContext);
+  const enrollment = context.get(enrollmentContext);
+  const session = await getRequestApi(request).catch(() => {
+    throw redirect("/login");
+  });
+  const { principal } = session;
+  const result = enrollment
+    ? await enrollment.listKeys(request)
+    : { users: [] as User[], keys: [], missing: [] };
+  const users = result.users;
+  const groups = new Map<string | null, { user: User | null; preAuthKeys: typeof result.keys }>();
+  for (const key of result.keys) {
+    const id = key.user?.id ?? null;
+    const group = groups.get(id) ?? { user: key.user, preAuthKeys: [] };
+    group.preAuthKeys.push(key);
+    groups.set(id, group);
+  }
+  const keys = [...groups.values()];
+  const missing = result.missing as { user: User; error: unknown }[];
+  const commands = enrollment ? await enrollment.listCommands(request) : [];
+
+  const canGenerateAny = auth.can(principal, Capabilities.generate_authkeys);
+  const canGenerateOwn = auth.can(principal, Capabilities.generate_own_authkeys);
+
+  return {
+    preferenceScope: createHash("sha256")
+      .update(
+        JSON.stringify([
+          config.headscale.public_url ?? config.headscale.url,
+          isUserPrincipal(principal)
+            ? "user:" + principal.user.id
+            : "api:" + createHash("sha256").update(principal.apiKey).digest("hex"),
+        ]),
+      )
+      .digest("hex"),
+    access: Boolean(enrollment) && (canGenerateAny || canGenerateOwn),
+    commands,
+    enrollmentAvailable: Boolean(enrollment),
+    currentHeadscaleUserId: isUserPrincipal(principal) ? principal.user.headscaleUserId : undefined,
+    currentSubject: isUserPrincipal(principal) ? principal.user.subject : undefined,
+    keys,
+    missing,
+    selfServiceOnly: !canGenerateAny && canGenerateOwn,
+    url: config.headscale.public_url ?? config.headscale.url,
+    users,
+  };
+}
+
+export async function action(args: Route.ActionArgs) {
+  await args.context
+    .get(requestApiContext)(args.request)
+    .catch(() => {
+      throw redirect("/login");
+    });
+  return authKeysAction(args);
+}
diff --git a/app/routes/enrollment/form-state.ts b/app/routes/enrollment/form-state.ts
