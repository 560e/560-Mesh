diff --git a/app/routes/auth/login/local-action.ts b/app/routes/auth/login/local-action.ts
new file mode 100644
index 0000000..89f4da3
--- /dev/null
+++ b/app/routes/auth/login/local-action.ts
@@ -0,0 +1,24 @@
+import { data, redirect } from "react-router";
+import { authContext, localAuthContext } from "~/server/context";
+import type { Route } from "./+types/page";
+
+export async function localLoginAction({ request, context }: Route.ActionArgs) {
+  const auth = context.get(authContext);
+  const local = context.get(localAuthContext);
+  // The proxy also enforces 16 KiB; reject oversized declared payloads early.
+  if (Number(request.headers.get("content-length") ?? 0) > 16384) {
+    return data({ success: false as const, message: "登录请求过大。" }, { status: 413 });
+  }
+  const form = await request.formData();
+  const username = String(form.get("username") ?? "");
+  const password = String(form.get("password") ?? "");
+  const result = await local.login(username, password, auth.getRequestClientAddress(request));
+  if (result.ok) return redirect("/machines", { headers: { "Set-Cookie": result.cookie } });
+  if (result.reason === "not_configured") {
+    return data({ success: false as const, message: "管理员登录尚未初始化，请联系运维人员。" }, { status: 503 });
+  }
+  if (result.reason === "throttled") {
+    return data({ success: false as const, message: "登录尝试过于频繁，请稍后重试。" }, { status: 429, headers: { "Retry-After": "60" } });
+  }
+  return data({ success: false as const, message: "账号或密码错误，或账号暂时被锁定，请稍后重试。" }, { status: 401 });
+}
