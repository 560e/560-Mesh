diff --git a/app/routes/settings/site.tsx b/app/routes/settings/site.tsx
new file mode 100644
index 0000000..7419b3c
--- /dev/null
+++ b/app/routes/settings/site.tsx
@@ -0,0 +1,111 @@
+import { Palette, Save, RotateCcw } from "lucide-react";
+import { useEffect, useState } from "react";
+import { data, useFetcher } from "react-router";
+
+import Button from "~/components/button";
+import Input from "~/components/input";
+import PageError from "~/components/page-error";
+import { siteContext, authContext } from "~/server/context";
+import { NetworkSettingsError } from "~/server/network/error";
+import { Capabilities } from "~/server/web/roles";
+import { DEFAULT_SITE_TITLE } from "~/utils/site-settings";
+
+import type { Route } from "./+types/site";
+export async function loader({ request, context }: Route.LoaderArgs) {
+  const auth = context.get(authContext),
+    principal = await auth.require(request);
+  return {
+    view: await context.get(siteContext).view(request),
+    writable: auth.can(principal, Capabilities.write_feature),
+  };
+}
+export async function action({ request, context }: Route.ActionArgs) {
+  try {
+    const form = await request.clone().formData();
+    if (form.get("action_id") !== "site_save")
+      throw new NetworkSettingsError("未知的站点设置操作。");
+    const view = await context
+      .get(siteContext)
+      .save(request, String(form.get("token") ?? ""), form.get("title"));
+    return { view, message: "站点标题已保存，刷新公开首页即可看到。" };
+  } catch (error) {
+    if (error instanceof NetworkSettingsError) return data({ error: error.message }, error.status);
+    throw error;
+  }
+}
+export default function SitePage({ loaderData: { view, writable } }: Route.ComponentProps) {
+  const [title, setTitle] = useState(view.title),
+    fetcher = useFetcher<typeof action>();
+  useEffect(() => setTitle(view.title), [view.token]);
+  const pending = fetcher.state !== "idle";
+  return (
+    <section className="surface p-5 sm:p-6">
+      <div className="mb-6 flex items-center gap-3">
+        <span className="surface-icon">
+          <Palette className="size-5" />
+        </span>
+        <div>
+          <h2 className="surface-title">站点外观</h2>
+          <p className="mt-1 text-xs text-mist-500">设置公开首页展示的站点名称。</p>
+        </div>
+      </div>
+      <fetcher.Form method="post" className="max-w-xl space-y-5">
+        <input type="hidden" name="action_id" value="site_save" />
+        <input type="hidden" name="token" value={view.token} />
+        <fieldset disabled={!writable || pending} className="space-y-5">
+          <Input
+            label="站点标题"
+            name="title"
+            value={title}
+            onChange={setTitle}
+            required
+            maxLength={128}
+            placeholder={DEFAULT_SITE_TITLE}
+            description="显示在公开首页左上角和浏览器标签页，最多 64 个字符。请填写适合对外展示的名称。"
+          />
+          <div className="rounded-xl border border-mist-200 bg-slate-50 p-5 dark:border-mist-800 dark:bg-slate-950">
+            <p className="mb-3 text-[11px] text-mist-400">展示预览</p>
+            <p className="text-lg font-semibold break-all text-mist-900 dark:text-white">
+              {title.trim() || DEFAULT_SITE_TITLE}
+            </p>
+            <p className="mt-2 text-xs break-all text-mist-500">
+              {title.trim() || DEFAULT_SITE_TITLE} · 客户端下载
+            </p>
+          </div>
+          <div className="flex flex-wrap gap-3">
+            <Button type="submit" variant="heavy">
+              <span className="inline-flex items-center gap-2">
+                <Save className="size-4" />
+                {pending ? "正在保存…" : "保存站点设置"}
+              </span>
+            </Button>
+            <Button type="button" onClick={() => setTitle(DEFAULT_SITE_TITLE)}>
+              <span className="inline-flex items-center gap-2">
+                <RotateCcw className="size-4" />
+                恢复默认标题
+              </span>
+            </Button>
+          </div>
+        </fieldset>
+        {fetcher.data && "error" in fetcher.data && (
+          <p role="alert" className="text-sm text-red-600">
+            {fetcher.data.error}
+          </p>
+        )}
+        {fetcher.data && "message" in fetcher.data && (
+          <p role="status" className="text-sm text-emerald-600">
+            {fetcher.data.message}
+          </p>
+        )}
+        {!writable && (
+          <p role="status" className="text-sm text-amber-600">
+            当前账号只有查看权限。
+          </p>
+        )}
+      </fetcher.Form>
+    </section>
+  );
+}
+export function ErrorBoundary({ error }: Route.ErrorBoundaryProps) {
+  return <PageError error={error} page="站点外观" />;
+}
