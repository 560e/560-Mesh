@@ -0,0 +1,201 @@
+import { FileKey2, TerminalSquare, Plus } from "lucide-react";
+import { useState } from "react";
+import { useSearchParams } from "react-router";
+
+import Button from "~/components/button";
+import Input from "~/components/input";
+import Notice from "~/components/notice";
+import PageError from "~/components/page-error";
+import Sheet from "~/components/sheet";
+import type { EnrollmentCommandView } from "~/server/enrollment/service";
+
+import type { Route } from "./+types/overview";
+import CommandCard from "./command-card";
+import CommandForm from "./command-form";
+import KeysPanel from "./keys-panel";
+export { action, loader } from "./data";
+export default function Page({ loaderData }: Route.ComponentProps) {
+  const { access, enrollmentAvailable, keys, users, url, commands, selfServiceOnly } = loaderData;
+  const [params, setParams] = useSearchParams();
+  const tab = params.get("tab") === "keys" ? "keys" : "commands";
+  const [editing, setEditing] = useState<EnrollmentCommandView>();
+  const [attempt, setAttempt] = useState(0);
+  const [query, setQuery] = useState("");
+  const [open, setOpen] = useState(params.get("create") === "1" && access);
+  const setDrawer = (next: boolean) => {
+    setOpen(next);
+    if (!next) {
+      setEditing(undefined);
+      setParams(
+        (previous) => {
+          const p = new URLSearchParams(previous);
+          p.delete("create");
+          p.delete("user");
+          return p;
+        },
+        { replace: true },
+      );
+    }
+  };
+  const start = () => {
+    setEditing(undefined);
+    setAttempt((v) => v + 1);
+    setOpen(true);
+  };
+  const visible = commands.filter((c) => c.name.toLowerCase().includes(query.trim().toLowerCase()));
+  return (
+    <div className="flex flex-col gap-6">
+      <div className="page-heading mb-0!">
+        <div>
+          <p className="page-eyebrow">
+            <TerminalSquare className="size-3.5" />
+            连接你的设备
+          </p>
+          <h1 className="page-title">设备接入</h1>
+          <p className="page-description">创建一次，随时复制。加入命令与预认证密钥集中管理。</p>
+        </div>
+        {access && tab === "commands" && (
+          <Button variant="heavy" onClick={start}>
+            <span className="inline-flex items-center gap-2">
+              <Plus className="size-4" />
+              新建接入配置
+            </span>
+          </Button>
+        )}
+      </div>
+      <div className="access-tabs" role="tablist" aria-label="设备接入">
+        {[
+          { id: "commands", label: "接入配置", icon: TerminalSquare, count: commands.length },
+          {
+            id: "keys",
+            label: "全部密钥",
+            icon: FileKey2,
+            count: keys.reduce((n, g) => n + g.preAuthKeys.length, 0),
+          },
+        ].map((item) => (
+          <button
+            key={item.id}
+            type="button"
+            role="tab"
+            id={"access-tab-" + item.id}
+            aria-controls={"access-panel-" + item.id}
+            aria-selected={tab === item.id}
+            tabIndex={tab === item.id ? 0 : -1}
+            onKeyDown={(event) => {
+              if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
+              event.preventDefault();
+              const nextTab =
+                event.key === "Home"
+                  ? "commands"
+                  : event.key === "End"
+                    ? "keys"
+                    : tab === "commands"
+                      ? "keys"
+                      : "commands";
+              setParams((previous) => {
+                const next = new URLSearchParams(previous);
+                next.set("tab", nextTab);
+                return next;
+              });
+              document.getElementById("access-tab-" + nextTab)?.focus();
+            }}
+            className="access-tab"
+            onClick={() =>
+              setParams((p) => {
+                const next = new URLSearchParams(p);
+                next.set("tab", item.id);
+                return next;
+              })
+            }
+          >
+            <item.icon className="size-4" />
+            {item.label}
+            <span className="device-count">{item.count}</span>
+          </button>
+        ))}
+      </div>
+      {!enrollmentAvailable ? (
+        <Notice title="设备接入服务不可用" variant="warning">
+          请管理员配置服务器 API 密钥后再使用此功能。
+        </Notice>
+      ) : !access ? (
+        <Notice title="权限受限" variant="warning">
+          您无权管理加入命令或密钥，请联系管理员申请权限。
+        </Notice>
+      ) : tab === "keys" ? (
+        <div role="tabpanel" id="access-panel-keys" aria-labelledby="access-tab-keys">
+          <KeysPanel loaderData={loaderData} />
+        </div>
+      ) : (
+        <div role="tabpanel" id="access-panel-commands" aria-labelledby="access-tab-commands">
+          <div className="mb-5 flex items-center justify-between gap-4">
+            <div className="w-full max-w-sm">
+              <Input
+                label="搜索接入配置"
+                labelHidden
+                value={query}
+                onChange={setQuery}
+                placeholder="搜索接入配置名称…"
+                maxLength={120}
+              />
+            </div>
+            <span className="shrink-0 text-xs text-mist-500">{visible.length} 个配置</span>
+          </div>
+          <div className="grid items-stretch gap-4 xl:grid-cols-2">
+            {!visible.length && (
+              <div className="empty-state xl:col-span-2">
+                <TerminalSquare className="mb-3 size-8 text-mist-400" />
+                <p className="text-sm font-semibold">
+                  {commands.length ? "没有符合条件的接入配置" : "还没有接入配置"}
+                </p>
+                <p className="mt-2 text-xs text-mist-500">
+                  保存带客户端选项的命令，之后可以随时复制与复用。
+                </p>
+                {!commands.length && (
+                  <Button className="mt-5" onClick={start}>
+                    创建第一个配置
+                  </Button>
+                )}
+              </div>
+            )}
+            {visible.map((command) => (
+              <CommandCard
+                key={command.id}
+                command={command}
+                onEdit={() => {
+                  setEditing(command);
+                  setAttempt((v) => v + 1);
+                  setOpen(true);
+                }}
+              />
+            ))}
+          </div>
+        </div>
+      )}
+      {access && (
+        <Sheet
+          open={open}
+          onOpenChange={setDrawer}
+          title={editing ? "编辑接入配置" : "新建设备接入配置"}
+        >
+          <CommandForm
+            key={`${editing?.id ?? "new"}-${attempt}`}
+            users={users}
+            commands={commands}
+            keys={keys.flatMap((g) => g.preAuthKeys)}
+            url={url}
+            selfServiceOnly={selfServiceOnly}
+            editing={editing}
+            initialUserId={params.get("user") ?? undefined}
+            preferenceScope={loaderData.preferenceScope}
+            inSheet
+            onFinished={() => setDrawer(false)}
+          />
+        </Sheet>
+      )}
+    </div>
+  );
+}
+export function ErrorBoundary({ error }: Route.ErrorBoundaryProps) {
+  return <PageError error={error} page="设备接入" />;
+}
