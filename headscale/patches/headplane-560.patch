diff --git a/tests/unit/runtime/platform-prefix.test.ts b/tests/unit/runtime/platform-prefix.test.ts
new file mode 100644
index 0000000..f5e7dee
--- /dev/null
+++ b/tests/unit/runtime/platform-prefix.test.ts
@@ -0,0 +1,51 @@
+import { createServer } from "node:http";
+import { afterEach, describe, expect, test } from "vitest";
+import { composeListener } from "../../../runtime/http";
+import { getPlatformPrefix } from "../../../runtime/platform-prefix";
+
+describe("platform management prefix", () => {
+  test("uses the deployment path when no override is supplied", () => {
+    expect(getPlatformPrefix()).toBe("/adminis");
+  });
+  test.each(["/admin", "/", "/adminis/", "/adminis?x=1", "//example.com", "/other"])(
+    "rejects an override that would disagree with deployment routing: %s", (value) => {
+      expect(() => getPlatformPrefix(value)).toThrow();
+    },
+  );
+});
+
+const servers: ReturnType<typeof createServer>[] = [];
+afterEach(async () => {
+  await Promise.all(servers.splice(0).map((server) => new Promise<void>((done) => {
+    server.closeAllConnections();
+    server.close(() => done());
+  })));
+});
+
+async function serve() {
+  const server = createServer(composeListener({
+    basename: "/adminis",
+    requestListener: (_req, res) => { res.end("management handler"); },
+  }));
+  servers.push(server);
+  await new Promise<void>((done) => server.listen(0, "127.0.0.1", done));
+  const address = server.address();
+  if (!address || typeof address === "string") throw new Error("No bound port");
+  return `http://127.0.0.1:${address.port}`;
+}
+
+test.each(["/admin", "/admin/login", "/adminis-other", "/", "/%61dmin/login"])(
+  "does not send paths outside the management boundary to the app: %s", async (path) => {
+    const base = await serve();
+    const response = await fetch(`${base}${path}`, { redirect: "manual" });
+    expect(response.status).toBe(404);
+    expect(response.headers.get("location")).toBeNull();
+  },
+);
+test("canonicalizes only the new management entry and preserves the query", async () => {
+  const base = await serve();
+  const response = await fetch(`${base}/adminis?next=machines`, { redirect: "manual" });
+  expect(response.status).toBe(302);
+  expect(response.headers.get("location")).toBe("/adminis/?next=machines");
+  expect(await (await fetch(`${base}/adminis/login`)).text()).toBe("management handler");
+});
