@@ -0,0 +1,40 @@
+import type { User } from "~/types";
+
+import type { PopulatedNode } from "./node-info";
+import { getUserDisplayName } from "./user";
+export type DeviceView = "list" | "cards";
+export function readDeviceView(value: string | null): DeviceView {
+  return value === "cards" ? "cards" : "list";
+}
+export interface DeviceGroup {
+  id: string;
+  label: string;
+  user?: User;
+  nodes: PopulatedNode[];
+  online: number;
+}
+export function groupDevices(nodes: readonly PopulatedNode[]): DeviceGroup[] {
+  const groups = new Map<string, DeviceGroup>();
+  for (const node of nodes) {
+    const tagged = (node.tags?.length ?? 0) > 0;
+    const id = tagged ? "tags" : node.user ? "user:" + node.user.id : "unowned";
+    let group = groups.get(id);
+    if (!group) {
+      group = {
+        id,
+        label: tagged ? "标签设备" : node.user ? getUserDisplayName(node.user) : "未归属设备",
+        user: tagged ? undefined : (node.user ?? undefined),
+        nodes: [],
+        online: 0,
+      };
+      groups.set(id, group);
+    }
+    group.nodes.push(node);
+    if (node.online && !node.expired) group.online++;
+  }
+  return [...groups.values()].sort((a, b) => {
+    if (a.user && !b.user) return -1;
+    if (!a.user && b.user) return 1;
+    return a.label.localeCompare(b.label, "zh-CN", { numeric: true }) || a.id.localeCompare(b.id);
+  });
+}
diff --git a/app/utils/dns-config.ts b/app/utils/dns-config.ts
new file mode 100644
index 0000000..a121123
--- /dev/null
+++ b/app/utils/dns-config.ts
@@ -0,0 +1,54 @@
+export interface DnsSettings {
+  magicDNS: boolean;
+  baseDomain: string;
+  nameservers: string[];
+  overrideLocalDNS: boolean;
+}
+const domainPattern =
+  /^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/i;
+function resolver(value: unknown): string {
+  if (typeof value !== "string" || value.length > 2048) throw new Error("DNS 服务器地址无效。");
+  const s = value.trim();
+  if (
+    s.split(".").length === 4 &&
+    s.split(".").every((p) => /^(0|[1-9][0-9]{0,2})$/.test(p) && Number(p) <= 255)
+  )
+    return s;
+  if (s.includes(":") && /^[0-9a-fA-F:.]+$/.test(s)) {
+    try {
+      new URL("https://[" + s + "]/");
+      return s;
+    } catch {}
+  }
+  try {
+    const u = new URL(s);
+    if (u.protocol === "https:" && u.hostname && !u.username && !u.password && !u.hash)
+      return u.href;
+  } catch {}
+  throw new Error("DNS 服务器须为有效 IP 地址或 HTTPS DoH 地址。");
+}
+export function normalizeDnsSettings(input: unknown, publicUrl?: string): DnsSettings {
+  if (!input || typeof input !== "object" || Array.isArray(input))
+    throw new Error("DNS 设置格式无效。");
+  const v = input as Record<string, unknown>;
+  if (
+    typeof v.magicDNS !== "boolean" ||
+    typeof v.baseDomain !== "string" ||
+    !Array.isArray(v.nameservers) ||
+    v.nameservers.length > 16 ||
+    typeof v.overrideLocalDNS !== "boolean"
+  )
+    throw new Error("DNS 设置格式无效。");
+  const baseDomain = v.baseDomain.trim().toLowerCase();
+  if ((baseDomain && !domainPattern.test(baseDomain)) || (v.magicDNS && !baseDomain))
+    throw new Error("启用 MagicDNS 后，必须填写有效的内部域名（base_domain）。");
+  if (v.magicDNS && publicUrl) {
+    const host = new URL(publicUrl).hostname.toLowerCase();
+    if (host === baseDomain || host.endsWith("." + baseDomain))
+      throw new Error("内部域名不能与公开域名相同，也不能是公开域名的上级域名。");
+  }
+  const nameservers = [...new Set(v.nameservers.map(resolver))];
+  if (v.overrideLocalDNS && !nameservers.length)
+    throw new Error("覆盖客户端 DNS 前，请至少填写一个 DNS 服务器。");
+  return { magicDNS: v.magicDNS, baseDomain, nameservers, overrideLocalDNS: v.overrideLocalDNS };
+}
diff --git a/app/utils/enrollment-command.ts b/app/utils/enrollment-command.ts
new file mode 100644
index 0000000..fc96881
--- /dev/null
+++ b/app/utils/enrollment-command.ts
@@ -0,0 +1,208 @@
+import type { EnrollmentOptions } from "~/types/Enrollment";
+
+export const DEFAULT_KEY_DAYS = 999;
+
+export const DEFAULT_ENROLLMENT_OPTIONS: EnrollmentOptions = {
+  acceptDns: false,
+  acceptRoutes: false,
+  advertiseRoutes: [],
+  advertiseExitNode: false,
+  exitNode: "",
+  exitNodeAllowLanAccess: false,
+  hostname: "",
+  advertiseTags: [],
+  ssh: false,
+  shieldsUp: false,
+  unattended: false,
+  reset: false,
+  forceReauth: false,
+};
+Object.freeze(DEFAULT_ENROLLMENT_OPTIONS.advertiseRoutes);
+Object.freeze(DEFAULT_ENROLLMENT_OPTIONS.advertiseTags);
+Object.freeze(DEFAULT_ENROLLMENT_OPTIONS);
+
+function isIPv4(address: string): boolean {
+  const parts = address.split(".");
+  return (
+    parts.length === 4 &&
+    parts.every((part) => /^(0|[1-9][0-9]{0,2})$/.test(part) && Number(part) <= 255)
+  );
+}
+
+function isIPv6(address: string): boolean {
+  if (!address.includes(":") || !/^[0-9a-fA-F:.]+$/.test(address)) {
+    return false;
+  }
+  try {
+    // WHATWG URL validates IPv6 in browsers as well as the server runtime.
+    return new URL(`https://[${address}]/`).hostname.startsWith("[");
+  } catch {
+    return false;
+  }
+}
+
+function isDnsName(value: string): boolean {
+  return (
+    value.length <= 253 &&
+    value
+      .split(".")
+      .every(
+        (label) => label.length <= 63 && /^[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$/.test(label),
+      )
+  );
+}
+
+function isHost(value: string): boolean {
+  return isIPv4(value) || isIPv6(value) || (!/^[0-9.]+$/.test(value) && isDnsName(value));
+}
+
+function addressBits(address: string, width: number): string {
+  if (width === 32) {
+    return address
+      .split(".")
+      .map((part) => Number(part).toString(2).padStart(8, "0"))
+      .join("");
+  }
+  // URL canonicalizes mapped IPv4 tails into hexadecimal IPv6 groups.
+  const canonical = new URL(`https://[${address}]/`).hostname.slice(1, -1);
+  const [left, right] = canonical.split("::");
+  const first = left ? left.split(":") : [];
+  const last = right ? right.split(":") : [];
+  const groups =
+    right === undefined
+      ? first
+      : [...first, ...Array.from({ length: 8 - first.length - last.length }, () => "0"), ...last];
+  return groups.map((part) => Number.parseInt(part, 16).toString(2).padStart(16, "0")).join("");
+}
+
+function validateNetwork(route: string): string {
+  const parts = route.split("/");
+  if (parts.length !== 2 || !/^(0|[1-9][0-9]{0,2})$/.test(parts[1])) {
+    throw new Error("子网路由必须填写有效的 IPv4 或 IPv6 CIDR 网络");
+  }
+  const [address, prefix] = parts;
+  const limit = isIPv4(address) ? 32 : isIPv6(address) ? 128 : -1;
+  if (Number(prefix) > limit) {
+    throw new Error("子网路由地址或网络前缀无效");
+  }
+  if (addressBits(address, limit).slice(Number(prefix)).includes("1")) {
+    throw new Error("子网路由必须填写网络地址，主机位必须全部为零");
+  }
+  if (Number(prefix) === 0) {
+    throw new Error("发布默认路由请勾选“作为出口节点”，不要在子网路由中填写默认路由");
+  }
+  return route;
+}
+
+export function parseNetworkList(input: string): string[] {
+  if (typeof input !== "string") {
+    throw new Error("子网路由列表格式无效");
+  }
+  return [
+    ...new Set(
+      input
+        .split(/[,\s]+/)
+        .filter(Boolean)
+        .map(validateNetwork),
+    ),
+  ];
+}
+
+export function validateServerUrl(input: string): string {
+  const match =
+    typeof input === "string"
+      ? /^https:\/\/(\[[0-9a-fA-F:.]+\]|[a-zA-Z0-9.-]+)(?::([0-9]+))?\/?$/i.exec(input)
+      : null;
+  if (!match || !isHost(match[1].replace(/^\[|\]$/g, ""))) {
+    throw new Error("服务器地址必须是有效的 HTTPS 公开地址，且不能包含路径、凭据或查询参数");
+  }
+  if (match[2] && (Number(match[2]) < 1 || Number(match[2]) > 65535)) {
+    throw new Error("服务器地址端口无效");
+  }
+  try {
+    return new URL(input).origin;
+  } catch {
+    throw new Error("服务器地址无效");
+  }
+}
+
+export function validateEnrollmentOptions(input: unknown): EnrollmentOptions {
+  if (
+    typeof input !== "object" ||
+    input === null ||
+    Array.isArray(input) ||
+    ![Object.prototype, null].includes(Object.getPrototypeOf(input))
+  ) {
+    throw new Error("加入选项格式无效");
+  }
+  const supplied = input as Record<string, unknown>;
+  for (const name of Object.keys(supplied)) {
+    if (!Object.hasOwn(DEFAULT_ENROLLMENT_OPTIONS, name)) {
+      throw new Error("加入选项包含不支持的字段");
+    }
+    const value = supplied[name];
+    const expected = DEFAULT_ENROLLMENT_OPTIONS[name as keyof EnrollmentOptions];
+    if (Array.isArray(expected)) {
+      if (!Array.isArray(value) || !Array.from(value).every((item) => typeof item === "string")) {
+        throw new Error("加入选项的网络或标签列表格式无效");
+      }
+    } else if (typeof value !== typeof expected) {
+      throw new Error("加入选项的开关或文本格式无效");
+    }
+  }
+  const options: EnrollmentOptions = { ...DEFAULT_ENROLLMENT_OPTIONS, ...supplied };
+  options.advertiseRoutes = [...new Set(options.advertiseRoutes.map(validateNetwork))];
+  options.advertiseTags = [...new Set(options.advertiseTags)];
+  if (
+    options.hostname &&
+    (options.hostname.length > 63 ||
+      !/^[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$/.test(options.hostname))
+  ) {
+    throw new Error("设备名只能包含字母、数字和连字符，长度不能超过 63 个字符");
+  }
+  if (options.advertiseTags.some((tag) => !/^tag:[a-z][a-z0-9-]*$/.test(tag))) {
+    throw new Error("ACL 标签必须以 tag: 开头，名称只能包含小写字母、数字和连字符");
+  }
+  if (options.exitNode && !isHost(options.exitNode)) {
+    throw new Error("出口节点必须填写有效的 IP 地址或设备 DNS 名称");
+  }
+  if (options.advertiseExitNode && options.exitNode) {
+    throw new Error("不能同时作为出口节点并使用其他出口节点");
+  }
+  if (options.exitNodeAllowLanAccess && !options.exitNode) {
+    throw new Error("允许访问本地网络前必须先选择出口节点");
+  }
+  return options;
+}
+
+export function buildEnrollmentCommand(
+  serverUrl: string,
+  key: string,
+  options: EnrollmentOptions,
+): string {
+  const server = validateServerUrl(serverUrl);
+  if (typeof key !== "string" || !/^(?:[a-fA-F0-9]+|hskey-auth-[a-zA-Z0-9_-]+)$/.test(key)) {
+    throw new Error("预认证密钥格式无效，请使用完整密钥");
+  }
+  const value = validateEnrollmentOptions(options);
+  const args = [
+    "tailscale up",
+    `--login-server=${server.includes("[") ? `"${server}"` : server}`,
+    `--auth-key=${key}`,
+    `--accept-dns=${value.acceptDns}`,
+    `--accept-routes=${value.acceptRoutes}`,
+    `--advertise-exit-node=${value.advertiseExitNode}`,
+  ];
+  if (value.advertiseRoutes.length)
+    args.push(`--advertise-routes=${value.advertiseRoutes.join(",")}`);
+  if (value.exitNode) args.push(`--exit-node=${value.exitNode}`);
+  if (value.exitNodeAllowLanAccess) args.push("--exit-node-allow-lan-access");
+  if (value.hostname) args.push(`--hostname=${value.hostname}`);
+  if (value.advertiseTags.length) args.push(`--advertise-tags=${value.advertiseTags.join(",")}`);
+  if (value.ssh) args.push("--ssh");
+  if (value.shieldsUp) args.push("--shields-up");
+  if (value.unattended) args.push("--unattended");
+  if (value.reset) args.push("--reset");
+  if (value.forceReauth) args.push("--force-reauth");
+  return args.join(" ");
+}
diff --git a/app/utils/enrollment-defaults.ts b/app/utils/enrollment-defaults.ts
new file mode 100644
index 0000000..ac78352
--- /dev/null
+++ b/app/utils/enrollment-defaults.ts
@@ -0,0 +1,80 @@
+import type { EnrollmentOptions } from "~/types/Enrollment";
+
+import { validateEnrollmentOptions } from "./enrollment-command";
+export interface EnrollmentDefaults {
+  schema: 1;
+  autoKey: boolean;
+  userId: string | null;
+  tagOnly: boolean;
+  keyTags: string;
+  expiryDays: string;
+  options: EnrollmentOptions;
+}
+type PreferenceStorage = Pick<Storage, "getItem" | "setItem" | "removeItem">;
+const key = (scope: string) => "hs560:enrollment-defaults:v1:" + scope;
+function normalize(input: unknown): EnrollmentDefaults | null {
+  if (!input || typeof input !== "object") return null;
+  const v = input as Record<string, unknown>;
+  if (
+    v.schema !== 1 ||
+    typeof v.autoKey !== "boolean" ||
+    typeof v.tagOnly !== "boolean" ||
+    !(v.userId === null || (typeof v.userId === "string" && v.userId.length <= 256)) ||
+    typeof v.keyTags !== "string" ||
+    v.keyTags.length > 4096 ||
+    typeof v.expiryDays !== "string" ||
+    !/^\d+$/.test(v.expiryDays) ||
+    !Number.isSafeInteger(Number(v.expiryDays)) ||
+    Number(v.expiryDays) < 1 ||
+    !Number.isFinite(new Date(Date.now() + Number(v.expiryDays) * 86400000).getTime())
+  )
+    return null;
+  try {
+    const options = validateEnrollmentOptions(v.options);
+    // A new device must not accidentally inherit another device's identity.
+    return {
+      schema: 1,
+      autoKey: v.autoKey,
+      userId: v.userId,
+      tagOnly: v.tagOnly,
+      keyTags: v.keyTags,
+      expiryDays: v.expiryDays,
+      options: { ...options, hostname: "" },
+    };
+  } catch {
+    return null;
+  }
+}
+export function readEnrollmentDefaults(
+  storage: PreferenceStorage,
+  scope: string,
+): EnrollmentDefaults | null {
+  try {
+    const raw = storage.getItem(key(scope));
+    if (!raw || raw.length > 32768) return null;
+    return normalize(JSON.parse(raw));
+  } catch {
+    return null;
+  }
+}
+export function saveEnrollmentDefaults(
+  storage: PreferenceStorage,
+  scope: string,
+  input: unknown,
+): boolean {
+  const value = normalize(input);
+  if (!value) return false;
+  try {
+    const serialized = JSON.stringify(value);
+    if (serialized.length > 32768) return false;
+    storage.setItem(key(scope), serialized);
+    return true;
+  } catch {
+    return false;
+  }
+}
+export function clearEnrollmentDefaults(storage: PreferenceStorage, scope: string): void {
+  try {
+    storage.removeItem(key(scope));
+  } catch {}
