@@ -0,0 +1,61 @@
+import { randomUUID } from "node:crypto";
+import { lstat, mkdir, readFile, rename, unlink, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+export function createPrivateStore(directory: string) {
+  let tail: Promise<unknown> = Promise.resolve();
+  async function ready() {
+    await mkdir(directory, { recursive: true, mode: 0o700 });
+    const s = await lstat(directory);
+    if (!s.isDirectory() || s.isSymbolicLink()) throw new Error("网络设置目录必须是普通私有目录。");
+  }
+  function path(name: string) {
+    if (!/^[a-zA-Z0-9][a-zA-Z0-9_.-]*$/.test(name)) throw new Error("无效的设置文件名。");
+    return join(directory, name);
+  }
+  async function readText(name: string): Promise<string | null> {
+    await ready();
+    const p = path(name);
+    const s = await lstat(p).catch((e) => {
+      if (e.code === "ENOENT") return null;
+      throw e;
+    });
+    if (!s) return null;
+    if (!s.isFile() || s.isSymbolicLink() || s.size > 2 * 1024 * 1024)
+      throw new Error("网络设置文件无效或过大。");
+    return readFile(p, "utf8");
+  }
+  async function writeText(name: string, value: string) {
+    await ready();
+    const p = path(name),
+      temp = path(name + "." + randomUUID() + ".tmp");
+    try {
+      await writeFile(temp, value, { flag: "wx", mode: 0o600 });
+      await rename(temp, p);
+    } finally {
+      await unlink(temp).catch(() => {});
+    }
+  }
+  return {
+    directory,
+    readText,
+    writeText,
+    read: async (name: string): Promise<unknown> => {
+      const t = await readText(name);
+      return t === null ? null : JSON.parse(t);
+    },
+    write: async (name: string, value: unknown) =>
+      writeText(name, JSON.stringify(value, null, 2) + "\n"),
+    remove: async (name: string) => {
+      await ready();
+      await unlink(path(name)).catch((e) => {
+        if (e.code !== "ENOENT") throw e;
+      });
+    },
+    serial<T>(fn: () => Promise<T>): Promise<T> {
+      const current = tail.then(fn);
+      tail = current.catch(() => {});
+      return current;
+    },
+  };
+}
+export type PrivateStore = ReturnType<typeof createPrivateStore>;
