+import { Settings2 } from "lucide-react";
+import { motion } from "motion/react";
+
+import Input from "~/components/input";
+import Switch from "~/components/switch";
+import type { EnrollmentOptions } from "~/types/Enrollment";
+
+type BooleanOption = {
+  [K in keyof EnrollmentOptions]: EnrollmentOptions[K] extends boolean ? K : never;
+}[keyof EnrollmentOptions];
+const toggles: [BooleanOption, string, string][] = [
+  ["acceptDns", "接受 DNS", "默认关闭；勾选后使用控制服务器提供的 DNS 设置。"],
+  ["acceptRoutes", "接受子网路由", "允许使用其他设备发布且获批的路由。"],
+  ["advertiseExitNode", "作为出口节点", "向 Tailnet 发布本机作为出口节点。"],
+  ["exitNodeAllowLanAccess", "使用出口时允许访问本地网络", "需先填写出口节点地址。"],
+  ["ssh", "启用 Tailscale SSH", "仍受 ACL 策略和客户端支持限制。"],
+  ["shieldsUp", "阻止传入连接", "仅允许本机主动发起连接。"],
+  ["unattended", "无人值守", "在支持的客户端上保持后台连接。"],
+  [
+    "forceReauth",
+    "强制重新认证",
+    "默认关闭。添加 --force-reauth，切换控制服务器或需要重新登录时使用；会重新认证当前设备。",
+  ],
+  [
+    "reset",
+    "重置未指定的客户端偏好",
+    "默认关闭。启用 --reset 会将未指定的客户端偏好恢复默认值，请确认现有设置可以重置。",
+  ],
+];
+export default function OptionsFields({
+  options,
+  onChange,
+  publishRoutes,
+  onPublishRoutes,
+  routes,
+  onRoutes,
+  tags,
+  onTags,
+}: {
+  options: EnrollmentOptions;
+  onChange: (options: EnrollmentOptions) => void;
+  publishRoutes: boolean;
+  onPublishRoutes: (value: boolean) => void;
+  routes: string;
+  onRoutes: (value: string) => void;
+  tags: string;
+  onTags: (value: string) => void;
+}) {
+  return (
+    <fieldset className="form-section grid gap-4 sm:grid-cols-2">
+      <legend className="form-section-label px-2">
+        <Settings2 className="size-4 text-indigo-500" />
+        客户端选项
+      </legend>
+      <Input
+        label="设备名称"
+        value={options.hostname}
+        onChange={(hostname) => onChange({ ...options, hostname })}
+        placeholder="例如 office-router"
+      />
+      <div className="option-row">
+        <span className="text-sm font-medium">发布子网路由</span>
+        <Switch label="发布子网路由" checked={publishRoutes} onCheckedChange={onPublishRoutes} />
+      </div>
+      <Input
+        disabled={!publishRoutes}
+        label="子网路由网络列表"
+        value={routes}
+        onChange={onRoutes}
+        placeholder="192.168.0.0/24, fd00::/64"
+        description="逗号分隔的 CIDR 网络；请填写网络地址。"
+      />
+      <Input
+        label="出口节点地址"
+        value={options.exitNode}
+        onChange={(exitNode) =>
+          onChange({
+            ...options,
+            exitNode,
+            exitNodeAllowLanAccess: Boolean(exitNode) && options.exitNodeAllowLanAccess,
+          })
+        }
+        placeholder="IP 地址或设备 DNS 名称"
+        description="与“作为出口节点”互斥。"
+      />
+      <Input
+        label="设备 ACL 标签"
+        value={tags}
+        onChange={onTags}
+        placeholder="tag:server, tag:office"
+        description="必须使用 ACL 允许的 tag: 标签。"
+      />
+      {toggles.map(([name, label, description]) => (
+        <motion.div key={name} layout className="option-row">
+          <div>
+            <p className="text-sm font-medium">{label}</p>
+            <p className="text-xs text-mist-500">{description}</p>
+          </div>
+          <Switch
+            label={label}
+            checked={options[name]}
+            disabled={name === "exitNodeAllowLanAccess" && !options.exitNode}
+            onCheckedChange={(checked) => onChange({ ...options, [name]: checked })}
+          />
+        </motion.div>
+      ))}
+    </fieldset>
+  );
+}
