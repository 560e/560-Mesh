new file mode 100644
index 0000000..e9bc3d3
--- /dev/null
+++ b/app/server/network/derp.ts
@@ -0,0 +1,143 @@
+import { randomUUID } from "node:crypto";
+import { readFile } from "node:fs/promises";
+
+import { parseDocument } from "yaml";
+
+import {
+  customDerpServers,
+  normalizeDerpSettings,
+  OFFICIAL_DERP_URL,
+  type DerpSettings,
+} from "~/utils/derp-config";
+
+import { readDerpRequest, readDerpStatus } from "../../../scripts/network-runtime";
+import type { AuthService } from "../web/auth";
+import { Capabilities } from "../web/roles";
+import { probeDerp } from "./derp-check";
+import { NetworkSettingsError } from "./error";
+import type { PrivateStore } from "./store";
+interface Dependencies {
+  store: PrivateStore;
+  auth: Pick<AuthService, "require" | "can">;
+  basePath?: string;
+  probe?: typeof probeDerp;
+}
+export function createDerpService({ store, auth, basePath, probe = probeDerp }: Dependencies) {
+  async function access(request: Request, write = false) {
+    const p = await auth.require(request);
+    if (!auth.can(p, write ? Capabilities.write_network : Capabilities.read_network))
+      throw new NetworkSettingsError("您无权" + (write ? "修改" : "查看") + " DERP 配置。", 403);
+  }
+  async function base(): Promise<{ settings: DerpSettings; externalSources: boolean }> {
+    if (!basePath)
+      return {
+        settings: {
+          officialEnabled: true,
+          customEnabled: false,
+          address: "",
+          stunEnabled: true,
+          stunPort: 3478,
+        } satisfies DerpSettings,
+        externalSources: false,
+      };
+    const doc = parseDocument(await readFile(basePath, "utf8"));
+    if (doc.errors.length) throw new NetworkSettingsError("基础配置无法解析。", 503);
+    const d = doc.toJS()?.derp ?? {};
+    const urls = Array.isArray(d.urls) ? d.urls : [];
+    return {
+      settings: {
+        officialEnabled: urls.includes(OFFICIAL_DERP_URL),
+        customEnabled: false,
+        address: "",
+        stunEnabled: true,
+        stunPort: 3478,
+      } satisfies DerpSettings,
+      externalSources:
+        urls.some((u: unknown) => u !== OFFICIAL_DERP_URL) ||
+        (Array.isArray(d.paths) && d.paths.length > 0) ||
+        d.server?.enabled === true,
+    };
+  }
+  async function snapshot() {
+    const requested = readDerpRequest(await store.read("derp-request.json"));
+    const status = readDerpStatus(await store.read("derp-status.json"));
+    const original = await base();
+    const phase =
+      requested && requested.revision === status?.failed?.revision
+        ? ("failed" as const)
+        : requested && requested.revision !== status?.active?.revision
+          ? ("pending" as const)
+          : ("active" as const);
+    return {
+      settings: requested?.settings ?? status?.active?.settings ?? original.settings,
+      token: requested?.revision ?? "initial",
+      phase,
+      supported: Boolean(status),
+      activeRevision: status?.active?.revision ?? null,
+      error: status?.failed?.revision === requested?.revision ? status?.failed?.error : null,
+      externalSources: !requested && original.externalSources,
+      updatedAt: status?.updatedAt ?? null,
+    };
+  }
+  return {
+    async view(request: Request) {
+      await access(request);
+      return store.serial(snapshot);
+    },
+    async save(request: Request, token: string, input: unknown, replaceExisting: boolean) {
+      await access(request, true);
+      let settings: DerpSettings;
+      try {
+        settings = normalizeDerpSettings(input);
+      } catch (e) {
+        throw new NetworkSettingsError(e instanceof Error ? e.message : "DERP 配置无效。");
+      }
+      return store.serial(async () => {
+        const current = await snapshot();
+        if (current.token !== token)
+          throw new NetworkSettingsError("DERP 设置已变化，请刷新后重试。", 409);
+        if (!current.supported)
+          throw new NetworkSettingsError(
+            "当前启动方式不支持自动应用 DERP，请使用本项目配套镜像和 Compose。",
+            409,
+          );
+        if (current.externalSources && !replaceExisting)
+          throw new NetworkSettingsError("现有自定义 DERP 来源将被替换，请先确认。");
+        await store.write("derp-request.json", { schema: 1, revision: randomUUID(), settings });
+        return snapshot();
+      });
+    },
+    async check(request: Request, input: unknown) {
+      await access(request, true);
+      try {
+        const settings = normalizeDerpSettings(input);
+        if (!settings.customEnabled) throw new Error("请先启用并填写自建 DERP 地址。");
+        const results = await Promise.all(
+          customDerpServers(settings).map(async (server) => {
+            try {
+              return { address: server.address, ...(await probe(server.address)) };
+            } catch (error) {
+              return {
+                address: server.address,
+                ok: false,
+                message: error instanceof Error ? error.message : "DERP 检测失败。",
+              };
+            }
+          }),
+        );
+        const passed = results.filter((result) => result.ok).length;
+        return {
+          ok: passed === results.length,
+          results,
+          message:
+            results.length === 1
+              ? results[0].message
+              : `已检测 ${results.length} 个自建 DERP，${passed} 个通过，${results.length - passed} 个未通过。`,
+        };
+      } catch (e) {
+        throw new NetworkSettingsError(e instanceof Error ? e.message : "DERP 检测失败。");
+      }
+    },
+  };
+}
+export type DerpService = ReturnType<typeof createDerpService>;
