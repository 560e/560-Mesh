+import { describe, expect, it } from "vitest";
+
+import { normalizeDerpSettings, makeDerpMap } from "~/utils/derp-config";
+const custom = (address: string) => ({
+  officialEnabled: false,
+  customEnabled: true,
+  address,
+  stunEnabled: true,
+  stunPort: 3478,
+});
+describe("DERP address settings", () => {
+  it.each(["derp.example.com", "https://derp.example.com", "https://derp.example.com/"])(
+    "accepts an address without a mandatory port: %s",
+    (address) => {
+      expect(normalizeDerpSettings(custom(address))).toEqual({
+        ...custom("https://derp.example.com"),
+        stunPort: 3478,
+      });
+    },
+  );
+  it("keeps custom HTTPS ports", () => {
+    const settings = normalizeDerpSettings(custom("https://derp.example.com:8443"));
+    const map = makeDerpMap(settings, [900, 901]);
+    expect(map.regions["902"].nodes[0]).toMatchObject({
+      hostname: "derp.example.com",
+      derpport: 8443,
+      stunport: 3478,
+    });
+  });
+  it("uses 443 and can disable STUN on reverse-proxied servers", () => {
+    const settings = normalizeDerpSettings({ ...custom("derp.example.com"), stunEnabled: false });
+    expect(makeDerpMap(settings).regions["900"].nodes[0]).toMatchObject({
+      derpport: 443,
+      stunport: -1,
+    });
+  });
+  it.each([
+    "http://derp.example.com",
+    "https://u:p@derp.example.com",
+    "https://derp.example.com/prefix",
+    "https://derp.example.com?x=1",
+    "",
+    "https://derp.example.com:99999",
+  ])("rejects an invalid address %s", (address) => {
+    expect(() => normalizeDerpSettings(custom(address))).toThrow();
+  });
+  it("refuses zero DERP sources and invalid optional ports", () => {
+    expect(() => normalizeDerpSettings({ ...custom(""), customEnabled: false })).toThrow();
+    expect(() => normalizeDerpSettings({ ...custom("derp.example.com"), stunPort: 0 })).toThrow();
+    expect(() =>
+      normalizeDerpSettings({ ...custom("derp.example.com"), stunPort: 65536 }),
+    ).toThrow();
+  });
+  it("supports official only without requiring a custom address", () => {
+    expect(
+      normalizeDerpSettings({
+        officialEnabled: true,
+        customEnabled: false,
+        address: "",
+        stunEnabled: true,
+      }),
+    ).toMatchObject({ officialEnabled: true, address: "", stunPort: 3478 });
+  });
+});
