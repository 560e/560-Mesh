index 0000000..f386024
--- /dev/null
+++ b/app/server/web/local-auth.ts
@@ -0,0 +1,106 @@
+import { and, eq, sql } from "drizzle-orm";
+import type { NodeSQLiteDatabase } from "drizzle-orm/node-sqlite";
+import { authSessions, localAdmins, users } from "../db/schema";
+import type { AuthService } from "./auth";
+import { dummyHash, hashPassword, normalizeUsername, verifyPassword } from "./local-password";
+
+export type LocalLoginResult = { ok: true; cookie: string; credentialVersion: number } |
+  { ok: false; reason: "invalid" | "throttled" | "not_configured" };
+
+export function createLocalAuthService({ auth, db, configured }: {
+  auth: AuthService; db: NodeSQLiteDatabase; configured: boolean;
+}) {
+  const attempts = new Map<string, { count: number; expires: number }>();
+  function throttle(address: string) {
+    const now = Date.now();
+    for (const [key, value] of attempts) if (value.expires <= now) attempts.delete(key);
+    let state = attempts.get(address);
+    if (!state) {
+      if (attempts.size >= 10000) return false;
+      state = { count: 0, expires: now + 60000 };
+      attempts.set(address, state);
+    }
+    state.count += 1;
+    return state.count <= 30;
+  }
+  async function get(username: string) {
+    return (await db.select().from(localAdmins).where(eq(localAdmins.username, username)).limit(1))[0];
+  }
+  async function create(username: string, password: string) {
+    username = normalizeUsername(username);
+    if (await get(username)) throw new Error("管理员账号已存在，请使用密码重置命令。");
+    const passwordHash = await hashPassword(password);
+    const userId = await auth.findOrCreateUser(`local:${username}`, { name: username }, { initialRole: "admin" });
+    await db.insert(localAdmins).values({ user_id: userId, username, password_hash: passwordHash });
+  }
+  async function reset(username: string, password: string) {
+    const account = await get(normalizeUsername(username));
+    if (!account) throw new Error("管理员账号不存在。");
+    const passwordHash = await hashPassword(password);
+    await db.update(localAdmins).set({ password_hash: passwordHash, enabled: true,
+      credential_version: sql`${localAdmins.credential_version} + 1`,
+      failed_attempts: 0, locked_until: null, last_failure_at: null,
+    }).where(eq(localAdmins.user_id, account.user_id));
+    await db.delete(authSessions).where(eq(authSessions.user_id, account.user_id));
+  }
+  async function disable(username: string) {
+    const account = await get(normalizeUsername(username));
+    if (!account) throw new Error("管理员账号不存在。");
+    await db.update(localAdmins).set({ enabled: false,
+      credential_version: sql`${localAdmins.credential_version} + 1`,
+    }).where(eq(localAdmins.user_id, account.user_id));
+    await db.delete(authSessions).where(eq(authSessions.user_id, account.user_id));
+  }
+  async function login(username: string, password: string, address: string): Promise<LocalLoginResult> {
+    if (!configured) return { ok: false, reason: "not_configured" };
+    if (!throttle(address)) return { ok: false, reason: "throttled" };
+    if (username.length > 64 || password.length > 128) return { ok: false, reason: "invalid" };
+    let normalized: string;
+    try { normalized = normalizeUsername(username); } catch { normalized = "invalid-account"; }
+    const account = await get(normalized);
+    const correct = await verifyPassword(password, account?.password_hash ?? dummyHash);
+    if (!account) return { ok: false, reason: "invalid" };
+    const current = await get(normalized);
+    if (!current?.enabled || current.password_hash !== account.password_hash ||
+        (current.locked_until && current.locked_until.getTime() > Date.now())) {
+      return { ok: false, reason: "invalid" };
+    }
+    if (!correct) {
+      const cutoff = Math.floor((Date.now() - 15 * 60000) / 1000);
+      const failures = sql`CASE WHEN COALESCE(${localAdmins.last_failure_at}, 0) < ${cutoff} THEN 1 ELSE ${localAdmins.failed_attempts} + 1 END`;
+      await db.update(localAdmins).set({
+        failed_attempts: failures, last_failure_at: new Date(),
+        locked_until: sql`CASE WHEN (${failures}) >= 5 THEN ${Math.floor((Date.now() + 15 * 60000) / 1000)} ELSE NULL END`,
+      }).where(eq(localAdmins.user_id, account.user_id));
+      return { ok: false, reason: "invalid" };
+    }
+    await db.update(localAdmins).set({ failed_attempts: 0, locked_until: null, last_failure_at: null })
+      .where(eq(localAdmins.user_id, account.user_id));
+    await db.update(users).set({ last_login_at: new Date() }).where(eq(users.id, account.user_id));
+    return { ok: true, cookie: await auth.createLocalSession(account.user_id, account.username, account.credential_version), credentialVersion: account.credential_version };
+  }
+  async function list() {
+    return db.select({ username: localAdmins.username, enabled: localAdmins.enabled,
+      lockedUntil: localAdmins.locked_until, role: users.role,
+    }).from(localAdmins).innerJoin(users, eq(localAdmins.user_id, users.id));
+  }
+  async function changePassword(username: string, current: string, next: string, address: string) {
+    const checked = await login(username, current, address);
+    if (!checked.ok) throw new Error("当前密码错误或尝试过于频繁。");
+    const passwordHash = await hashPassword(next);
+    username = normalizeUsername(username);
+    // Unlike the privileged recovery command, self-service must never re-enable
+    // an account or overwrite a newer password after its old password was checked.
+    db.transaction((tx) => {
+      const changed = tx.update(localAdmins).set({ password_hash: passwordHash,
+        credential_version: sql`${localAdmins.credential_version} + 1`,
+        failed_attempts: 0, locked_until: null, last_failure_at: null,
+      }).where(and(eq(localAdmins.username, username), eq(localAdmins.enabled, true),
+        eq(localAdmins.credential_version, checked.credentialVersion)))
+        .returning({ userId: localAdmins.user_id }).get();
+      if (!changed) throw new Error("账号状态已改变，请重新登录后重试。");
+      tx.delete(authSessions).where(eq(authSessions.user_id, changed.userId)).run();
+    });
+  }
+  return { create, reset, disable, login, list, changePassword, configured };
+}
diff --git a/app/server/web/local-password.ts b/app/server/web/local-password.ts
new file mode 100644
index 0000000..ed9775e
--- /dev/null
+++ b/app/server/web/local-password.ts
@@ -0,0 +1,30 @@
+import { randomBytes, scrypt, timingSafeEqual } from "node:crypto";
+
+const options = { N: 32768, r: 8, p: 1, maxmem: 64 * 1024 * 1024 };
+function derive(password: string, salt: Buffer): Promise<Buffer> {
+  return new Promise((done, reject) => scrypt(password, salt, 64, options, (error, key) => {
+    if (error) reject(error); else done(key);
+  }));
+}
+export function normalizeUsername(username: string): string {
+  const normalized = username.trim().toLowerCase();
+  if (!/^[a-z][a-z0-9_.-]{2,31}$/.test(normalized)) {
+    throw new Error("账号须为 3–32 位，以英文字母开头，可使用字母、数字、点、下划线和短横线。");
+  }
+  return normalized;
+}
+export async function hashPassword(password: string): Promise<string> {
+  if (password.length < 12 || password.length > 128 || Buffer.byteLength(password) > 512) {
+    throw new Error("密码长度须为 12–128 个字符，请使用独立的长密码。");
+  }
+  const salt = randomBytes(16);
+  const key = await derive(password, salt);
+  return `scrypt$32768$8$1$${salt.toString("hex")}$${key.toString("hex")}`;
+}
+export const dummyHash = `scrypt$32768$8$1$${"0".repeat(32)}$${"0".repeat(128)}`;
+export async function verifyPassword(password: string, hash: string): Promise<boolean> {
+  if (password.length > 128 || Buffer.byteLength(password) > 512) return false;
+  const match = /^scrypt\$32768\$8\$1\$([0-9a-f]{32})\$([0-9a-f]{128})$/.exec(hash);
+  if (!match) return false;
+  return timingSafeEqual(await derive(password, Buffer.from(match[1], "hex")), Buffer.from(match[2], "hex"));
+}
