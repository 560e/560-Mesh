+              <>
+                <input type="hidden" name="base_domain" value={settings.baseDomain} />
+                <p className="rounded-lg bg-blue-50 px-4 py-3 text-xs leading-relaxed text-blue-700 dark:bg-blue-950 dark:text-blue-300">
+                  MagicDNS 已关闭，base_domain 可以留空。已有的内部域名会保留，直到你主动修改。
+                </p>
+              </>
+            )}
+            <div className="border-t border-mist-100 pt-5 dark:border-mist-800">
+              <h3 className="mb-3 flex items-center gap-2 text-sm font-semibold">
+                <Network className="size-4 text-blue-500" />
+                DNS 服务器
+              </h3>
+              <label className="block text-xs text-mist-500" htmlFor="global-dns">
+                全局 DNS 服务器，每行一个 IP 或 HTTPS DoH 地址。留空时不下发全局 DNS。
+              </label>
+              <textarea
+                id="global-dns"
+                name="nameservers"
+                value={servers}
+                onChange={(e) => setServers(e.target.value)}
+                rows={4}
+                maxLength={32768}
+                placeholder={"1.1.1.1\n223.5.5.5"}
+                className="mt-3 w-full rounded-lg border border-mist-200 bg-white p-3 font-mono text-sm dark:border-mist-700 dark:bg-slate-950"
+              />
+            </div>
+            <div className="option-row">
+              <div>
+                <p className="text-sm font-medium">覆盖客户端本地 DNS</p>
+                <p className="mt-1 text-xs text-mist-500">
+                  客户端允许接收 DNS 设置时，优先使用上方的服务器。
+                </p>
+              </div>
+              <Switch
+                label="覆盖客户端本地 DNS"
+                checked={settings.overrideLocalDNS}
+                onCheckedChange={(overrideLocalDNS) =>
+                  setSettings((s) => ({ ...s, overrideLocalDNS }))
+                }
+              />
+            </div>
+            <p className="text-xs text-mist-500">
+              保存会短暂重启本项目的控制与管理进程；设备通常会自动重连。分离
+              DNS、自定义记录和搜索域保持现有配置。
+            </p>
+            <Button variant="heavy" type="submit">
+              <span className="inline-flex items-center gap-2">
+                <Save className="size-4" />
+                {pending ? "正在应用…" : "保存 DNS 设置"}
+              </span>
+            </Button>
+          </fieldset>
+        </fetcher.Form>
+        {!writable && (
+          <p role="status" className="mt-4 text-sm text-amber-600">
+            当前账号只有查看权限。
+          </p>
+        )}
+        {!view.supported && (
+          <p role="status" className="mt-4 text-sm text-amber-600">
+            未检测到配置管理进程，请使用新版镜像和配套 Compose。
+          </p>
+        )}
+        {response && "error" in response && (
+          <p role="alert" className="mt-4 text-sm text-red-600">
+            {response.error}
+          </p>
+        )}
+        {view.error && (
+          <p role="alert" className="mt-4 text-sm text-red-600">
+            {view.error}
+          </p>
+        )}
+      </section>
+      <Link to="/settings/dns/advanced" className="text-xs text-mist-500">
+        查看分离 DNS、自定义记录与搜索域 →
+      </Link>
+    </div>
+  );
+}
+export function ErrorBoundary({ error }: Route.ErrorBoundaryProps) {
+  return <PageError error={error} page="DNS 与域名" />;
+}
diff --git a/app/routes/settings/layout.tsx b/app/routes/settings/layout.tsx
new file mode 100644
index 0000000..e606b54
--- /dev/null
+++ b/app/routes/settings/layout.tsx
@@ -0,0 +1,68 @@
+import { Settings2 } from "lucide-react";
+import { NavLink, Outlet } from "react-router";
+
+import { settingsNavigation } from "~/layout/navigation";
+import { authContext, headscaleConfigContext } from "~/server/context";
+import { Capabilities } from "~/server/web/roles";
+
+import type { Route } from "./+types/layout";
+export async function loader({ request, context }: Route.LoaderArgs) {
+  const auth = context.get(authContext),
+    p = await auth.require(request),
+    config = context.get(headscaleConfigContext);
+  const access = {
+    ui: auth.can(p, Capabilities.ui_access),
+    machines: auth.can(p, Capabilities.read_machines),
+    users: auth.can(p, Capabilities.read_users),
+    dns: auth.can(p, Capabilities.read_network),
+    policy: auth.can(p, Capabilities.read_policy),
+    settings: auth.can(p, Capabilities.read_feature),
+  };
+  if (!access.ui) throw new Response("您无权查看系统设置。", { status: 403 });
+  return {
+    access,
+    configWritable: config.writable(),
+    oidc: config.hasOIDCConfig(),
+    localAccount: p.kind === "local",
+  };
+}
+export default function SettingsLayout({ loaderData }: Route.ComponentProps) {
+  const items = settingsNavigation(
+    loaderData.access,
+    loaderData.configWritable,
+    loaderData.oidc,
+    loaderData.localAccount,
+  );
+  return (
+    <div>
+      <div className="page-heading">
+        <div>
+          <p className="page-eyebrow">
+            <Settings2 className="size-3.5" />
+            工作空间配置
+          </p>
+          <h1 className="page-title">系统设置</h1>
+          <p className="page-description">集中管理 DNS、访问策略与网络连接。</p>
+        </div>
+      </div>
+      <div className="settings-layout">
+        <nav className="settings-sidebar" aria-label="系统设置分类">
+          {items.map((item) => (
+            <NavLink className="settings-link" to={item.to} key={item.to}>
+              <item.icon className="size-4 shrink-0" />
+              <span>
+                <span className="block font-medium">{item.label}</span>
+                <span className="mt-0.5 hidden text-[11px] text-mist-400 xl:block">
+                  {item.description}
+                </span>
+              </span>
+            </NavLink>
+          ))}
+        </nav>
+        <div className="min-w-0">
+          <Outlet />
+        </div>
+      </div>
+    </div>
+  );
+}
