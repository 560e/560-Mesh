+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+
+import { ConsoleMotion, MotionSurface } from "~/components/motion";
+import { consoleNavigation, settingsNavigation } from "~/layout/navigation";
+
+const access = { ui: true, machines: true, dns: true, users: true, policy: true, settings: true };
+
+describe("console navigation permissions", () => {
+  it("hides all workspace navigation when UI access is denied", () => {
+    expect(consoleNavigation({ ...access, ui: false }, true)).toEqual([]);
+  });
+  it("keeps the four primary destinations independent of writable base configuration", () => {
+    const paths = consoleNavigation(access, false).map((item) => item.to);
+    expect(paths).toContain("/machines");
+    expect(paths).toContain("/users");
+    expect(paths).not.toContain("/dns");
+    expect(paths).toContain("/settings");
+    expect(paths).toEqual(["/machines", "/enrollment", "/users", "/settings"]);
+    expect(paths).not.toContain("/settings/auth-keys");
+  });
+  it("keeps settings discoverable for policy-only and network-only roles", () => {
+    const denied = {
+      ui: true,
+      machines: false,
+      dns: false,
+      users: false,
+      policy: false,
+      settings: false,
+    };
+    expect(consoleNavigation(denied, false)).toEqual([]);
+    expect(consoleNavigation({ ...denied, policy: true }, false).map((item) => item.to)).toEqual([
+      "/settings",
+    ]);
+    expect(consoleNavigation({ ...denied, dns: true }, false).map((item) => item.to)).toEqual([
+      "/settings",
+    ]);
+  });
+  it("never exposes a navigation item after its existing capability is denied", () => {
+    const items = consoleNavigation({ ...access, machines: false, policy: false }, true);
+    expect(items.some((item) => item.key === "machines")).toBe(false);
+  });
+});
+
+describe("server-rendered motion surfaces", () => {
+  it("renders critical form content visibly before hydration", () => {
+    const html = renderToStaticMarkup(
+      createElement(
+        ConsoleMotion,
+        null,
+        createElement(
+          MotionSurface,
+          null,
+          createElement("label", null, "管理员账号"),
+          createElement("input", { name: "username" }),
+          createElement("button", { type: "submit" }, "登录管理台"),
+        ),
+      ),
+    );
+    expect(html).toContain("管理员账号");
+    expect(html).toContain('name="username"');
+    expect(html).toContain("登录管理台");
+    expect(html).not.toMatch(/opacity:\s*0(?:;|")|visibility:\s*hidden|display:\s*none/);
+  });
+});
+
+describe("settings navigation", () => {
+  it("allows DNS and ACL inspection without a writable base config", () => {
+    const paths = settingsNavigation(access, false, false, false).map((item) => item.to);
+    expect(paths).toContain("/settings/dns");
+    expect(paths).toContain("/settings/acls");
+    expect(paths).not.toContain("/settings/restrictions");
+    expect(paths).not.toContain("/settings/account");
+  });
+  it("supports local account security even for a role with no network settings", () => {
+    const denied = {
+      ui: true,
+      machines: true,
+      dns: false,
+      users: false,
+      policy: false,
+      settings: false,
+    };
+    expect(settingsNavigation(denied, false, false, true).map((item) => item.to)).toEqual([
+      "/settings/account",
+    ]);
+    expect(consoleNavigation(denied, false).some((item) => item.to === "/settings")).toBe(false);
+  });
+  it("never reveals children without UI access", () => {
+    expect(settingsNavigation({ ...access, ui: false }, true, true, true)).toEqual([]);
+  });
+});
