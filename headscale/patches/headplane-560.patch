+++ b/tests/unit/network/dns.test.ts
@@ -0,0 +1,50 @@
+import { describe, it, expect } from "vitest";
+
+import { normalizeDnsSettings } from "~/utils/dns-config";
+const off = { magicDNS: false, baseDomain: "", nameservers: [], overrideLocalDNS: false };
+describe("DNS settings", () => {
+  it("allows an omitted base domain when MagicDNS is off", () =>
+    expect(normalizeDnsSettings(off, "https://hs.example.com")).toEqual(off));
+  it("requires a valid independent domain when enabled", () => {
+    for (const baseDomain of [
+      "",
+      "hs.example.com",
+      "example.com",
+      "bad..name",
+      "https://tail.example.com",
+    ])
+      expect(() =>
+        normalizeDnsSettings({ ...off, magicDNS: true, baseDomain }, "https://hs.example.com"),
+      ).toThrow();
+    expect(
+      normalizeDnsSettings(
+        { ...off, magicDNS: true, baseDomain: "Tail.Example.Com" },
+        "https://hs.example.com",
+      ).baseDomain,
+    ).toBe("tail.example.com");
+  });
+  it("accepts IP resolvers and HTTPS DoH, deduplicating them", () => {
+    expect(
+      normalizeDnsSettings({
+        ...off,
+        nameservers: ["1.1.1.1", "::1", "https://dns.example.com/query", "1.1.1.1"],
+        overrideLocalDNS: true,
+      }).nameservers,
+    ).toEqual(["1.1.1.1", "::1", "https://dns.example.com/query"]);
+  });
+  it.each([
+    "999.1.1.1",
+    "1.1.1.1:53",
+    "http://dns.example.com",
+    "https://u:p@dns.example.com",
+    "bad name",
+  ])("rejects invalid resolvers: %s", (server) =>
+    expect(() => normalizeDnsSettings({ ...off, nameservers: [server] })).toThrow(),
+  );
+  it("rejects a forced empty resolver set and malformed values", () => {
+    expect(() => normalizeDnsSettings({ ...off, overrideLocalDNS: true })).toThrow();
+    expect(() => normalizeDnsSettings({ ...off, magicDNS: "false" })).toThrow();
+    expect(() => normalizeDnsSettings({ ...off, nameservers: "1.1.1.1" })).toThrow();
+    expect(() => normalizeDnsSettings(null)).toThrow();
+  });
+});
