@@ -0,0 +1,384 @@
+import { createCipheriv, createDecipheriv, createHash, randomBytes } from "node:crypto";
+import { constants } from "node:fs";
+import { lstat, mkdir, open, realpath } from "node:fs/promises";
+import type { FileHandle } from "node:fs/promises";
+import { join, parse, resolve } from "node:path";
+
+import { eq, ne } from "drizzle-orm";
+import type { NodeSQLiteDatabase } from "drizzle-orm/node-sqlite";
+
+import {
+  enrollmentCommands,
+  enrollmentKeys,
+  enrollmentOperations,
+  enrollmentVault,
+} from "~/server/db/schema";
+import type { StoredEnrollmentCommand, StoredEnrollmentOperation } from "~/types/Enrollment";
+import type { PreAuthKey } from "~/types/PreAuthKey";
+
+export interface EnrollmentStore {
+  rememberKey(key: PreAuthKey): Promise<void>;
+  revealKey(key: PreAuthKey): Promise<string | null>;
+  forgetKey(id: string): Promise<void>;
+  listCommands(): Promise<StoredEnrollmentCommand[]>;
+  getCommand(id: string): Promise<StoredEnrollmentCommand | null>;
+  saveCommand(record: StoredEnrollmentCommand): Promise<void>;
+  deleteCommand(id: string): Promise<void>;
+  getOperation(id: string): Promise<StoredEnrollmentOperation | null>;
+  saveOperation(record: StoredEnrollmentOperation): Promise<void>;
+}
+
+const MASTER_FILE = "enrollment-vault.key";
+const unavailable = () => new Error("密钥保险库不可用，请检查独立加密密钥文件或从备份恢复。");
+const digest = (value: Buffer | string) => createHash("sha256").update(value).digest("hex");
+
+function identity(key: PreAuthKey): { prefix: string; createdAt: string } | null {
+  if (!key.id || !key.key || !key.createdAt) return null;
+  const timestamp =
+    /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.]([0-9]{1,9}))?(?:Z|[+-][0-9]{2}:[0-9]{2})$/.exec(
+      key.createdAt,
+    );
+  const date = new Date(key.createdAt);
+  if (!timestamp || !Number.isFinite(date.getTime())) return null;
+  // JavaScript Date truncates nanoseconds. Preserve the original fraction so
+  // two Headscale creation times in the same millisecond stay distinct.
+  const fraction = (timestamp[1] ?? "").replace(/0+$/, "");
+  const createdAt = date.toISOString().slice(0, 19) + (fraction ? `.${fraction}` : "") + "Z";
+  // Headscale v0.28+: the URL-safe public prefix has exactly 12 characters.
+  // Splitting on "-" is incorrect: the prefix itself may contain hyphens.
+  const current = /^hskey-auth-([A-Za-z0-9_-]{12})-(?:[A-Za-z0-9_-]+|\*{3})$/.exec(key.key);
+  if (current) return { prefix: `hskey-auth-${current[1]}`, createdAt };
+  // Older Headscale exposes the complete legacy key. Hash it so identity
+  // metadata cannot accidentally persist its plaintext.
+  if (/^[A-Za-z0-9_-]{32,}$/.test(key.key) && !key.key.startsWith("hskey-auth-")) {
+    return { prefix: `legacy-sha256:${digest(key.key)}`, createdAt };
+  }
+  return null;
+}
+
+function associatedData(id: string, prefix: string, createdAt: string, masterKeyId: string) {
+  return Buffer.from(
+    JSON.stringify(["headplane-enrollment-v1", id, prefix, createdAt, masterKeyId]),
+  );
+}
+
+// Verify every component, including ancestors, before opening the actual
+// directory. Linux's descriptor path pins key access to this verified inode;
+// changing the configured directory cannot redirect a key read or creation.
+async function openDirectory(path: string): Promise<FileHandle> {
+  const root = parse(path).root;
+  let part = root;
+  for (const segment of path.slice(root.length).split("/").filter(Boolean)) {
+    part = join(part, segment);
+    try {
+      const info = await lstat(part);
+      if (info.isSymbolicLink() || !info.isDirectory()) throw unavailable();
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+      await mkdir(part, { mode: 0o700 });
+    }
+  }
+  if ((await realpath(path)) !== path) throw unavailable();
+  const handle = await open(
+    path,
+    constants.O_RDONLY | constants.O_DIRECTORY | constants.O_NOFOLLOW,
+  );
+  try {
+    const info = await handle.stat();
+    const actual = await lstat(path);
+    if (
+      !info.isDirectory() ||
+      info.ino !== actual.ino ||
+      info.dev !== actual.dev ||
+      (info.mode & 0o022) !== 0 ||
+      (process.getuid && info.uid !== process.getuid())
+    ) {
+      throw unavailable();
+    }
+    return handle;
+  } catch (error) {
+    await handle.close();
+    throw error;
+  }
+}
+
+async function masterKey(dataPath: string, create: boolean): Promise<Buffer> {
+  const dir = await openDirectory(dataPath);
+  try {
+    const pinnedPath = join("/proc/self/fd", String(dir.fd), MASTER_FILE);
+    if (create) {
+      // Exclusive creation is required; never truncate an existing file.
+      let fresh: FileHandle | undefined;
+      try {
+        fresh = await open(
+          pinnedPath,
+          constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW,
+          0o600,
+        );
+        await fresh.writeFile(randomBytes(32));
+        await fresh.sync();
+        await dir.sync();
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+      } finally {
+        await fresh?.close();
+      }
+    }
+    const file = await open(
+      pinnedPath,
+      constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK,
+    );
+    try {
+      const info = await file.stat();
+      if (
+        !info.isFile() ||
+        info.size !== 32 ||
+        (info.mode & 0o777) !== 0o600 ||
+        info.nlink !== 1 ||
+        (process.getuid && info.uid !== process.getuid())
+      )
+        throw unavailable();
+      const bytes = await file.readFile();
+      if (bytes.length !== 32 || (await realpath(dataPath)) !== dataPath) throw unavailable();
+      const actual = await lstat(dataPath);
+      const pinned = await dir.stat();
+      if (actual.ino !== pinned.ino || actual.dev !== pinned.dev) throw unavailable();
+      return bytes;
+    } finally {
+      await file.close();
+    }
+  } finally {
+    await dir.close();
+  }
+}
+
+/** Storage and crypto only. The caller must authorize access using fresh Headscale ownership. */
+export async function createEnrollmentStore(
+  db: NodeSQLiteDatabase,
+  dataPath: string,
+): Promise<EnrollmentStore> {
+  const path = resolve(dataPath);
+  let expectedMasterId: string | null = null;
+  try {
+    let [marker] = await db
+      .select()
+      .from(enrollmentVault)
+      .where(eq(enrollmentVault.id, "master"))
+      .limit(1);
+    const [existing] = await db
+      .select({ master_key_id: enrollmentKeys.master_key_id })
+      .from(enrollmentKeys)
+      .limit(1);
+    // Preserve even pre-marker ciphertext identity before inspecting the file,
+    // so cleanup during a key-file fault cannot erase initialization evidence.
+    if (!marker && existing) {
+      await db
+        .insert(enrollmentVault)
+        .values({ id: "master", master_key_id: existing.master_key_id })
+        .onConflictDoNothing({ target: enrollmentVault.id });
+      [marker] = await db
+        .select()
+        .from(enrollmentVault)
+        .where(eq(enrollmentVault.id, "master"))
+        .limit(1);
+    }
+    const bytes = await masterKey(path, !marker && !existing);
+    const id = digest(bytes);
+    bytes.fill(0);
+    if (marker && marker.master_key_id !== id) throw unavailable();
+    const mismatches = await db
+      .select({ id: enrollmentKeys.key_id })
+      .from(enrollmentKeys)
+      .where(ne(enrollmentKeys.master_key_id, id))
+      .limit(1);
+    if (mismatches.length !== 0) throw unavailable();
+    await db
+      .insert(enrollmentVault)
+      .values({ id: "master", master_key_id: id })
+      .onConflictDoNothing({ target: enrollmentVault.id });
+    [marker] = await db
+      .select()
+      .from(enrollmentVault)
+      .where(eq(enrollmentVault.id, "master"))
+      .limit(1);
+    if (marker?.master_key_id === id) expectedMasterId = id;
+  } catch {
+    // Metadata remains available if key material is missing, unsafe or corrupt.
+    // No secret values or underlying filesystem errors are logged.
+  }
+
+  async function currentMaster(): Promise<Buffer> {
+    if (!expectedMasterId) throw unavailable();
+    const [marker] = await db
+      .select()
+      .from(enrollmentVault)
+      .where(eq(enrollmentVault.id, "master"))
+      .limit(1);
+    if (marker?.master_key_id !== expectedMasterId) throw unavailable();
+    const bytes = await masterKey(path, false);
+    if (digest(bytes) !== expectedMasterId) {
+      bytes.fill(0);
+      throw unavailable();
+    }
+    // Detect a changed master identity even when another instance wrote a row.
+    const mismatch = await db
+      .select({ id: enrollmentKeys.key_id })
+      .from(enrollmentKeys)
+      .where(ne(enrollmentKeys.master_key_id, expectedMasterId))
+      .limit(1);
+    if (mismatch.length > 0) {
+      bytes.fill(0);
+      throw unavailable();
+    }
+    return bytes;
+  }
+
+  return {
+    async rememberKey(key) {
+      const binding = identity(key);
+      if (!binding || key.key.endsWith("-***")) throw new Error("无法保存不完整的预认证密钥。");
+      let master: Buffer | undefined;
+      try {
+        master = await currentMaster();
+        const nonce = randomBytes(12);
+        const cipher = createCipheriv("aes-256-gcm", master, nonce);
+        cipher.setAAD(associatedData(key.id, binding.prefix, binding.createdAt, expectedMasterId!));
+        const ciphertext = Buffer.concat([cipher.update(key.key, "utf8"), cipher.final()]);
+        const row = {
+          key_id: key.id,
+          key_prefix: binding.prefix,
+          key_created_at: binding.createdAt,
+          master_key_id: expectedMasterId!,
+          nonce: nonce.toString("hex"),
+          ciphertext: ciphertext.toString("hex"),
+          auth_tag: cipher.getAuthTag().toString("hex"),
+        };
+        await db
+          .insert(enrollmentKeys)
+          .values(row)
+          .onConflictDoUpdate({ target: enrollmentKeys.key_id, set: row });
+      } catch {
+        throw unavailable();
+      } finally {
+        master?.fill(0);
+      }
+    },
+    async revealKey(key) {
+      const binding = identity(key);
+      if (!binding) return null;
+      let master: Buffer | undefined;
+      try {
+        const [row] = await db
+          .select()
+          .from(enrollmentKeys)
+          .where(eq(enrollmentKeys.key_id, key.id))
+          .limit(1);
+        if (
+          !row ||
+          row.key_prefix !== binding.prefix ||
+          row.key_created_at !== binding.createdAt ||
+          row.master_key_id !== expectedMasterId
+        )
+          return null;
+        master = await currentMaster();
+        if (
+          !/^[a-f0-9]{24}$/.test(row.nonce) ||
+          !/^[a-f0-9]{32}$/.test(row.auth_tag) ||
+          !/^(?:[a-f0-9]{2})+$/.test(row.ciphertext)
+        )
+          return null;
+        const decipher = createDecipheriv("aes-256-gcm", master, Buffer.from(row.nonce, "hex"));
+        decipher.setAAD(
+          associatedData(row.key_id, row.key_prefix, row.key_created_at, row.master_key_id),
+        );
+        decipher.setAuthTag(Buffer.from(row.auth_tag, "hex"));
+        const plaintext = Buffer.concat([
+          decipher.update(Buffer.from(row.ciphertext, "hex")),
+          decipher.final(),
+        ]);
+        try {
+          const result = plaintext.toString("utf8");
+          const recovered = identity({ ...key, key: result });
+          return recovered?.prefix === binding.prefix ? result : null;
+        } finally {
+          plaintext.fill(0);
+        }
+      } catch {
+        return null;
+      } finally {
+        master?.fill(0);
+      }
+    },
+    async forgetKey(id) {
+      await db.delete(enrollmentKeys).where(eq(enrollmentKeys.key_id, id));
+    },
+    async listCommands() {
+      return db
+        .select()
+        .from(enrollmentCommands)
+        .orderBy(enrollmentCommands.createdAt, enrollmentCommands.id);
+    },
+    async getCommand(id) {
+      const [record] = await db
+        .select()
+        .from(enrollmentCommands)
+        .where(eq(enrollmentCommands.id, id))
+        .limit(1);
+      return record ?? null;
+    },
+    async saveCommand(record) {
+      // Explicit fields prevent accidental insertion of caller-only secret data.
+      const row = {
+        id: record.id,
+        name: record.name,
+        creatorId: record.creatorId,
+        userId: record.userId,
+        keyId: record.keyId,
+        serverUrl: record.serverUrl,
+        options: record.options,
+        createdAt: record.createdAt,
+        updatedAt: record.updatedAt,
+      };
+      await db
+        .insert(enrollmentCommands)
+        .values(row)
+        .onConflictDoUpdate({ target: enrollmentCommands.id, set: row });
+    },
+    async deleteCommand(id) {
+      await db.delete(enrollmentCommands).where(eq(enrollmentCommands.id, id));
+    },
+    async getOperation(id) {
+      const [record] = await db
+        .select()
+        .from(enrollmentOperations)
+        .where(eq(enrollmentOperations.id, id))
+        .limit(1);
+      return record ?? null;
+    },
+    async saveOperation(record) {
+      const row = {
+        id: record.id,
+        fingerprint: record.fingerprint,
+        keyId: record.keyId,
+        commandId: record.commandId,
+      };
+      await db
+        .insert(enrollmentOperations)
+        .values(row)
+        .onConflictDoNothing({ target: enrollmentOperations.id });
+      const [saved] = await db
+        .select()
+        .from(enrollmentOperations)
+        .where(eq(enrollmentOperations.id, row.id))
+        .limit(1);
+      if (
+        !saved ||
+        saved.fingerprint !== row.fingerprint ||
+        saved.keyId !== row.keyId ||
+        saved.commandId !== row.commandId
+      ) {
+        throw new Error("操作记录已存在且内容不一致。");
+      }
+    },
+  };
+}
