+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { afterEach, it, expect } from "vitest";
+import { parse } from "yaml";
+
+import { createPrivateStore } from "~/server/network/store";
+
+import { createRuntimeController } from "../../../scripts/network-runtime";
+const dirs: string[] = [];
+afterEach(async () => {
+  await Promise.all(dirs.splice(0).map((d) => rm(d, { recursive: true, force: true })));
+});
+const dns = { magicDNS: false, baseDomain: "", nameservers: [], overrideLocalDNS: false };
+const derp = {
+  officialEnabled: false,
+  customEnabled: true,
+  address: "https://derp.example.com",
+  stunEnabled: false,
+  stunPort: 3478,
+};
+async function setup() {
+  const root = await mkdtemp(join(tmpdir(), "dns-runtime-"));
+  dirs.push(root);
+  const base = join(root, "base.yaml");
+  await writeFile(
+    base,
+    "server_url: https://hs.example.com\ndns:\n  magic_dns: true\n  base_domain: tail.example.com\n  override_local_dns: true\n  nameservers:\n    global: [1.1.1.1]\n    split: {corp.example.com: [10.0.0.1]}\n  extra_records: [{name: host.example.com, type: A, value: 10.0.0.2}]\nderp:\n  server: {enabled: false}\n  urls: [https://controlplane.tailscale.com/derpmap/default]\n  paths: []\n",
+  );
+  const store = createPrivateStore(join(root, "settings"));
+  const runtime = createRuntimeController({
+    basePath: base,
+    runtimeDirectory: join(root, "runtime"),
+    store,
+    validate: async () => {},
+  });
+  return { base, store, runtime };
+}
+it("preserves existing DNS exactly on an upgrade without DNS overrides", async () => {
+  const x = await setup(),
+    c = await x.runtime.prepare();
+  expect(parse(await readFile(c.configPath, "utf8")).dns).toEqual(
+    parse(await readFile(x.base, "utf8")).dns,
+  );
+  await x.runtime.healthy(c);
+  expect(await x.store.read("dns-status.json")).toMatchObject({ active: { settings: null } });
+});
+it("applies DNS and DERP together while preserving split DNS and extra records", async () => {
+  const x = await setup();
+  await x.store.write("dns-request.json", { schema: 1, revision: "dns1", settings: dns });
+  await x.store.write("derp-request.json", { schema: 1, revision: "derp1", settings: derp });
+  const c = await x.runtime.prepare(),
+    config = parse(await readFile(c.configPath, "utf8"));
+  expect(c.pending).toBe(true);
+  expect(config.dns).toMatchObject({
+    magic_dns: false,
+    base_domain: "",
+    override_local_dns: false,
+    nameservers: { global: [], split: { "corp.example.com": ["10.0.0.1"] } },
+  });
+  expect(config.dns.extra_records).toHaveLength(1);
+  expect(config.derp.urls).toEqual([]);
+  expect(config.derp.paths).toHaveLength(1);
+  expect(await x.store.read("dns-status.json")).toBeNull();
+  await x.runtime.healthy(c);
+  expect(await x.store.read("dns-status.json")).toMatchObject({
+    active: { revision: "dns1", settings: dns },
+  });
+  expect(await readFile(x.base, "utf8")).toContain("magic_dns: true");
+  expect(c.requestedRevision).toBe(await x.runtime.revision());
+});
+it("rolls back only a failed pending DNS change, keeping healthy DERP and not retrying forever", async () => {
+  const x = await setup();
+  await x.store.write("derp-request.json", { schema: 1, revision: "derp1", settings: derp });
+  await x.runtime.healthy(await x.runtime.prepare());
+  await x.store.write("dns-request.json", { schema: 1, revision: "bad", settings: dns });
+  const c = await x.runtime.prepare();
+  await x.runtime.failed(c, "startup failed");
+  const fallback = await x.runtime.prepare();
+  expect(fallback.pending).toBe(false);
+  const config = parse(await readFile(fallback.configPath, "utf8"));
+  expect(config.dns.magic_dns).toBe(true);
+  expect(config.derp.paths).toHaveLength(1);
+  expect(await x.store.read("derp-status.json")).toMatchObject({
+    active: { revision: "derp1" },
+    failed: null,
+  });
+  expect(await x.store.read("dns-status.json")).toMatchObject({ failed: { revision: "bad" } });
+  await x.runtime.healthy(fallback);
+  expect(await x.store.read("dns-status.json")).toMatchObject({ failed: { revision: "bad" } });
+});
+it("rejects pending DNS during preflight without losing the last good selection", async () => {
+  const x = await setup();
+  await x.runtime.healthy(await x.runtime.prepare());
+  await x.store.write("dns-request.json", { schema: 1, revision: "bad", settings: dns });
+  expect(await x.runtime.rejectPending("invalid")).toBe(true);
+  expect((await x.runtime.prepare()).pending).toBe(false);
+  expect(await x.runtime.rejectPending("invalid")).toBe(false);
+});
