+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { it, expect } from "vitest";
+
+import { createSiteService } from "~/server/network/site";
+import { createPrivateStore } from "~/server/network/store";
+import { normalizeSiteTitle } from "~/utils/site-settings";
+
+import { readPublicSiteTitle } from "../../../scripts/network-runtime";
+it("validates a public name without accepting markup, control characters or excessive length", () => {
+  expect(normalizeSiteTitle("  连接中心 & Team  ")).toBe("连接中心 & Team");
+  for (const value of ["", "<script>x</script>", "one\ntwo", "a".repeat(65), 42])
+    expect(() => normalizeSiteTitle(value)).toThrow();
+});
+it("persists a title with permissions and stale-save protection", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "site-settings-"));
+  try {
+    const store = createPrivateStore(dir);
+    let allowed = true;
+    const auth: any = { require: async () => ({}), can: () => allowed };
+    const service = createSiteService({ store, auth }),
+      request = new Request("https://hs.example.com");
+    expect(await service.view(request)).toMatchObject({ title: "连接助手", token: "initial" });
+    const next = await service.save(request, "initial", "团队连接");
+    expect(next.title).toBe("团队连接");
+    expect((await createSiteService({ store, auth }).view(request)).title).toBe("团队连接");
+    await expect(service.save(request, "initial", "stale")).rejects.toMatchObject({ status: 409 });
+    allowed = false;
+    await expect(service.save(request, next.token, "denied")).rejects.toMatchObject({
+      status: 403,
+    });
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+it("serves the latest saved public title and safely falls back for absent or corrupt settings", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "site-public-"));
+  try {
+    const store = createPrivateStore(dir);
+    expect(await readPublicSiteTitle(dir)).toBe("连接助手");
+    await store.write("site-settings.json", { schema: 1, revision: "one", title: "公共名称" });
+    expect(await readPublicSiteTitle(dir)).toBe("公共名称");
+    await store.write("site-settings.json", {
+      schema: 1,
+      revision: "bad",
+      title: "<script>bad</script>",
+    });
+    expect(await readPublicSiteTitle(dir)).toBe("连接助手");
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
