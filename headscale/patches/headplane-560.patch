diff --git a/app/routes/enrollment/command-card.tsx b/app/routes/enrollment/command-card.tsx
new file mode 100644
index 0000000..0d628cb
--- /dev/null
+++ b/app/routes/enrollment/command-card.tsx
@@ -0,0 +1,102 @@
+import { Clock3, Pencil, TerminalSquare } from "lucide-react";
+import { motion } from "motion/react";
+import { useEffect, useRef, useState } from "react";
+import { useFetcher } from "react-router";
+
+import Button from "~/components/button";
+import CodeBlock from "~/components/code-block";
+import Dialog, { DialogPanel } from "~/components/dialog";
+import Title from "~/components/title";
+import type { EnrollmentCommandView } from "~/server/enrollment/service";
+
+export default function CommandCard({
+  command,
+  onEdit,
+}: {
+  command: EnrollmentCommandView;
+  onEdit: () => void;
+}) {
+  const fetcher = useFetcher();
+  const busy = useRef(false);
+  const [open, setOpen] = useState(false);
+  useEffect(() => {
+    if (fetcher.state === "idle") {
+      busy.current = false;
+      if (fetcher.data === "加入命令已删除") setOpen(false);
+    }
+  }, [fetcher.state, fetcher.data]);
+  return (
+    <motion.article
+      layout
+      initial={{ y: 6 }}
+      animate={{ y: 0 }}
+      className="surface flex min-w-0 flex-col gap-4 p-5 sm:p-6"
+    >
+      <div className="flex flex-wrap items-center gap-3">
+        <span className="surface-icon">
+          <TerminalSquare className="size-5" />
+        </span>
+        <h3 className="min-w-0 flex-1 text-base font-semibold break-words text-mist-900 dark:text-white">
+          {command.name}
+        </h3>
+        <span
+          className={
+            command.available ? "status-pill status-available" : "status-pill status-unavailable"
+          }
+        >
+          <span className="size-1.5 rounded-full bg-current" />
+          {command.available ? "可使用" : "不可用"}
+        </span>
+      </div>
+      <p className="text-xs leading-6 break-all text-mist-500">
+        服务器：{command.serverUrl} · 密钥 #{command.keyId}
+      </p>
+      <p className="flex items-center gap-1.5 text-[11px] text-mist-400">
+        <Clock3 className="size-3" />
+        更新于 {new Date(command.updatedAt).toLocaleString("zh-CN")}
+      </p>
+      {command.available && command.command ? (
+        <CodeBlock>{command.command}</CodeBlock>
+      ) : (
+        <p role="status" className="text-sm text-amber-700 dark:text-amber-400">
+          不可用：{command.unavailableReason ?? "请检查密钥状态。"}{" "}
+          名称和选项已保留；选择有效密钥后可重新保存。
+        </p>
+      )}
+      <div className="mt-auto flex flex-wrap gap-3 border-t border-mist-100 pt-4 dark:border-mist-800">
+        <Button onClick={onEdit}>
+          <Pencil className="size-3.5" />
+          编辑／重命名
+        </Button>
+        <Dialog
+          isOpen={open}
+          onOpenChange={(value) => {
+            if (!busy.current) setOpen(value);
+          }}
+        >
+          <Button onClick={() => setOpen(true)}>删除命令记录</Button>
+          <DialogPanel
+            variant="destructive"
+            isDisabled={fetcher.state !== "idle"}
+            onSubmit={(event) => {
+              event.preventDefault();
+              if (busy.current) return;
+              busy.current = true;
+              fetcher.submit(
+                { action_id: "delete_enrollment_command", command_id: command.id },
+                { method: "post" },
+              );
+            }}
+          >
+            <Title>删除「{command.name}」？</Title>
+            <p>仅删除此命令记录，关联的预认证密钥仍然有效。若需撤销密钥，请前往预认证密钥管理。</p>
+            {fetcher.state !== "idle" && <p role="status">正在删除…</p>}
+            {typeof fetcher.data === "string" && fetcher.data !== "加入命令已删除" && (
+              <p role="alert">{fetcher.data}</p>
+            )}
+          </DialogPanel>
+        </Dialog>
+      </div>
+    </motion.article>
+  );
+}
