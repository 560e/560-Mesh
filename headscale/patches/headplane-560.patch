new file mode 100644
index 0000000..baaa065
--- /dev/null
+++ b/tests/unit/device-groups.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from "vitest";
+
+import type { User } from "~/types";
+import { groupDevices, readDeviceView } from "~/utils/device-groups";
+import type { PopulatedNode } from "~/utils/node-info";
+const user = (id: string, name: string) => ({ id, name, displayName: name }) as User;
+const node = (id: string, owner?: User, tags: string[] = []) =>
+  ({ id, user: owner, tags, online: true, expired: false }) as PopulatedNode;
+describe("device grouping", () => {
+  it("uses immutable user IDs, keeping duplicate display names separate", () => {
+    const groups = groupDevices([
+      node("a", user("1", "相同")),
+      node("b", user("2", "相同")),
+      node("c", user("1", "相同")),
+    ]);
+    expect(groups.map((g) => [g.id, g.nodes.map((n) => n.id)])).toEqual([
+      ["user:1", ["a", "c"]],
+      ["user:2", ["b"]],
+    ]);
+  });
+  it("separates tagged devices from their historical creator and unknown owners", () => {
+    const groups = groupDevices([
+      node("a", user("1", "甲"), ["tag:server"]),
+      node("b"),
+      node("c", user("1", "甲")),
+    ]);
+    expect(groups.find((g) => g.id === "tags")?.nodes.map((n) => n.id)).toEqual(["a"]);
+    expect(groups.find((g) => g.id === "unowned")?.nodes.map((n) => n.id)).toEqual(["b"]);
+    expect(groups.find((g) => g.id === "user:1")?.nodes.map((n) => n.id)).toEqual(["c"]);
+  });
+  it("counts connected unexpired devices without mutating input or reordering within a group", () => {
+    const a = node("a", user("1", "甲"));
+    const b = { ...node("b", user("1", "甲")), expired: true };
+    const input = Object.freeze([b, a]);
+    const result = groupDevices(input);
+    expect(result[0].online).toBe(1);
+    expect(result[0].nodes.map((n) => n.id)).toEqual(["b", "a"]);
+    expect(groupDevices([])).toEqual([]);
+  });
+  it("accepts only supported view preferences", () => {
+    expect(readDeviceView("cards")).toBe("cards");
+    expect(readDeviceView("list")).toBe("list");
+    expect(readDeviceView(null)).toBe("list");
+    expect(readDeviceView("unexpected")).toBe("list");
+  });
+});
diff --git a/tests/unit/enrollment-defaults.test.ts b/tests/unit/enrollment-defaults.test.ts
new file mode 100644
index 0000000..f29ef83
--- /dev/null
+++ b/tests/unit/enrollment-defaults.test.ts
@@ -0,0 +1,102 @@
+import { describe, it, expect } from "vitest";
+
+import { DEFAULT_ENROLLMENT_OPTIONS } from "~/utils/enrollment-command";
+import {
+  readEnrollmentDefaults,
+  saveEnrollmentDefaults,
+  clearEnrollmentDefaults,
+} from "~/utils/enrollment-defaults";
+const value = {
+  schema: 1,
+  autoKey: true,
+  userId: "1",
+  tagOnly: false,
+  keyTags: "",
+  expiryDays: "999",
+  options: {
+    ...DEFAULT_ENROLLMENT_OPTIONS,
+    acceptDns: false,
+    forceReauth: true,
+    advertiseRoutes: ["192.168.55.0/24"],
+  },
+};
+function storage() {
+  const data = new Map<string, string>();
+  return {
+    data,
+    getItem: (key: string) => data.get(key) ?? null,
+    setItem: (key: string, v: string) => {
+      data.set(key, v);
+    },
+    removeItem: (key: string) => {
+      data.delete(key);
+    },
+  };
+}
+describe("remembered enrollment defaults", () => {
+  it("restores options and expiry across form instances for the same account", () => {
+    const s = storage();
+    expect(saveEnrollmentDefaults(s, "account-a", value)).toBe(true);
+    expect(readEnrollmentDefaults(s, "account-a")).toEqual(value);
+  });
+  it("isolates accounts and servers and supports restoring factory defaults", () => {
+    const s = storage();
+    saveEnrollmentDefaults(s, "server1-user1", value);
+    expect(readEnrollmentDefaults(s, "server1-user2")).toBeNull();
+    expect(readEnrollmentDefaults(s, "server2-user1")).toBeNull();
+    clearEnrollmentDefaults(s, "server1-user1");
+    expect(readEnrollmentDefaults(s, "server1-user1")).toBeNull();
+  });
+  it("never persists command names, hostname, key secrets, key selections or request tokens", () => {
+    const s = storage();
+    saveEnrollmentDefaults(s, "account-a", {
+      ...value,
+      name: "private name",
+      keyId: "secret-key-id",
+      key: "hskey-auth-SECRET",
+      nonce: "secret-nonce",
+      options: { ...value.options, hostname: "one-device" },
+    });
+    const stored = [...s.data.values()].join("");
+    for (const secret of [
+      "private name",
+      "secret-key-id",
+      "hskey-auth-SECRET",
+      "secret-nonce",
+      "one-device",
+    ])
+      expect(stored).not.toContain(secret);
+    expect(readEnrollmentDefaults(s, "account-a")?.options.hostname).toBe("");
+  });
+  it("fails closed on malformed or obsolete storage and ignores invalid writes", () => {
+    const s = storage();
+    saveEnrollmentDefaults(s, "a", value);
+    const key = [...s.data.keys()][0];
+    s.setItem(key, "not-json");
+    expect(readEnrollmentDefaults(s, "a")).toBeNull();
+    expect(saveEnrollmentDefaults(s, "a", { ...value, schema: 2 })).toBe(false);
+    expect(saveEnrollmentDefaults(s, "a", { ...value, expiryDays: "-1" })).toBe(false);
+    expect(
+      saveEnrollmentDefaults(s, "a", {
+        ...value,
+        options: { ...value.options, advertiseRoutes: ["bad"] },
+      }),
+    ).toBe(false);
+  });
+  it("does not break creation when browser storage is unavailable", () => {
+    const s = {
+      getItem() {
+        throw new Error("denied");
+      },
+      setItem() {
+        throw new Error("full");
+      },
+      removeItem() {
+        throw new Error("denied");
+      },
+    };
+    expect(readEnrollmentDefaults(s, "a")).toBeNull();
+    expect(saveEnrollmentDefaults(s, "a", value)).toBe(false);
+    expect(() => clearEnrollmentDefaults(s, "a")).not.toThrow();
+  });
+});
diff --git a/tests/unit/enrollment/command.test.ts b/tests/unit/enrollment/command.test.ts
