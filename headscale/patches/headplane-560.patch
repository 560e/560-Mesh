+import { randomUUID } from "node:crypto";
+import { readFile } from "node:fs/promises";
+
+import { parseDocument } from "yaml";
+
+import { normalizeDnsSettings, type DnsSettings } from "~/utils/dns-config";
+
+import { readDnsRequest, readDnsStatus } from "../../../scripts/network-runtime";
+import type { AuthService } from "../web/auth";
+import { Capabilities } from "../web/roles";
+import { NetworkSettingsError } from "./error";
+import type { PrivateStore } from "./store";
+export function createDnsService({
+  store,
+  auth,
+  basePath,
+}: {
+  store: PrivateStore;
+  auth: Pick<AuthService, "require" | "can">;
+  basePath?: string;
+}) {
+  async function access(request: Request, write = false) {
+    const p = await auth.require(request);
+    if (!auth.can(p, write ? Capabilities.write_network : Capabilities.read_network))
+      throw new NetworkSettingsError("您无权" + (write ? "修改" : "查看") + " DNS 配置。", 403);
+  }
+  async function base() {
+    if (!basePath) throw new NetworkSettingsError("没有可用的 Headscale 配置。", 503);
+    const doc = parseDocument(await readFile(basePath, "utf8"));
+    if (doc.errors.length) throw new NetworkSettingsError("基础 DNS 配置无法解析。", 503);
+    const config = doc.toJS(),
+      dns = config?.dns ?? {};
+    return {
+      publicUrl: String(config?.server_url ?? ""),
+      // Read existing Headscale settings without imposing new-form limits.
+      settings: {
+        magicDNS: dns.magic_dns === undefined || dns.magic_dns === true || dns.magic_dns === "true",
+        baseDomain: String(dns.base_domain ?? ""),
+        nameservers: Array.isArray(dns.nameservers?.global)
+          ? dns.nameservers.global.filter(
+              (value: unknown): value is string => typeof value === "string",
+            )
+          : [],
+        overrideLocalDNS:
+          dns.override_local_dns === undefined ||
+          dns.override_local_dns === true ||
+          dns.override_local_dns === "true",
+      } satisfies DnsSettings,
+    };
+  }
+  async function snapshot() {
+    const requested = readDnsRequest(await store.read("dns-request.json")),
+      status = readDnsStatus(await store.read("dns-status.json")),
+      original = await base();
+    const phase =
+      requested && requested.revision === status?.failed?.revision
+        ? ("failed" as const)
+        : requested && requested.revision !== status?.active?.revision
+          ? ("pending" as const)
+          : ("active" as const);
+    return {
+      settings: requested?.settings ?? status?.active?.settings ?? original.settings,
+      activeSettings: status?.active?.settings ?? original.settings,
+      token: requested?.revision ?? "initial",
+      phase,
+      supported: Boolean(status),
+      activeRevision: status?.active?.revision ?? null,
+      error: status?.failed?.revision === requested?.revision ? status?.failed?.error : null,
+      updatedAt: status?.updatedAt ?? null,
+    };
+  }
+  return {
+    async view(request: Request) {
+      await access(request);
+      return store.serial(snapshot);
+    },
+    async save(request: Request, token: string, input: unknown) {
+      await access(request, true);
+      const original = await base();
+      let settings;
+      try {
+        settings = normalizeDnsSettings(input, original.publicUrl);
+      } catch (error) {
+        throw new NetworkSettingsError(error instanceof Error ? error.message : "DNS 设置无效。");
+      }
+      return store.serial(async () => {
+        const current = await snapshot();
+        if (current.token !== token)
+          throw new NetworkSettingsError("DNS 设置已变化，请刷新后重试。", 409);
+        if (!current.supported)
+          throw new NetworkSettingsError(
+            "当前启动方式不支持自动应用 DNS，请使用新版配套镜像及 Compose。",
+            409,
+          );
+        await store.write("dns-request.json", { schema: 1, revision: randomUUID(), settings });
+        return snapshot();
+      });
+    },
+  };
+}
+export type DnsService = ReturnType<typeof createDnsService>;
