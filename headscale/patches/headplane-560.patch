+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { afterEach, it, expect } from "vitest";
+
+import { createDnsService } from "~/server/network/dns";
+import { createPrivateStore } from "~/server/network/store";
+import { Capabilities } from "~/server/web/roles";
+const dirs: string[] = [];
+afterEach(async () => {
+  await Promise.all(dirs.splice(0).map((d) => rm(d, { recursive: true, force: true })));
+});
+const off = { magicDNS: false, baseDomain: "", nameservers: [], overrideLocalDNS: false };
+async function setup(writable = true) {
+  const root = await mkdtemp(join(tmpdir(), "dns-service-"));
+  dirs.push(root);
+  const basePath = join(root, "base.yaml");
+  await writeFile(
+    basePath,
+    "server_url: https://hs.example.com\ndns:\n  magic_dns: true\n  base_domain: tail.example.com\n  override_local_dns: false\n  nameservers: {global: [1.1.1.1]}\n",
+  );
+  const store = createPrivateStore(join(root, "settings"));
+  const auth = {
+    require: async () => ({}),
+    can: (_: unknown, cap: number) => writable || cap === Capabilities.read_network,
+  } as any;
+  return {
+    store,
+    service: createDnsService({ store, auth, basePath }),
+    request: new Request("https://hs.example.com/adminis/settings/dns"),
+  };
+}
+it("retains base values until an authorized persisted revision is acknowledged", async () => {
+  const x = await setup(),
+    view = await x.service.view(x.request);
+  expect(view.settings.magicDNS).toBe(true);
+  expect(view.supported).toBe(false);
+  await expect(x.service.save(x.request, view.token, off)).rejects.toMatchObject({ status: 409 });
+  await x.store.write("dns-status.json", {
+    schema: 1,
+    active: { revision: "base", settings: null },
+    failed: null,
+    updatedAt: new Date().toISOString(),
+  });
+  const next = await x.service.save(x.request, view.token, off);
+  expect(next.phase).toBe("pending");
+  expect(next.settings).toEqual(off);
+  await expect(x.service.save(x.request, view.token, off)).rejects.toMatchObject({ status: 409 });
+});
+it("prevents readers from writing while retaining read access", async () => {
+  const x = await setup(false);
+  expect((await x.service.view(x.request)).settings.magicDNS).toBe(true);
+  await expect(x.service.save(x.request, "initial", off)).rejects.toMatchObject({ status: 403 });
+  expect(await x.store.read("dns-request.json")).toBeNull();
+});
+it("returns the failed attempt with a status and preserves current active DNS", async () => {
+  const x = await setup();
+  await x.store.write("dns-request.json", { schema: 1, revision: "bad", settings: off });
+  await x.store.write("dns-status.json", {
+    schema: 1,
+    active: {
+      revision: "good",
+      settings: { ...off, magicDNS: true, baseDomain: "tail.example.com" },
+    },
+    failed: { revision: "bad", error: "bad config" },
+    updatedAt: new Date().toISOString(),
+  });
+  expect(await x.service.view(x.request)).toMatchObject({
+    phase: "failed",
+    error: "bad config",
+    activeRevision: "good",
+    settings: off,
+  });
+});
+
+it("keeps existing valid Headscale resolver lists readable even when they exceed new-form limits", async () => {
+  const x = await setup();
+  const base = join(x.store.directory, "..", "base.yaml");
+  const resolvers = Array.from({ length: 17 }, (_, i) => "10.0.0." + (i + 1));
+  await writeFile(
+    base,
+    'server_url: https://hs.example.com\ndns:\n  magic_dns: false\n  base_domain: ""\n  override_local_dns: true\n  nameservers: {global: [' +
+      resolvers.join(",") +
+      "]}\n",
+  );
+  expect((await x.service.view(x.request)).settings.nameservers).toEqual(resolvers);
+});
