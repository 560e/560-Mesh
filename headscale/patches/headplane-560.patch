+import { afterEach, beforeEach, describe, expect, test, vi } from "vitest";
+
+import { formatTimeDelta } from "~/utils/time";
+
+describe("Chinese elapsed time", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date("2026-10-26T12:00:00Z"));
+  });
+
+  afterEach(() => vi.useRealTimers());
+
+  test.each([
+    [0, "0 分钟前"],
+    [59, "59 分钟前"],
+    [60, "1 小时前"],
+    [61, "1 小时 1 分钟前"],
+    [1440, "1 天前"],
+    [1500, "1 天 1 小时前"],
+    [43200, "1 个月前"],
+    [44640, "1 个月 1 天前"],
+  ])("formats %i elapsed minutes without English plural suffixes", (minutes, expected) => {
+    const earlier = new Date(Date.now() - minutes * 60_000);
+    expect(formatTimeDelta(earlier)).toBe(expected);
+  });
+});
