+/** The product image and its reverse proxy must agree on this build-time path. */
+export function getPlatformPrefix(value?: string): string {
+  if (value !== undefined && value !== "" && value !== "/adminis") {
+    throw new Error("The 560 platform management prefix must be /adminis");
+  }
+  return "/adminis";
+}
diff --git a/scripts/admin.ts b/scripts/admin.ts
new file mode 100644
index 0000000..a550dba
--- /dev/null
+++ b/scripts/admin.ts
@@ -0,0 +1,38 @@
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { parse } from "yaml";
+import { createDbClient } from "../app/server/db/client.server";
+import { createAuthService } from "../app/server/web/auth";
+import { createLocalAuthService } from "../app/server/web/local-auth";
+
+async function main() {
+  const [operation, username] = process.argv.slice(2);
+  if (!["create", "reset", "disable", "list"].includes(operation ?? "")) {
+    throw new Error("用法：admin.mjs create|reset|disable <账号>，或 list；密码从标准输入读取。");
+  }
+  const config = parse(await readFile(process.env.HEADPLANE_CONFIG_PATH ?? "/etc/headplane/config.yaml", "utf8"));
+  const db = await createDbClient(join(config.server.data_path, "hp_persist.db"));
+  const auth = createAuthService({ db, secret: config.server.cookie_secret,
+    cookie: { name: "_hp_auth", secure: true, maxAge: 86400 } });
+  const local = createLocalAuthService({ db, auth, configured: true });
+  try {
+    if (operation === "list") {
+      for (const account of await local.list()) console.log(`${account.username}\t${account.enabled ? "启用" : "停用"}\t${account.role}`);
+      return;
+    }
+    if (!username) throw new Error("请提供管理员账号。");
+    if (operation === "disable") await local.disable(username);
+    else {
+      let password = "";
+      for await (const chunk of process.stdin) {
+        password += chunk.toString();
+        if (Buffer.byteLength(password) > 1024) throw new Error("密码输入过长。");
+      }
+      password = password.replace(/\r?\n$/, "");
+      if (operation === "create") await local.create(username, password);
+      else await local.reset(username, password);
+    }
+    console.log(operation === "create" ? "管理员账号已创建。" : operation === "reset" ? "密码已重置，旧会话已吊销。" : "账号已停用，旧会话已吊销。");
+  } finally { db.$client.close(); }
+}
+main().catch((error) => { console.error(error instanceof Error ? error.message : "管理员操作失败。"); process.exitCode = 1; });
diff --git a/scripts/network-runtime.ts b/scripts/network-runtime.ts
new file mode 100644
index 0000000..0a41625
--- /dev/null
+++ b/scripts/network-runtime.ts
@@ -0,0 +1,319 @@
+import { execFile } from "node:child_process";
+import { readFile } from "node:fs/promises";
+import { dirname, isAbsolute, join, resolve } from "node:path";
+import { promisify } from "node:util";
+
+import { parseDocument, stringify } from "yaml";
+
+import { createPrivateStore, type PrivateStore } from "../app/server/network/store";
+import {
+  normalizeDerpSettings,
+  makeDerpMap,
+  OFFICIAL_DERP_URL,
+  type DerpSettings,
+} from "../app/utils/derp-config";
+import { normalizeDnsSettings, type DnsSettings } from "../app/utils/dns-config";
+import { DEFAULT_SITE_TITLE, readSiteSettings } from "../app/utils/site-settings";
+export interface DnsRequest {
+  schema: 1;
+  revision: string;
+  settings: DnsSettings;
+}
+export interface DnsStatus {
+  schema: 1;
+  active: { revision: string; settings: DnsSettings | null } | null;
+  failed: { revision: string; error: string } | null;
+  updatedAt: string;
+}
+export function readDnsRequest(value: unknown): DnsRequest | null {
+  if (value === null) return null;
+  const v = value as DnsRequest;
+  if (
+    !v ||
+    v.schema !== 1 ||
+    typeof v.revision !== "string" ||
+    !v.revision ||
+    v.revision.length > 128
+  )
+    throw new Error("DNS 请求文件损坏。");
+  return { schema: 1, revision: v.revision, settings: normalizeDnsSettings(v.settings) };
+}
+export function readDnsStatus(value: unknown): DnsStatus | null {
+  if (value === null) return null;
+  const v = value as DnsStatus;
+  if (
+    !v ||
+    v.schema !== 1 ||
+    typeof v.updatedAt !== "string" ||
+    !(v.active === null || (v.active && typeof v.active.revision === "string")) ||
+    !(
+      v.failed === null ||
+      (v.failed && typeof v.failed.revision === "string" && typeof v.failed.error === "string")
+    )
+  )
+    throw new Error("DNS 生效状态文件损坏。");
+  if (v.active?.settings) normalizeDnsSettings(v.active.settings);
+  return v;
+}
+export interface DerpRequest {
+  schema: 1;
+  revision: string;
+  settings: DerpSettings;
+}
+export interface DerpStatus {
+  schema: 1;
+  active: { revision: string; settings: DerpSettings | null } | null;
+  failed: { revision: string; error: string } | null;
+  updatedAt: string;
+}
+export function readDerpRequest(value: unknown): DerpRequest | null {
+  if (value === null) return null;
+  const v = value as DerpRequest;
+  if (v.schema !== 1 || typeof v.revision !== "string" || !v.revision || v.revision.length > 128)
+    throw new Error("DERP 请求文件损坏。");
+  return { schema: 1, revision: v.revision, settings: normalizeDerpSettings(v.settings) };
+}
+export function readDerpStatus(value: unknown): DerpStatus | null {
+  if (value === null) return null;
+  const v = value as DerpStatus;
+  if (
+    v.schema !== 1 ||
+    typeof v.updatedAt !== "string" ||
+    !(v.active === null || (v.active && typeof v.active.revision === "string")) ||
+    !(
+      v.failed === null ||
+      (v.failed && typeof v.failed.revision === "string" && typeof v.failed.error === "string")
+    )
+  )
+    throw new Error("DERP 生效状态文件损坏。");
+  return {
+    ...v,
+    active: v.active
+      ? {
+          ...v.active,
+          settings: v.active.settings ? normalizeDerpSettings(v.active.settings) : null,
+        }
+      : null,
+  };
+}
+interface Candidate {
+  revision: string;
+  settings: DerpSettings | null;
+  configPath: string;
+  pending: boolean;
+  requestedRevision: string;
+  dnsRevision: string;
+  dnsSettings: DnsSettings | null;
+  derpPending: boolean;
+  dnsPending: boolean;
+}
+interface Options {
+  basePath: string;
+  controlListenAddress?: string;
+  runtimeDirectory: string;
+  store: PrivateStore;
+  validate: (configPath: string) => Promise<void>;
+  officialRegionIds?: () => Promise<number[]>;
+}
+export function createRuntimeController({
+  basePath,
+  controlListenAddress,
+  runtimeDirectory,
+  store,
+  validate,
+  officialRegionIds = async () => [],
+}: Options) {
+  const output = createPrivateStore(runtimeDirectory);
+  async function status() {
+    return readDerpStatus(await store.read("derp-status.json"));
+  }
+  async function request() {
+    return readDerpRequest(await store.read("derp-request.json"));
+  }
+  async function dnsRequest() {
+    return readDnsRequest(await store.read("dns-request.json"));
+  }
+  async function dnsStatus() {
+    return readDnsStatus(await store.read("dns-status.json"));
+  }
+  async function revision() {
+    return JSON.stringify([
+      (await request())?.revision ?? "base",
+      (await dnsRequest())?.revision ?? "base",
+    ]);
+  }
+  function isPending(
+    next: { revision: string } | null,
+    current: { active: { revision: string } | null; failed: { revision: string } | null } | null,
+  ) {
+    return Boolean(
+      next &&
+      next.revision !== current?.active?.revision &&
+      next.revision !== current?.failed?.revision,
+    );
+  }
+  async function markFailed(kind: "dns" | "derp", revision: string, error: string) {
+    const current = kind === "dns" ? await dnsStatus() : await status();
+    await store.write(kind + "-status.json", {
+      schema: 1,
+      active: current?.active ?? null,
+      failed: { revision, error: error.slice(0, 1200) },
+      updatedAt: new Date().toISOString(),
+    });
+  }
+  async function failed(candidate: Candidate, error: string) {
+    if (candidate.derpPending) await markFailed("derp", candidate.revision, error);
+    if (candidate.dnsPending) await markFailed("dns", candidate.dnsRevision, error);
+  }
+  return {
+    revision,
+    async rejectPending(error: string) {
+      let rejected = false;
+      const d = await request(),
+        ds = await status(),
+        n = await dnsRequest(),
+        ns = await dnsStatus();
+      if (d && isPending(d, ds)) {
+        await markFailed("derp", d.revision, error);
+        rejected = true;
+      }
+      if (n && isPending(n, ns)) {
+        await markFailed("dns", n.revision, error);
+        rejected = true;
+      }
+      return rejected;
+    },
+    async prepare(): Promise<Candidate> {
+      const next = await request(),
+        current = await status();
+      const derpPending = isPending(next, current);
+      const choice = derpPending ? next : current?.active;
+      const settings = choice?.settings ?? null;
+      const dnsNext = await dnsRequest(),
+        dnsCurrent = await dnsStatus(),
+        dnsPending = isPending(dnsNext, dnsCurrent);
+      const dnsChoice = dnsPending ? dnsNext : dnsCurrent?.active;
+      const dnsSettings = dnsChoice?.settings ?? null;
+      const pending = derpPending || dnsPending;
+      const document = parseDocument(await readFile(basePath, "utf8"));
+      if (document.errors.length) throw new Error("基础 Headscale 配置无法解析。");
+      if (controlListenAddress) document.set("listen_addr", controlListenAddress);
+      // Headscale resolves these keys relative to the config file, not its working directory.
+      for (const key of [
+        "policy.path",
+        "dns.extra_records_path",
+        "noise.private_key_path",
+        "database.sqlite.path",
+        "derp.server.private_key_path",
+        "tls_cert_path",
+        "tls_key_path",
+        "tls_letsencrypt_cache_dir",
+      ]) {
+        const parts = key.split("."),
+          value = document.getIn(parts);
+        if (typeof value === "string" && value !== "" && !isAbsolute(value))
+          document.setIn(parts, resolve(dirname(resolve(basePath)), value));
+      }
+
+      if (settings) {
+        document.setIn(["derp", "server", "enabled"], false);
+        document.setIn(["derp", "urls"], settings.officialEnabled ? [OFFICIAL_DERP_URL] : []);
+        if (settings.customEnabled) {
+          const occupied = settings.officialEnabled ? await officialRegionIds() : [];
+          const map = makeDerpMap(settings, occupied);
+          // Go decodes regions as map[int]DERPRegion; quoted YAML object keys are strings.
+          await output.writeText(
+            "derp.yaml",
+            stringify({
+              regions: new Map(
+                Object.entries(map.regions).map(([id, region]) => [Number(id), region]),
+              ),
+            }),
+          );
+          document.setIn(["derp", "paths"], [join(runtimeDirectory, "derp.yaml")]);
+        } else document.setIn(["derp", "paths"], []);
+      }
+      if (dnsSettings) {
+        const value = normalizeDnsSettings(dnsSettings, String(document.get("server_url") ?? ""));
+        document.setIn(["dns", "magic_dns"], value.magicDNS);
+        document.setIn(["dns", "base_domain"], value.baseDomain);
+        document.setIn(["dns", "override_local_dns"], value.overrideLocalDNS);
+        document.setIn(["dns", "nameservers", "global"], value.nameservers);
+      }
+      const configPath = join(runtimeDirectory, "headscale.yaml");
+      await output.writeText("headscale.yaml", document.toString());
+      await validate(configPath);
+      return {
+        revision: choice?.revision ?? "base",
+        settings,
+        configPath,
+        pending,
+        requestedRevision: JSON.stringify([next?.revision ?? "base", dnsNext?.revision ?? "base"]),
+        dnsRevision: dnsChoice?.revision ?? "base",
+        dnsSettings,
+        derpPending,
+        dnsPending,
+      };
+    },
+    async healthy(candidate: Candidate) {
+      const current = await status();
+      await store.write("derp-status.json", {
+        schema: 1,
+        active: { revision: candidate.revision, settings: candidate.settings },
+        failed: candidate.derpPending ? null : (current?.failed ?? null),
+        updatedAt: new Date().toISOString(),
+      } satisfies DerpStatus);
+      const dnsCurrent = await dnsStatus();
+      await store.write("dns-status.json", {
+        schema: 1,
+        active: { revision: candidate.dnsRevision, settings: candidate.dnsSettings },
+        failed: candidate.dnsPending ? null : (dnsCurrent?.failed ?? null),
+        updatedAt: new Date().toISOString(),
+      } satisfies DnsStatus);
+    },
+    failed,
+  };
+}
+const execute = promisify(execFile);
+export function platformRuntimeController() {
+  return createRuntimeController({
+    basePath: process.env.PLATFORM_BASE_HEADSCALE_CONFIG ?? "/etc/headscale/config.yaml",
+    controlListenAddress: process.env.PLATFORM_CONTROL_GATEWAY === "1" ? "0.0.0.0:8081" : undefined,
+    runtimeDirectory: process.env.PLATFORM_RUNTIME_DIRECTORY ?? "/var/lib/headscale/runtime",
+    store: createPrivateStore(
+      process.env.PLATFORM_NETWORK_SETTINGS_DIR ?? "/var/lib/headplane/network-settings",
+    ),
+    async validate(path) {
+      try {
+        await execute(
+          "/usr/local/bin/headscale",
+          ["configtest", "--config", path, "--output", "json"],
+          { timeout: 20000, maxBuffer: 65536 },
+        );
+      } catch {
+        throw new Error("Headscale 配置预检失败，已保留上次可用配置。");
+      }
+    },
+    async officialRegionIds() {
+      const response = await fetch(OFFICIAL_DERP_URL, { signal: AbortSignal.timeout(10000) });
+      if (!response.ok) throw new Error("无法读取官方 DERP 地区列表，请检查服务器网络后重试。");
+      const body = (await response.json()) as { Regions?: Record<string, unknown> };
+      if (!body.Regions || typeof body.Regions !== "object")
+        throw new Error("官方 DERP 地图格式无效。");
+      return Object.keys(body.Regions).map(Number).filter(Number.isFinite);
+    },
+  });
+}
+
+export async function readPublicSiteTitle(
+  directory = process.env.PLATFORM_NETWORK_SETTINGS_DIR ?? "/var/lib/headplane/network-settings",
+): Promise<string> {
+  try {
+    return (
+      readSiteSettings(await createPrivateStore(directory).read("site-settings.json"))?.title ??
+      DEFAULT_SITE_TITLE
+    );
+  } catch {
+    return DEFAULT_SITE_TITLE;
+  }
+}
diff --git a/tests/unit/auth/local-auth.test.ts b/tests/unit/auth/local-auth.test.ts
new file mode 100644
index 0000000..af052f3
--- /dev/null
+++ b/tests/unit/auth/local-auth.test.ts
@@ -0,0 +1,107 @@
+import { eq } from "drizzle-orm";
+import { describe, expect, test, vi } from "vitest";
+import { localAdmins } from "~/server/db/schema";
+import { createLocalAuthService } from "~/server/web/local-auth";
+import { Capabilities } from "~/server/web/roles";
+import { createTestAuth } from "./create-auth";
+
+const password = "A-strong-test-password-560!";
+function setup() {
+  const { auth, db } = createTestAuth({ headscaleApiKey: "server-only-key" });
+  const local = createLocalAuthService({ auth, db, configured: true });
+  return { local, auth, db };
+}
+describe("local administrator authentication", () => {
+  test("stores a salted hash and produces an administrator session without exposing the server key", async () => {
+    const { local, auth, db } = setup();
+    await local.create("Admin560", password);
+    const [row] = await db.select().from(localAdmins);
+    expect(row.username).toBe("admin560");
+    expect(row.password_hash).not.toContain(password);
+    expect(row.password_hash).toMatch(/^scrypt\$/);
+    const result = await local.login("ADMIN560", password, "127.0.0.1");
+    expect(result.ok).toBe(true);
+    if (!result.ok) throw new Error("Login failed");
+    expect(result.cookie).toContain("Path=/adminis");
+    expect(result.cookie).toContain("HttpOnly");
+    const request = new Request("https://hs.example.com/adminis/", { headers: { cookie: result.cookie.split(";")[0] } });
+    const principal = await auth.require(request);
+    expect(principal.kind).toBe("local");
+    expect(auth.can(principal, Capabilities.write_machines)).toBe(true);
+    expect(auth.getHeadscaleApiKey(principal)).toBe("server-only-key");
+    expect(result.cookie).not.toContain("server-only-key");
+  });
+  test("unknown and incorrect credentials return the same generic result", async () => {
+    const { local } = setup();
+    await local.create("admin560", password);
+    expect(await local.login("admin560", "incorrect-password", "127.0.0.1"))
+      .toEqual(await local.login("missing-user", "incorrect-password", "127.0.0.1"));
+  });
+  test("locks an account after five failures and persists the lock across service recreation", async () => {
+    const { local, auth, db } = setup();
+    await local.create("admin560", password);
+    for (let i = 0; i < 5; i++) await local.login("admin560", "wrong-password", "127.0.0.1");
+    const restarted = createLocalAuthService({ auth, db, configured: true });
+    expect((await restarted.login("admin560", password, "127.0.0.1")).ok).toBe(false);
+    const [row] = await db.select().from(localAdmins);
+    expect(row.locked_until!.getTime()).toBeGreaterThan(Date.now());
+  });
+  test("password reset unlocks the account and revokes existing sessions", async () => {
+    const { local, auth } = setup();
+    await local.create("admin560", password);
+    const old = await local.login("admin560", password, "127.0.0.1");
+    if (!old.ok) throw new Error("Login failed");
+    await local.reset("admin560", "Changed-test-password-561!");
+    await expect(auth.require(new Request("https://hs.example.com/adminis/", {
+      headers: { cookie: old.cookie.split(";")[0] },
+    }))).rejects.toThrow();
+    expect((await local.login("admin560", password, "127.0.0.1")).ok).toBe(false);
+    expect((await local.login("admin560", "Changed-test-password-561!", "127.0.0.1")).ok).toBe(true);
+  });
+  test("disabled accounts cannot authenticate and their sessions are immediately revoked", async () => {
+    const { local, auth } = setup();
+    await local.create("admin560", password);
+    const result = await local.login("admin560", password, "127.0.0.1");
+    if (!result.ok) throw new Error("Login failed");
+    await local.disable("admin560");
+    expect((await local.login("admin560", password, "127.0.0.1")).ok).toBe(false);
+    await expect(auth.require(new Request("https://hs.example.com/adminis/", {
+      headers: { cookie: result.cookie.split(";")[0] },
+    }))).rejects.toThrow();
+  });
+  test("does not create duplicate accounts or accept weak/oversized credentials", async () => {
+    const { local } = setup();
+    await expect(local.create("ab", password)).rejects.toThrow();
+    await expect(local.create("admin560", "short")).rejects.toThrow();
+    await local.create("admin560", password);
+    await expect(local.create("Admin560", password)).rejects.toThrow();
+    expect((await local.login("admin560", "x".repeat(10000), "127.0.0.1")).ok).toBe(false);
+  });
+  test("account-level lock expires and a successful login clears failures", async () => {
+    const { local, db } = setup();
+    await local.create("admin560", password);
+    await db.update(localAdmins).set({ failed_attempts: 5, locked_until: new Date(Date.now() - 1000) })
+      .where(eq(localAdmins.username, "admin560"));
+    expect((await local.login("admin560", password, "127.0.0.1")).ok).toBe(true);
+    expect((await db.select().from(localAdmins))[0].failed_attempts).toBe(0);
+  });
+  test("source throttling also limits attempts for nonexistent accounts", async () => {
+    const { local } = setup();
+    let result;
+    for (let i = 0; i < 31; i++) result = await local.login("bad-name", "x", "127.0.0.1");
+    expect(result).toEqual({ ok: false, reason: "throttled" });
+  });
+  test("self-service password change cannot undo a concurrent administrator disable", async () => {
+    const { local, auth, db } = setup();
+    await local.create("admin560", password);
+    const createSession = auth.createLocalSession.bind(auth);
+    vi.spyOn(auth, "createLocalSession").mockImplementationOnce(async (...args) => {
+      const cookie = await createSession(...args);
+      await local.disable("admin560");
+      return cookie;
+    });
+    await expect(local.changePassword("admin560", password, "Changed-test-password-562!", "127.0.0.1"))
+      .rejects.toThrow();
+    expect((await db.select().from(localAdmins))[0].enabled).toBe(false);
+  });
+});
