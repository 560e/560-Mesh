new file mode 100644
index 0000000..b593286
--- /dev/null
+++ b/app/routes/settings/account.tsx
@@ -0,0 +1,42 @@
+import { data, Form, redirect } from "react-router";
+import Button from "~/components/button";
+import Card from "~/components/card";
+import Input from "~/components/input";
+import { authContext, localAuthContext } from "~/server/context";
+import type { Route } from "./+types/account";
+
+export async function loader({ request, context }: Route.LoaderArgs) {
+  const principal = await context.get(authContext).require(request);
+  if (principal.kind !== "local") return redirect("/machines");
+  return { username: principal.profile.username ?? principal.user.subject.slice("local:".length) };
+}
+export async function action({ request, context }: Route.ActionArgs) {
+  const auth = context.get(authContext);
+  const principal = await auth.require(request);
+  if (principal.kind !== "local") throw new Response("此功能仅适用于本地管理员账号。", { status: 403 });
+  const local = context.get(localAuthContext);
+  const form = await request.formData();
+  const current = String(form.get("current_password") ?? "");
+  const next = String(form.get("new_password") ?? "");
+  const confirm = String(form.get("confirm_password") ?? "");
+  if (next.length < 12 || next.length > 128 || next !== confirm || current === next) {
+    return data({ error: "新密码须为 12–128 个字符，两次输入须一致，且不能与旧密码相同。" }, { status: 400 });
+  }
+  const username = principal.profile.username ?? principal.user.subject.slice("local:".length);
+  try { await local.changePassword(username, current, next, auth.getRequestClientAddress(request)); }
+  catch { return data({ error: "当前密码错误、尝试过于频繁或账号状态已改变，请稍后重新登录。" }, { status: 400 }); }
+  return redirect("/login?s=password_changed", { headers: { "Set-Cookie": await auth.destroySession(request) } });
+}
+export default function Account({ loaderData, actionData }: Route.ComponentProps) {
+  return <Card className="mx-auto max-w-lg">
+    <Card.Title>账号安全</Card.Title>
+    <Card.Text>当前账号：{loaderData.username}。修改密码后，所有已登录会话将失效，请重新登录。</Card.Text>
+    <Form method="post" className="mt-6 flex flex-col gap-4">
+      <Input label="当前密码" name="current_password" type="password" autoComplete="current-password" required maxLength={128} />
+      <Input label="新密码" name="new_password" type="password" autoComplete="new-password" required minLength={12} maxLength={128} />
+      <Input label="确认新密码" name="confirm_password" type="password" autoComplete="new-password" required minLength={12} maxLength={128} />
+      {actionData?.error && <p role="alert" className="text-sm text-red-600">{actionData.error}</p>}
+      <Button type="submit" variant="heavy">修改密码并退出登录</Button>
+    </Form>
+  </Card>;
+}
