+                              onChange={(event) =>
+                                setSettings((previous) => ({
+                                  ...previous,
+                                  servers: previous.servers.map((entry, i) =>
+                                    i === index
+                                      ? { ...entry, stunPort: Number(event.target.value) }
+                                      : entry,
+                                  ),
